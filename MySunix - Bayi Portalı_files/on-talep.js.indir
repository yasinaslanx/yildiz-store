/**
 * Form - Ön Talep Kaydetme (siparis-yeni modunda)
 * Render YAPMAZ — mevcut düz/varyant/kılıf modallarını kullanır.
 * modal:onayla event'i tablo-render.js tarafından buraya yönlendirilir.
 * Kaydetme: ajax/form/on-siparis-hizli-kaydet.php
 */
(function() {
    'use strict';

    var F = window.Form;
    F.OnTalep = {};

    // --- Init ---
    F.OnTalep.init = function() {
        if (F.Config.mod !== 'siparis-yeni' && F.Config.mod !== 'on-siparis-duzenle') return;

        // Counter tıklama → özet göster
        var counter = document.getElementById('frmOtCounter');
        if (counter) {
            counter.addEventListener('click', function() {
                ozetGoster();
            });
        }
    };

    // Counter badge'i state'ten yeniden hesapla — düzenleme modunda yukle.js'ten sonra çağrılır
    F.OnTalep.counterGuncelle = function() {
        counterGuncelle();
    };

    /**
     * Kaydet — modal:onayla verisini ön talep olarak DB'ye yaz
     * tablo-render.js tarafından çağrılır (F.State.onTalepAktif = true iken)
     *
     * Yeni: kaydetmeden önce bu ürün/varyant için bayinin AKTİF bir ön talebi var mı
     * diye kontrol eder. Varsa "üzerine eklensin mi?" uyarısı gösterir; bayi onaylarsa
     * mevcut talebe konsolide eder (yeni ön talep / çift satır oluşmaz).
     */
    F.OnTalep.kaydet = function(data) {
        // Varyant verisini endpoint formatına dönüştür
        var varyantlar = [];
        var tip = data.tip || 'duz';

        if (tip === 'duz' || !data.varyantlar || data.varyantlar.length === 0) {
            varyantlar = [{ tip: 'duz', id: null, miktar: data.miktar || 1, not: '' }];
        } else {
            for (var i = 0; i < data.varyantlar.length; i++) {
                var v = data.varyantlar[i];
                varyantlar.push({
                    tip: v.tip || tip,
                    id: v.id || v.varyantId || null,
                    miktar: v.miktar || 0,
                    modelId: v.modelId || v.telefonModelId || null,
                    telefonModelId: v.telefonModelId || null,
                    modelAdi: v.modelAdi || v.model_adi || '',
                    renkAdi: v.renkAdi || v.renk_adi || '',
                    renkKodu: v.renkKodu || v.renk_kodu || '',
                    marka: v.marka || '',
                    renkId: v.renkId || null,
                    not: v.not || ''
                });
            }
        }

        // Düzenleme modunda (on-siparis-duzenle) birleştirme kontrolü yapma —
        // zaten mevcut talebi düzenliyoruz.
        if (F.Config.mod !== 'siparis-yeni') {
            gercekKaydet(data, tip, varyantlar, null);
            return;
        }

        // Bu ürün/varyant için bayinin aktif bir ön talebi var mı?
        $.ajax({
            url: F.Config.ajaxBase + 'on-siparis-mevcut-kontrol.php',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                urun_id: data.urunId,
                tip: tip,
                varyantlar: (tip === 'duz') ? [] : varyantlar
            }),
            dataType: 'json',
            success: function(kontrol) {
                if (kontrol && kontrol.eslesme_var) {
                    var esc = F.Helpers.escHtml;
                    Swal.fire({
                        icon: 'warning',
                        title: 'Zaten Talebiniz Var',
                        html: '<div style="text-align:left;font-size:14px">'
                            + '<b>' + esc(kontrol.hedef_on_siparis_no || '') + '</b> numaralı aktif ön talebinizde '
                            + '<b>' + esc(data.urunAdi || 'bu ürün') + '</b> için zaten '
                            + '<b>' + (kontrol.toplam_mevcut_miktar || 0) + ' adet</b> talebiniz bulunuyor.<br><br>'
                            + 'Mevcut talebin <b>üzerine eklensin</b> mi?</div>',
                        showCancelButton: true,
                        confirmButtonText: 'Üzerine Ekle',
                        cancelButtonText: 'Vazgeç',
                        confirmButtonColor: '#103595',
                        cancelButtonColor: '#6b7280'
                    }).then(function(r) {
                        if (r.isConfirmed) {
                            gercekKaydet(data, tip, varyantlar, kontrol.hedef_on_siparis_id);
                        }
                        // Vazgeç → hiçbir şey yapma (çift kayıt önlenir)
                    });
                } else {
                    gercekKaydet(data, tip, varyantlar, null);
                }
            },
            error: function() {
                // Kontrol başarısız olursa engelleme — normal akışla kaydet
                gercekKaydet(data, tip, varyantlar, null);
            }
        });
    };

    /**
     * Asıl kaydetme. hedefOnSiparisId verilirse mevcut talebe konsolide eder
     * (oturum ön talebi değişmez); yoksa normal oturum akışı.
     */
    function gercekKaydet(data, tip, varyantlar, hedefOnSiparisId) {
        var editData = F.State.onTalepEditData;
        var itemIds = (editData && editData.itemIds) ? editData.itemIds : [];

        var payload = {
            on_siparis_id: F.State.onTalepSessionId || null,
            hedef_on_siparis_id: hedefOnSiparisId || null,
            musteri_id: F.State.musteriId,
            musteri_tipi: F.State.musteriTipi || 'bayi',
            musteri_adi: F.State.musteriAdi || '',
            urun_id: data.urunId,
            urun_adi: data.urunAdi,
            urun_kodu: data.urunKodu || '',
            tip: tip,
            not: data.not || '',
            varyantlar: varyantlar,
            item_ids: itemIds
        };

        $.ajax({
            url: F.Config.ajaxBase + 'on-siparis-hizli-kaydet.php',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            dataType: 'json',
            success: function(res) {
                if (!res.success) {
                    Swal.fire('Hata', res.message || 'Kayıt sırasında bir hata oluştu', 'error');
                    return;
                }

                // Toplam miktar hesapla
                var toplam = 0;
                for (var j = 0; j < varyantlar.length; j++) {
                    toplam += (varyantlar[j].miktar || 0);
                }

                if (hedefOnSiparisId) {
                    // Birleştirme: ayrı/mevcut talebe yazıldı — oturum state'i değişmez
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'success',
                        title: 'Mevcut talebe eklendi',
                        text: data.urunAdi + ' — +' + toplam + ' adet',
                        showConfirmButton: false,
                        timer: 3000,
                        timerProgressBar: true
                    });
                    F.Modal.kapat();
                    return;
                }

                // Normal oturum akışı — session state güncelle
                F.State.onTalepSessionId = res.on_siparis_id;
                F.State.onTalepSessionNo = res.on_siparis_no;

                var entry = {
                    urunId: data.urunId,
                    urunAdi: data.urunAdi,
                    urunKodu: data.urunKodu || '',
                    tip: tip,
                    varyantlar: varyantlar,
                    toplamMiktar: toplam,
                    itemIds: res.item_ids || [],
                    not: data.not || ''
                };

                var idx = -1;
                for (var k = 0; k < F.State.onTalepUrunler.length; k++) {
                    if (F.State.onTalepUrunler[k].urunId === data.urunId) { idx = k; break; }
                }
                if (idx >= 0) {
                    F.State.onTalepUrunler[idx] = entry;
                } else {
                    F.State.onTalepUrunler.push(entry);
                }

                counterGuncelle();

                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: 'Ön talep kaydedildi',
                    text: data.urunAdi + ' — ' + toplam + ' adet',
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });

                F.Modal.kapat();
            },
            error: function() {
                Swal.fire('Hata', 'Sunucu bağlantı hatası', 'error');
            }
        });
    }

    // --- Counter Badge Güncelle ---
    function counterGuncelle() {
        var counter = document.getElementById('frmOtCounter');
        var countEl = document.getElementById('frmOtCount');
        if (!counter || !countEl) return;

        var adet = F.State.onTalepUrunler.length;
        if (adet > 0) {
            countEl.textContent = adet;
            counter.style.display = '';
        } else {
            counter.style.display = 'none';
        }
    }

    // --- Ön Talep Özet Popup ---
    function ozetGoster() {
        var urunler = F.State.onTalepUrunler;
        if (!urunler.length) return;

        var esc = F.Helpers.escHtml;
        var h = '<div style="text-align:left">';
        h += '<div style="margin-bottom:8px;font-size:13px;color:#6b7280">' + esc(F.State.onTalepSessionNo || '') + ' — ' + esc(F.State.musteriAdi || '') + '</div>';
        h += '<table style="width:100%;border-collapse:collapse;font-size:13px">';
        h += '<thead><tr style="border-bottom:2px solid #e5e7eb"><th style="text-align:left;padding:6px">Ürün</th><th style="text-align:right;padding:6px">Miktar</th></tr></thead>';
        h += '<tbody>';
        for (var i = 0; i < urunler.length; i++) {
            var u = urunler[i];
            h += '<tr style="border-bottom:1px solid #f3f4f6">';
            h += '<td style="padding:6px">' + esc(u.urunAdi) + '</td>';
            h += '<td style="text-align:right;padding:6px;font-weight:600">' + (u.toplamMiktar || 0).toLocaleString('tr-TR') + '</td>';
            h += '</tr>';
        }
        h += '</tbody></table></div>';

        Swal.fire({
            title: 'Ön Talepler',
            html: h,
            icon: 'info',
            confirmButtonText: 'Tamam',
            confirmButtonColor: '#f59e0b',
            width: 480
        });
    }

})();
