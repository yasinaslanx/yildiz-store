/**
 * Bayi Portal - Döviz Kuru Global Yöneticisi
 * Ana ERP js/header-widgets.js'in bayi uyarlamasıdır.
 *
 * Amaç: Ana ERP ile BİREBİR aynı window.DovizKurlari global'ini bayi tarafında da
 * kurmak. Form sayfası (js/form/doviz.js) TL müşteri seçildiğinde kuru önce bu
 * global'den (getRate('USD')), o yoksa ajax/doviz-kur.php'den çeker.
 *
 * Bayi header markup'ı ana ERP'den farklı (.bp-hw-fx) olduğu için DOM güncellemesi
 * bayi markup'ına uyarlanmıştır. Saat/tarih widget'ı bayi'de js/layout/header.js
 * tarafından yönetildiği için burada yer almaz.
 */

// Global döviz kuru yöneticisi (ana ERP ile birebir arayüz)
window.DovizKurlari = window.DovizKurlari || {
    data: {
        USD: { alis: 0, satis: 0, kod: 'USD', isim: 'Amerikan Doları', degisim: 0 },
        EUR: { alis: 0, satis: 0, kod: 'EUR', isim: 'Euro', degisim: 0 },
        CNY: { alis: 0, satis: 0, kod: 'CNY', isim: 'Çin Yuanı', degisim: 0 },
        'USD-CNY': { alis: 0, satis: 0, kod: 'USD-CNY', isim: 'Dolar / Yuan' },
        'TRY-CNY': { alis: 0, satis: 0, kod: 'TRY-CNY', isim: 'Türk Lirası / Yuan' }
    },
    lastUpdate: null,
    getRate: function (currency) {
        return (this.data[currency] && this.data[currency].satis) || 0;
    },
    convertToTRY: function (amount, currency) {
        if (currency === 'TRY') return amount;
        var rate = this.getRate(currency);
        return amount * rate;
    },
    formatMoney: function (amount, decimals) {
        decimals = (decimals === undefined) ? 2 : decimals;
        return new Intl.NumberFormat('tr-TR', {
            minimumFractionDigits: decimals,
            maximumFractionDigits: decimals
        }).format(amount);
    }
};

(function () {
    'use strict';

    // Döviz Widget Sınıfı (bayi .bp-hw-fx markup'ına uyarlanmış)
    function CurrencyWidget() {
        this.fxEl = document.querySelector('.bp-hw-fx[data-currency="USD"]');
        this.init();
    }

    CurrencyWidget.prototype.init = function () {
        // 1) Header server-side zaten USD kurunu basmıştır → global'i ANINDA ön-doldur
        //    (fetch dönene kadar form sayfası bekleme yapmadan kuru bulabilsin)
        this.domdanOnDoldur();

        // 2) Taze kuru çek
        this.fetchRates();

        // 3) Her 3 dakikada bir güncelle (backend cache ile senkron)
        setInterval(this.fetchRates.bind(this), 3 * 60 * 1000);
    };

    // Header'daki .bp-hw-fx-rate metninden başlangıç kurunu oku
    CurrencyWidget.prototype.domdanOnDoldur = function () {
        if (!this.fxEl) return;
        var rateEl = this.fxEl.querySelector('.bp-hw-fx-rate');
        if (!rateEl) return;
        // Format: number_format(satis,4,'.',',') → binlik virgülleri at, sonra parse et
        var raw = (rateEl.textContent || '').replace(/,/g, '').trim();
        var rate = parseFloat(raw) || 0;
        if (rate > 0 && window.DovizKurlari.getRate('USD') <= 0) {
            window.DovizKurlari.data.USD.satis = rate;
            window.DovizKurlari.data.USD.alis = rate;
        }
    };

    CurrencyWidget.prototype.fetchRates = function () {
        var self = this;
        fetch('ajax/doviz-kur.php', {
            method: 'GET',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
            .then(function (response) {
                if (!response.ok) throw new Error('API isteği başarısız');
                return response.json();
            })
            .then(function (result) {
                if (result && result.success && result.data) {
                    window.DovizKurlari.data = result.data;
                    window.DovizKurlari.lastUpdate = result.data.saat ||
                        new Date().toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
                    self.updateUI();
                }
            })
            .catch(function (error) {
                // Sessizce geç — header server-side değeri ve global ön-doldurma zaten geçerli
                console.warn('Döviz kuru güncellenemedi:', error.message);
            });
    };

    // Header'daki görünen USD/TL değerini tazele
    CurrencyWidget.prototype.updateUI = function () {
        if (!this.fxEl) return;
        var usd = window.DovizKurlari.data.USD;
        if (!usd || !usd.satis) return;

        var rateEl = this.fxEl.querySelector('.bp-hw-fx-rate');
        if (rateEl) rateEl.textContent = parseFloat(usd.satis).toFixed(4);

        // Tooltip alış/satış değerleri (varsa)
        var buyEl = this.fxEl.querySelector('.bp-hw-fx-tt-val.is-buy');
        if (buyEl && usd.alis) buyEl.textContent = parseFloat(usd.alis).toFixed(4);
        var sellEl = this.fxEl.querySelector('.bp-hw-fx-tt-val.is-sell');
        if (sellEl) sellEl.textContent = parseFloat(usd.satis).toFixed(4);
    };

    function init() {
        // .bp-hw-fx yoksa (sayfa header'sız ise) yine de global hazır kalsın
        new CurrencyWidget();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
})();
