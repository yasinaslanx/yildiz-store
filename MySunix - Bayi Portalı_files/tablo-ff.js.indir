/**
 * Form - FF (Farklı Fiyat) Alt Satır Sistemi
 * tablo-render.js'den ayrılmıştır
 */
(function() {
    'use strict';

    var F = window.Form;

    /**
     * FF (farklı fiyat) alt satırları HTML
     */
    F.Tablo.ffSatirlarHtml = function(s) {
        var html = '';
        var ffler = s.ffSatirlar;
        var fmt = F.Helpers.formatPara;
        var esc = F.Helpers.escHtml;
        var kural = s.fiyatKurali;
        var conv = (F.Doviz && F.Doviz.aktif) ? F.Doviz.conv : function(v) { return v; };
        var isOns = F.Config.isOnSiparis;
        var tlFf = (F.TlOnizleme && F.TlOnizleme.aktif()); // TL Önizleme (salt görsel)

        for (var i = 0; i < ffler.length; i++) {
            var ff = ffler[i];
            var sonMu = (i === ffler.length - 1);
            var trClass = 'frm-ff-satir' + (sonMu ? ' frm-ff-son' : '');
            var fc = ff.markaRenk || '#a0b0cc';

            html += '<tr class="' + trClass + '" data-satir-id="' + s.satirId + '" data-ff-index="' + i + '" style="--fc:' + fc + '">';
            html += '<td><div class="frm-prod">';
            if (ff.resimUrl) {
                html += '<img class="frm-img" src="' + esc(ff.resimUrl) + '" onerror="this.onerror=null;this.style.display=\'none\';this.nextElementSibling.style.display=\'flex\'">';
                html += '<div class="frm-img-ph" style="display:none"><i class="icon-image"></i></div>';
            } else {
                html += '<div class="frm-img-ph"><i class="icon-image"></i></div>';
            }
            html += '<div>' + F.Tablo.ffNameHtml(ff, esc) + F.Tablo.depoIcerikHtmlFf(ff, s.depoId) + '</div>';
            html += '</div></td>';

            // Miktar
            html += '<td class="c"><span class="frm-qty">' + F.Helpers.formatSayi(ff.miktar) + '</span></td>';

            if (!isOns) {
                // FF Fiyat
                if (F.State.readonly) {
                    var ffReadonlyFiyat = (ff.normalBirimFiyat != null) ? ff.normalBirimFiyat : ff.birimFiyat;
                    var ffRoDisplay = (ff.manuelTlFiyat != null && F.Doviz && F.Doviz.aktif)
                        ? ff.manuelTlFiyat : conv(ffReadonlyFiyat);
                    html += '<td class="c">' + fmt(ffRoDisplay) + '</td>';
                } else if (kural && parseFloat(kural.deger) !== 0 && ff.normalBirimFiyat && ff.normalBirimFiyat !== ff.birimFiyat) {
                    var badgeText = '';
                    var badgeClass = '';
                    if (kural.islem_tipi === 'zam') {
                        badgeClass = 'frm-tbl-fiyat-zam';
                        badgeText = kural.deger_tipi === 'yuzde' ? '+%' + kural.deger : '+' + fmt(conv(kural.fark_tutari));
                    } else {
                        badgeClass = 'frm-tbl-fiyat-ind';
                        badgeText = kural.deger_tipi === 'yuzde' ? '-%' + kural.deger : '-' + fmt(conv(kural.fark_tutari));
                    }
                    html += '<td class="c frm-tbl-fiyat-cell">';
                    html += '<div class="frm-tbl-fiyat-kural">';
                    html += '<span class="frm-tbl-fiyat-eski">' + fmt(conv(ff.normalBirimFiyat)) + '</span>';
                    html += '<span class="frm-tbl-fiyat-badge ' + badgeClass + '">' + badgeText + '</span>';
                    html += '</div>';
                    html += '<div class="frm-tbl-fiyat-yeni">' + fmt(conv(ff.birimFiyat)) + '</div>';
                    html += (tlFf ? F.TlOnizleme.altMetin(ff.birimFiyat) : '');
                    html += '</td>';
                } else {
                    var ffDisplayFiyat = (ff.manuelTlFiyat != null && F.Doviz && F.Doviz.aktif)
                        ? ff.manuelTlFiyat : conv(ff.birimFiyat);
                    html += '<td class="c">' + fmt(ffDisplayFiyat) + (tlFf ? F.TlOnizleme.altMetin(ff.birimFiyat) : '') + '</td>';
                }

                // Fiyat(KDV)
                var ffBirimKdvliStr;
                if (ff.manuelTlFiyat != null && F.Doviz && F.Doviz.aktif) {
                    ffBirimKdvliStr = (s.kdvOrani > 0)
                        ? fmt(F.Helpers.bankersRound(ff.manuelTlFiyat * (1 + s.kdvOrani / 100), 2))
                        : '-';
                } else {
                    var ffKdvFiyat = (F.State.readonly && ff.normalBirimFiyat != null) ? ff.normalBirimFiyat : ff.birimFiyat;
                    ffBirimKdvliStr = (s.kdvOrani > 0)
                        ? fmt(conv(F.Helpers.bankersRound(ffKdvFiyat * (1 + s.kdvOrani / 100), 2)))
                        : '-';
                }
                html += '<td class="c frm-fiyat-pri">' + ffBirimKdvliStr + '</td>';

                // FF toplam
                var ffDisplayToplam;
                if (ff.manuelTlFiyat != null && F.Doviz && F.Doviz.aktif) {
                    var ffMtlTutar = F.Helpers.bankersRound(ff.miktar * ff.manuelTlFiyat, 2);
                    var ffMtlKdv = F.Helpers.bankersRound(ffMtlTutar * s.kdvOrani / 100, 2);
                    ffDisplayToplam = F.Helpers.bankersRound(ffMtlTutar + ffMtlKdv, 2);
                } else {
                    if (F.State.readonly && ff.normalBirimFiyat != null && ff.normalBirimFiyat !== ff.birimFiyat) {
                        var ffRoTutar = F.Helpers.bankersRound(ff.miktar * ff.normalBirimFiyat, 2);
                        var ffRoKdv = F.Helpers.bankersRound(ffRoTutar * s.kdvOrani / 100, 2);
                        ffDisplayToplam = conv(F.Helpers.bankersRound(ffRoTutar + ffRoKdv, 2));
                    } else {
                        ffDisplayToplam = conv(ff.toplam);
                    }
                }
                html += '<td class="c"><span class="frm-total">' + fmt(ffDisplayToplam) + '</span>' + (tlFf ? F.TlOnizleme.altMetin(ffDisplayToplam) : '') + '</td>';
            }

            if (!F.State.readonly) {
                html += '<td class="c frm-del-cell"></td>';
            }
            html += '</tr>';
        }
        return html;
    };

    /**
     * FF satır isim alanı: tek varyant → text, çoklu → badge
     */
    F.Tablo.ffNameHtml = function(ff, esc) {
        var vars = ff.varyantlar;
        var tip = ff.tip;

        // Özet container (toggle kapalıyken görünür)
        var summaryHtml = '<div class="frm-ff-summary">';
        summaryHtml += '<span class="frm-name">' + esc(ff.urunAdi || ff.adi) + '</span>';
        summaryHtml += '</div>';

        // Detay container (toggle açıkken görünür)
        var detailHtml;

        if (!vars || vars.length === 0) {
            detailHtml = '<div class="frm-ff-detail"><div class="frm-ff-name">' + esc(ff.adi) + '</div></div>';
            return summaryHtml + detailHtml;
        }

        detailHtml = '<div class="frm-ff-detail"><div class="frm-ff-badges">';

        if (tip === 'model_renk' || tip === 'kilif') {
            var gruplar = F.TabloVaryant.mrGrupla(vars);
            for (var m = 0; m < gruplar.length; m++) {
                detailHtml += F.TabloVaryant.mrGrupBadge(gruplar[m]);
            }
        } else if (tip === 'renk') {
            for (var r = 0; r < vars.length; r++) {
                if ((vars[r].miktar || 0) <= 0) continue;
                detailHtml += F.TabloVaryant.renkBadge(vars[r]);
            }
        } else if (tip === 'model') {
            for (var j = 0; j < vars.length; j++) {
                if ((vars[j].miktar || 0) <= 0) continue;
                detailHtml += F.TabloVaryant.modelBadge(vars[j]);
            }
        } else {
            return summaryHtml + '<div class="frm-ff-detail"><div class="frm-ff-name">' + esc(ff.adi) + '</div></div>';
        }

        detailHtml += '</div></div>';
        return summaryHtml + detailHtml;
    };

    /**
     * FF satırlarını varyant verilerinden yeniden oluştur
     */
    F.Tablo.ffYenidenOlustur = function(s) {
        if (!s.varyantlar || s.varyantlar.length === 0) {
            s.ffSatirlar = [];
            return;
        }

        // İade ve ön sipariş modlarında FF yok
        if (F.Config.isOnSiparis || F.Config.isSevkiyat || F.Config.mod === 'iade' || F.Config.mod === 'iade-duzenle') {
            s.ffSatirlar = [];
            return;
        }

        var kdvOrani = s.kdvOrani || 0;

        // Fiyata göre grupla
        var fiyatGruplari = {};
        var fiyatKeys = [];
        for (var i = 0; i < s.varyantlar.length; i++) {
            var v = s.varyantlar[i];
            // 0 fiyat geçerli değerdir — sadece null/undefined durumunda satır fiyatına fallback
            var fiyat = (v.birimFiyat != null) ? v.birimFiyat : ((s.birimFiyat != null) ? s.birimFiyat : 0);
            var fKey = fiyat.toFixed(4);
            if (!fiyatGruplari[fKey]) {
                fiyatGruplari[fKey] = { birimFiyat: fiyat, miktar: 0, varyantlar: [] };
                fiyatKeys.push(fKey);
            }
            fiyatGruplari[fKey].miktar += (v.miktar || 0);
            fiyatGruplari[fKey].varyantlar.push(v);
        }

        // Tek fiyat grubuysa FF yok
        if (fiyatKeys.length <= 1) {
            s.ffSatirlar = [];
            s.birimFiyat = fiyatGruplari[fiyatKeys[0]].birimFiyat;
            return;
        }

        // Dominant grup: s.birimFiyat'a eşit olan veya en çok miktarlı
        var dominantKey = s.birimFiyat.toFixed(4);
        if (!fiyatGruplari[dominantKey]) {
            dominantKey = fiyatKeys[0];
            for (var fi = 1; fi < fiyatKeys.length; fi++) {
                if (fiyatGruplari[fiyatKeys[fi]].miktar > fiyatGruplari[dominantKey].miktar) {
                    dominantKey = fiyatKeys[fi];
                }
            }
        }
        s.birimFiyat = fiyatGruplari[dominantKey].birimFiyat;

        // FF satırları
        var ffSatirlar = [];
        for (var fki = 0; fki < fiyatKeys.length; fki++) {
            if (fiyatKeys[fki] === dominantKey) continue;
            var fg = fiyatGruplari[fiyatKeys[fki]];

            var names = [];
            for (var ni = 0; ni < fg.varyantlar.length; ni++) {
                names.push(fg.varyantlar[ni].adi || '');
            }

            var ffNormFiyat = (fg.varyantlar[0].normalBirimFiyat != null) ? fg.varyantlar[0].normalBirimFiyat : null;
            var ffTutar;
            if (s.fiyatKurali && ffNormFiyat != null) {
                var orijFfTutar = F.Helpers.bankersRound(fg.miktar * ffNormFiyat, 2);
                ffTutar = F.Hesaplama.kuralTutarHesapla(orijFfTutar, s.fiyatKurali, fg.miktar);
            } else {
                ffTutar = F.Helpers.bankersRound(fg.miktar * fg.birimFiyat, 2);
            }
            var ffKdv = F.Helpers.bankersRound(ffTutar * kdvOrani / 100, 2);

            ffSatirlar.push({
                adi: names.join(', '),
                urunAdi: s.urunAdi,
                resimUrl: s.resimUrl || '',
                varyantlar: fg.varyantlar,
                tip: s.tip || 'duz',
                miktar: fg.miktar,
                birimFiyat: fg.birimFiyat,
                normalBirimFiyat: ffNormFiyat || fg.birimFiyat,
                tutar: ffTutar,
                kdv: ffKdv,
                toplam: ffTutar + ffKdv,
                markaRenk: fg.varyantlar[0].markaRenk || '#a0b0cc'
            });
        }

        s.ffSatirlar = ffSatirlar;
        s.ffGruplar = fiyatGruplari;
    };

})();
