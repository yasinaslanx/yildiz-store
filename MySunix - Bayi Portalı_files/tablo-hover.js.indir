/**
 * Form - Grup Hover Efektleri (FF grupları)
 * Referans: yeni-siparis4.php — sürekli gradient hover
 */
(function() {
    'use strict';

    var F = window.Form;

    F.TabloHover = {};

    var hoverBg = 'linear-gradient(180deg,#fffff6,#fefef0 45%,#fefce6)';

    function applyHover(tbody, satirId) {
        var rows = tbody.querySelectorAll('tr[data-satir-id="' + satirId + '"]');
        if (!rows.length) return;

        // Tek satır (FF yok) → CSS :hover halleder
        if (rows.length === 1 && !rows[0].classList.contains('frm-has-ff')) return;

        var rsCell = rows[0].querySelector('td[rowspan]');

        // Toplam yükseklik hesapla
        var totalH = 0;
        for (var k = 0; k < rows.length; k++) totalH += rows[k].offsetHeight;

        // Her satıra sürekli gradient parçası uygula
        var offset = 0;
        for (var k = 0; k < rows.length; k++) {
            rows[k].classList.add('frm-group-hover');
            rows[k].style.setProperty('background', hoverBg, 'important');
            rows[k].style.setProperty('background-size', '100% ' + totalH + 'px', 'important');
            rows[k].style.setProperty('background-position', '0 -' + offset + 'px', 'important');
            offset += rows[k].offsetHeight;
        }

        // Rowspan hücresine aynı gradient (cell yüksekliği = totalH, doğal eşleşir)
        if (rsCell) rsCell.style.setProperty('background', hoverBg, 'important');
    }

    function removeHover(tbody, satirId) {
        var rows = tbody.querySelectorAll('tr[data-satir-id="' + satirId + '"]');
        for (var k = 0; k < rows.length; k++) {
            rows[k].classList.remove('frm-group-hover');
            rows[k].style.removeProperty('background');
            rows[k].style.removeProperty('background-size');
            rows[k].style.removeProperty('background-position');
        }
        if (rows[0]) {
            var rsCell = rows[0].querySelector('td[rowspan]');
            if (rsCell) rsCell.style.removeProperty('background');
        }
    }

    F.TabloHover.init = function() {
        var tbody = document.getElementById('frmTbody');
        if (!tbody) return;

        var activeId = null;

        // mouseover → delege ile grup takibi
        tbody.addEventListener('mouseover', function(e) {
            var tr = e.target.closest('tr[data-satir-id]');
            var newId = tr ? tr.getAttribute('data-satir-id') : null;

            if (newId === activeId) return;

            if (activeId) removeHover(tbody, activeId);
            activeId = newId;
            if (activeId) applyHover(tbody, activeId);
        });

        // mouseleave → tbody'den çıkınca temizle
        tbody.addEventListener('mouseleave', function() {
            if (activeId) {
                removeHover(tbody, activeId);
                activeId = null;
            }
        });
    };

})();
