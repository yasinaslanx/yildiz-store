/**
 * Form - Ürün Arama (Detay Panelli Dropdown)
 * Referans: urun-arama-test.js
 * Sol panel: ürün listesi (resim + badge) | Sağ panel: detaylı bilgi
 */
(function() {
    'use strict';

    var F = window.Form;
    F.UrunArama = {};

    var input, dropdown, overlay, searchWrap, hint;
    var debounceTimer = null, focusIdx = -1, sonuclar = [];

    F.UrunArama.init = function() {
        input = document.getElementById('frmUrunArama');
        dropdown = document.getElementById('frmSdDropdown');
        overlay = document.getElementById('frmSdOverlay');
        searchWrap = document.querySelector('.frm-search');
        hint = document.getElementById('frmSdHint');

        if (!input || !dropdown) return;
        if (F.State.readonly) return;

        // Input event
        input.addEventListener('input', function() {
            var val = this.value.trim();
            clearTimeout(debounceTimer);
            focusIdx = -1;
            if (val.length < 2) { kapat(); return; }
            yukleniyorGoster();
            debounceTimer = setTimeout(function() { ara(val); }, 300);
        });

        // Klavye
        input.addEventListener('keydown', function(e) {
            if (!dropdown.classList.contains('active')) return;
            var items = dropdown.querySelectorAll('.frm-sd-item');
            if (!items.length) return;

            if (e.key === 'ArrowDown') {
                e.preventDefault();
                focusIdx = Math.min(focusIdx + 1, items.length - 1);
                focusGuncelle(items);
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                focusIdx = Math.max(focusIdx - 1, 0);
                focusGuncelle(items);
            } else if (e.key === 'Enter') {
                e.preventDefault();
                if (focusIdx >= 0) sec(focusIdx);
            } else if (e.key === 'Escape') {
                kapat();
                input.blur();
            }
        });

        // Overlay tıklama
        if (overlay) {
            overlay.addEventListener('click', function() { kapat(); input.blur(); });
        }

        // Dışarı tıklama
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.frm-search') && !e.target.closest('.frm-sd-overlay')) kapat();
        });
    };

    // --- Dropdown aç / kapat ---
    var frmBox, frmLWrap, frmL;

    function ac() {
        dropdown.classList.add('active');
        if (overlay) overlay.classList.add('active');
        if (searchWrap) searchWrap.classList.add('frm-sd-elevated');

        // Parent overflow kısıtlamalarını kaldır (dropdown taşabilsin)
        if (!frmBox) frmBox = searchWrap.closest('.frm-box');
        if (!frmLWrap) frmLWrap = searchWrap.closest('.frm-l-wrap');
        if (!frmL) frmL = searchWrap.closest('.frm-l');
        if (frmBox) frmBox.style.overflow = 'visible';
        if (frmLWrap) frmLWrap.style.overflow = 'visible';
        if (frmL) frmL.style.overflow = 'visible';
    }
    function kapat() {
        dropdown.classList.remove('active');
        if (overlay) overlay.classList.remove('active');
        if (searchWrap) searchWrap.classList.remove('frm-sd-elevated');
        focusIdx = -1;

        // Parent overflow geri yükle
        if (frmBox) frmBox.style.overflow = '';
        if (frmLWrap) frmLWrap.style.overflow = '';
        if (frmL) frmL.style.overflow = '';
    }

    // --- AJAX ---
    function ara(q) {
        // Tedarik alışında YALNIZCA bayi kendi ürünleri listelensin (sunix ürünleri gizli).
        var params = { q: q, mod: F.Config.mod || '' };
        if (F.Config.isTedarikAlis) params.sadece_bayi = 1;
        F.Helpers.ajaxPost('urun-ara.php', params, function(res) {
            if (res.success && res.data && res.data.length > 0) {
                sonuclar = res.data;
                if (F.Config.stokMiktarGizle) {
                    sonuclar = sonuclar.filter(function(u) {
                        if (u.on_siparis_urun) return true;
                        var kod = u.stok_aralik ? (u.stok_aralik.kod !== undefined ? u.stok_aralik.kod : 0) : (u.varsayilan_depo_stok || 0);
                        return kod > 0;
                    });
                }
                if (sonuclar.length === 0) {
                    dropdown.innerHTML = '<div class="frm-sd-empty"><i class="icon-search"></i>Sonuç bulunamadı</div>';
                    ac();
                    return;
                }
                renderSonuclar(sonuclar, q);
            } else {
                sonuclar = [];
                dropdown.innerHTML = '<div class="frm-sd-empty"><i class="icon-search"></i>Sonuç bulunamadı</div>';
                ac();
            }
        }, function() {
            sonuclar = [];
            dropdown.innerHTML = '<div class="frm-sd-empty">Bağlantı hatası</div>';
            ac();
        });
    }

    // --- Render ---
    function renderSonuclar(data, query) {
        var h = '<div class="frm-sd-panel">';

        // Sol liste
        h += '<div class="frm-sd-list">';
        h += '<div class="frm-sd-list-hd"><span>' + data.length + ' sonuç</span></div>';
        for (var i = 0; i < data.length; i++) {
            var u = data[i];
            var anaDepoStok = u.varsayilan_depo_stok || 0;
            var stokCls = anaDepoStok <= 0 ? 'frm-sd-badge-danger' : (anaDepoStok < 50 ? 'frm-sd-badge-warn' : 'frm-sd-badge-ok');
            h += '<div class="frm-sd-item" data-index="' + i + '">';
            h += '  <div class="frm-sd-item-img">' + imgTag(u) + '</div>';
            h += '  <div class="frm-sd-item-body">';
            h += '    <div class="frm-sd-item-name">' + vurgula(esc(u.urun_adi), query) + (u.urun_kaynak === 'bayi' ? ' <span class="frm-sd-badge-bayi" style="display:inline-block;background:#103595;color:#fff;font-size:10px;padding:1px 6px;border-radius:5px;vertical-align:middle"><i class="icon-tag"></i> Kendi Ürünüm</span>' : '') + '</div>';
            if (u.on_siparis_urun) {
            // Ön talep ürünü — amber badge
            h += '    <div class="frm-sd-badges">';
            h += '      <span class="frm-sd-badge frm-sd-badge-ontalep"><i class="icon-zap"></i> Ön Talep</span>';
            if (u.urun_kodu) h += '<span class="frm-sd-badge frm-sd-badge-kod">' + esc(u.urun_kodu) + '</span>';
            var mevcutOt = F.State.onTalepUrunBul ? F.State.onTalepUrunBul(u.id) : null;
            if (mevcutOt) h += '<span class="frm-sd-badge frm-sd-badge-ontalep-done"><i class="icon-check"></i> Eklendi</span>';
            h += '    </div>';
            } else if (!F.Config.isOnSiparis && !F.Config.isSevkiyat) {
            h += '    <div class="frm-sd-badges">';
            h += '      <span class="frm-sd-badge ' + stokCls + '">Ana Depo: <b>' + fNum(anaDepoStok) + '</b></span>';
            if (u.yoldaki_toplam > 0) h += '<span class="frm-sd-badge frm-sd-badge-yolda">Yolda: <b>' + fNum(u.yoldaki_toplam) + '</b></span>';
            h += '      <span class="frm-sd-badge frm-sd-badge-fiyat">$<b>' + fiyatAralikStr(u) + '</b></span>';
            var kbItem = F.Helpers.koliBilgi(u);
            if (kbItem) h += '<span class="frm-sd-badge frm-sd-badge-koli" data-koli-tip="' + esc(kbItem.tam) + '"><i class="icon-package"></i> ' + esc(kbItem.tam) + '</span>';
            h += '    </div>';
            } else {
            h += '    <div class="frm-sd-badges">';
            if (u.urun_kodu) h += '<span class="frm-sd-badge frm-sd-badge-kod">' + esc(u.urun_kodu) + '</span>';
            h += '    </div>';
            }
            h += '  </div>';
            h += '</div>';
        }
        h += '</div>';

        // Sağ detay
        h += '<div class="frm-sd-detail" id="frmSdDetail">';
        h += '  <div class="frm-sd-detail-ph"><i class="icon-eye"></i><span>Detay görmek için<br>bir ürün seçin</span></div>';
        h += '</div>';

        h += '</div>';

        dropdown.innerHTML = h;
        ac();

        // İlk ürünü otomatik seç
        if (data.length > 0) {
            focusIdx = 0;
            setActive(0);
        }

        // Hover + tıklama
        dropdown.querySelectorAll('.frm-sd-item').forEach(function(el) {
            el.addEventListener('mouseenter', function() {
                var idx = parseInt(this.getAttribute('data-index'));
                focusIdx = idx;
                setActive(idx);
            });
            el.addEventListener('click', function() {
                var idx = parseInt(this.getAttribute('data-index'));
                sec(idx);
            });
        });
    }

    // --- Detay paneli (V2N Birleşik Düzen) ---
    function renderDetay(u) {
        var panel = document.getElementById('frmSdDetail');
        if (!panel || !u) return;

        var h = '';

        // Body
        h += '<div class="frm-sd-d-body">';

        // Kart 1: Üst Header (Resim + Ad + Fiyat)
        h += '<div class="frm-sd-cr">';
        h += '<div class="frm-sd-top-head">';
        h += '  <div class="frm-sd-img-sq">';
        if (u.resim_url) {
            h += '<img src="' + esc(resimUrl(u.resim_url)) + '" alt="" onerror="this.style.display=\'none\';this.nextElementSibling.style.display=\'flex\'"><i class="icon-image frm-sd-img-ph" style="display:none"></i>';
        } else {
            h += '<i class="icon-image frm-sd-img-ph"></i>';
        }
        h += '  </div>';
        h += '  <div class="frm-sd-top-name">' + esc(u.urun_adi) + (u.urun_kaynak === 'bayi' ? ' <span style="display:inline-block;background:#103595;color:#fff;font-size:10px;padding:2px 7px;border-radius:5px;vertical-align:middle"><i class="icon-tag"></i> Kendi Ürünüm</span>' : '') + '</div>';
        if (u.on_siparis_urun) {
        h += '  <div class="frm-ot-detail-badge"><i class="icon-zap"></i> Ön Talep Ürünü</div>';
        } else if (!F.Config.isOnSiparis) {
        h += '  <div class="frm-sd-price-wrap">';
        h += '    <div class="frm-sd-price-accent"></div>';
        h += '    <div>';
        h += '      <div class="frm-sd-price-val">' + F.Config.paraSembolu + fiyatAralikStr(u) + '</div>';
        h += '    </div>';
        h += '  </div>';
        }
        h += '</div>';
        h += '</div>';

        if (!F.Config.isOnSiparis && !u.on_siparis_urun) {
        // Kart 2: Stok Satırları (Birleşik V2N)
        h += '<div class="frm-sd-cr">';

        // Depo satırı (yeşil) - varsayılan depo büyük, diğerleri badge
        // Tedarik (stokMiktarGizle): gerçek depo adı ("Mağaza" vb.) yerine genel "Stok" etiketi.
        // Merkez depo adını bayi tarafına sızdırmaz + net durur; değer (aralık: 1000+) aynen kalır.
        // Mağazam satışında (stokMiktarGizle=false) gerçek depo adı korunur.
        var varsDepoAdi = F.Config.stokMiktarGizle ? 'Stok' : (u.varsayilan_depo_adi || 'Ana Depo');
        var varsDepoStok = u.varsayilan_depo_stok || 0;
        h += '<div class="frm-sd-stok-row green">';
        h += '  <div class="frm-sd-stok-big">';
        h += '    <div class="frm-sd-num">' + fNum(varsDepoStok) + '</div>';
        h += '    <div class="frm-sd-lbl-accent">' + esc(varsDepoAdi) + '</div>';
        h += '  </div>';
        h += '  <div class="frm-sd-stok-div"></div>';
        h += '  <div class="frm-sd-stok-details">';
        h += '    <div class="frm-sd-depo-badges">';
        // Diğer depoları badge olarak göster
        var digerDepolar = (u.depo_stoklar || []).filter(function(d) { return !d.varsayilan; });
        if (digerDepolar.length > 0) {
            for (var di = 0; di < digerDepolar.length; di++) {
                h += '<span class="frm-sd-bg frm-sd-bg-d">' + esc(digerDepolar[di].depo_adi) + ': <b>' + fNum(digerDepolar[di].miktar) + '</b></span>';
            }
        }
        // Tedarikte tam miktar gizli (toplam_stok=null → anlamsız) → "Toplam" badge yalnız Mağazam'da
        if (!F.Config.stokMiktarGizle) {
        h += '      <span class="frm-sd-bg frm-sd-bg-d" style="border-style:dashed">Toplam: <b>' + fNum(u.toplam_stok) + '</b></span>';
        }
        h += '    </div>';
        h += '  </div>';
        h += '</div>';

        // Yolda satırı (mavi) - her zaman göster
        h += '<div class="frm-sd-stok-row blue">';
        h += '  <div class="frm-sd-stok-big">';
        h += '    <div class="frm-sd-num">' + fNum(u.yoldaki_toplam) + '</div>';
        h += '    <div class="frm-sd-lbl">Yolda</div>';
        h += '  </div>';
        h += '  <div class="frm-sd-stok-div"></div>';
        h += '  <div class="frm-sd-stok-details">';
        h += '    <div class="frm-sd-badge-wrap">';
        h += '<span class="frm-sd-bg frm-sd-bg-k"><i class="icon-truck"></i> Konteyner: <b>' + fNum(u.konteyner_stok) + '</b></span>';
        h += '<span class="frm-sd-bg frm-sd-bg-u"><i class="icon-send"></i> Uçak: <b>' + fNum(u.ucak_stok) + '</b></span>';
        h += '<span class="frm-sd-bg frm-sd-bg-s"><i class="icon-shopping-bag"></i> Sipariş: <b>' + fNum(u.siparis_stok) + '</b></span>';
        h += '    </div>';
        h += '  </div>';
        h += '</div>';

        h += '</div>'; // stok kart
        } // /!isOnSiparis

        // Kart 3: Ürün Bilgileri (Info Grid)
        h += '<div class="frm-sd-cr">';
        h += '<div class="frm-sd-info-grid">';
        h += infoCell('Ürün Kodu', esc(u.urun_kodu || '-'));
        if (u.barkod) h += infoCell('Barkod', esc(u.barkod));
        h += infoCell('Kategori', '<span class="frm-sd-tg-k">' + esc(u.kategori_adi) + '</span>');
        if (u.birim_adi) h += infoCell('Birim', esc(u.birim_adi));
        var kbDetay = F.Helpers.koliBilgi(u);
        if (kbDetay) h += infoCell('Koli / Paket', '<b>' + esc(kbDetay.tam) + '</b>');
        else if (u.koli_adedi > 0) h += infoCell('Koli', '<b>' + fNum(u.koli_adedi) + '</b> adet');
        if (u.varyant_tipi !== 'duz') h += infoCell('Varyant', '<span class="frm-sd-tg-v">' + esc(u.varyant_label) + '</span>');
        h += '</div>';
        h += '</div>';

        h += '</div>'; // body

        // Footer: Ekle butonu
        h += '<div class="frm-sd-d-ft">';
        if (u.on_siparis_urun) {
        var otMevcut = F.State.onTalepUrunBul ? F.State.onTalepUrunBul(u.id) : null;
        h += '<button type="button" class="frm-sd-d-add-btn frm-sd-d-add-btn-ot" data-id="' + u.id + '"><i class="icon-zap"></i> ' + (otMevcut ? 'Ön Talebi Düzenle' : 'Ön Talep Ekle') + '</button>';
        } else if (u.stok_aralik && u.stok_aralik.kod === 0) {
        // ANA stok yok (tedarikte: merkez siparişe uygun depoda 0). Yalnız ANA stok baz alınır —
        // yolda/konteyner/toplam "Yok" olsa bile ana depoda stok varsa ürün eklenebilir kalmalı
        // (FN-180 bug'ı: yolda 0 yüzünden ana depoda 1500+ stoklu ürün yanlışlıkla kilitleniyordu).
        h += '<button type="button" class="frm-sd-d-add-btn" data-stok-engel="1" disabled style="opacity:.45;pointer-events:none;cursor:not-allowed"><i class="icon-slash"></i> Stokta Yok</button>';
        } else {
        h += '<button type="button" class="frm-sd-d-add-btn" data-id="' + u.id + '"><i class="icon-plus-circle"></i> Ürünü Ekle</button>';
        }
        h += '</div>';

        panel.innerHTML = h;

        // Ekle butonu event
        panel.querySelector('.frm-sd-d-add-btn').addEventListener('click', function() {
            var id = parseInt(this.getAttribute('data-id'));
            var idx = -1;
            for (var j = 0; j < sonuclar.length; j++) {
                if (sonuclar[j].id === id) { idx = j; break; }
            }
            if (idx >= 0) sec(idx);
        });
    }

    function infoCell(label, val) {
        return '<div class="frm-sd-info-cell"><span class="frm-sd-info-lb">' + label + '</span><span class="frm-sd-info-vl">' + val + '</span></div>';
    }

    // --- Ürün seç → detay yükle → modal aç ---
    function sec(index) {
        var u = sonuclar[index];
        if (!u) return;

        // Stok 0 engeli: Sunix sipariş modunda stoksuz ürün seçilemez (ön talep hariç)
        if (F.Config.stokMiktarGizle && !u.on_siparis_urun && u.stok_aralik && u.stok_aralik.kod === 0) {
            Swal.fire({
                icon: 'error',
                title: 'Stokta Yok',
                text: (u.urun_adi || 'Bu ürün') + ' şu anda stokta bulunmamaktadır.',
                confirmButtonColor: '#103595'
            });
            return;
        }

        kapat();
        input.value = '';

        // Ön talep ürünü: ayrı akış
        if (u.on_siparis_urun) {
            onTalepSec(u);
        // Arızalı iade modunda: modal atla, SweetAlert ile basit giriş
        } else if (F.State.isIade && F.State.iadeKategorisi === 'arizali') {
            arizaliUrunEkle(u);
        } else {
            urunDetayYukle(u);
        }
    }

    /**
     * Ön talep ürünü seçildi — flag set et + normal modal akışına yönlendir
     */
    function onTalepSec(u) {
        if (!F.State.musteriId) {
            Swal.fire({
                icon: 'warning',
                title: 'Müşteri Gerekli',
                text: 'Ön talep oluşturmak için önce müşteri/bayi seçmelisiniz.',
                confirmButtonColor: '#f59e0b'
            });
            return;
        }

        F.State.onTalepAktif = true;
        F.State.onTalepEditData = F.State.onTalepUrunBul ? F.State.onTalepUrunBul(u.id) : null;
        urunDetayYukle(u);
    }

    /**
     * Arızalı iade modunda ürün ekleme
     * Varyantlı ürünlerde fiyat gruplarını kontrol eder
     */
    function arizaliUrunEkle(u) {
        // Varyantlı ürün: detay çekip fiyat gruplarını kontrol et
        if (u.model_varmi === 'evet' || u.renk_varmi === 'evet') {
            F.Helpers.ajaxPost('urun-detay.php', {
                urun_id: u.id,
                depo_id: F.State.seciliDepoId,
                kaynak: u.urun_kaynak || 'sunix',
                mod: F.Config.mod
            }, function(res) {
                if (!res.success || !res.data) {
                    Swal.fire('Hata', 'Ürün detayı yüklenemedi', 'error');
                    return;
                }
                var data = res.data;
                // Fiyat gruplarını oluştur
                var gruplar = arizaFiyatGruplari(data);
                if (gruplar.length > 1) {
                    arizaFiyatGrupluModal(u, data, gruplar);
                } else {
                    var tekFiyat = gruplar.length === 1 ? gruplar[0].fiyat : (parseFloat(u.satis_fiyati) || 0);
                    arizaBasitModal(u, tekFiyat);
                }
            });
        } else {
            // Düz ürün: basit modal
            arizaBasitModal(u, parseFloat(u.satis_fiyati) || 0);
        }
    }

    /**
     * Varyant fiyat gruplarını oluştur
     */
    function arizaFiyatGruplari(data) {
        var fiyatMap = {};
        var modeller = data.modeller || [];
        modeller.forEach(function(m) {
            var f = parseFloat(m.satis_fiyati) || 0;
            var key = f.toFixed(2);
            if (!fiyatMap[key]) {
                fiyatMap[key] = { fiyat: f, modeller: [] };
            }
            fiyatMap[key].modeller.push(m.model_adi || '');
        });
        // Renk varyanları da kontrol et (model yoksa)
        if (modeller.length === 0 && data.renkler) {
            var renkFiyat = parseFloat(data.fiyat) || 0;
            fiyatMap[renkFiyat.toFixed(2)] = { fiyat: renkFiyat, modeller: ['Tüm renkler'] };
        }
        var gruplar = [];
        Object.keys(fiyatMap).sort(function(a, b) { return parseFloat(a) - parseFloat(b); }).forEach(function(k) {
            gruplar.push(fiyatMap[k]);
        });
        return gruplar;
    }

    /**
     * Basit arızalı modal (tek fiyat — düz ürün veya tek fiyat grubulu varyant)
     */
    function arizaBasitModal(u, fiyat) {
        var esc = F.Helpers.escHtml;
        var fmt = F.Helpers.formatPara;
        var container = document.getElementById('frmOverlayContent');
        if (!container) return;

        var html = '<div class="frm-md-mc" style="--frm-ac:#dc2626">';
        html += '<div class="frm-md-sw"><div class="frm-md-sw-top"><div><div class="frm-md-sw-name">' + esc(u.urun_adi) + '</div><div class="frm-md-sw-cat">' + esc(u.urun_kodu || '') + ' \u2014 Ar\u0131zal\u0131 \u0130ade</div></div><div><div class="frm-md-sw-cat" style="text-align:right">Birim Fiyat</div><div class="frm-md-sw-price">' + fmt(fiyat) + '</div></div></div><div class="frm-md-sw-divider"></div></div>';
        html += '<div class="frm-md-bd">';
        html += '<div class="frm-md-cp open"><div class="frm-md-cp-h"><div class="frm-md-cp-t"><i class="icon-box"></i> Miktar</div></div><div class="frm-md-cp-b"><div class="frm-md-cp-in"><div class="frm-md-qc"><button type="button" class="frm-md-qc-btn" id="frmArizaQtyMinus"></button><input class="frm-md-qc-inp" type="text" inputmode="numeric" autocomplete="off" value="1" id="frmArizaQty"><button type="button" class="frm-md-qc-btn frm-md-qc-plus" id="frmArizaQtyPlus"></button></div></div></div></div>';
        html += '<div class="frm-md-cp open"><div class="frm-md-cp-h"><div class="frm-md-cp-t"><i class="icon-dollar-sign"></i> Fiyat</div></div><div class="frm-md-cp-b"><div class="frm-md-cp-in"><div class="frm-md-pw"><span class="frm-md-pw-s">' + F.Config.paraSembolu + '</span><input class="frm-md-pw-i" type="text" inputmode="decimal" autocomplete="off" value="' + fiyat.toFixed(2) + '" id="frmArizaFiyat"></div></div></div></div>';
        html += '<div class="frm-md-cp open"><div class="frm-md-cp-h"><div class="frm-md-cp-t"><i class="icon-alert-triangle"></i> Ar\u0131za A\u00e7\u0131klamas\u0131</div></div><div class="frm-md-cp-b"><div class="frm-md-cp-in"><textarea class="frm-md-txa" autocomplete="off" placeholder="Ar\u0131za detay\u0131n\u0131 yaz\u0131n\u0131z..." id="frmArizaAciklama" rows="2"></textarea></div></div></div>';
        html += '</div>';
        html += '<div class="frm-md-ft"><div><div class="frm-md-ft-lbl">Toplam Tutar</div><div class="frm-md-ft-line"><span class="frm-md-ft-val" id="frmArizaToplam">' + fmt(fiyat) + '</span></div></div><button type="button" class="frm-md-btn" id="frmArizaUygula">Ekle</button></div>';
        html += '</div>';

        container.innerHTML = html;
        document.getElementById('frmOverlay').classList.add('frm-overlay-show');
        document.body.style.overflow = 'hidden';

        setTimeout(function() {
            container.querySelectorAll('.frm-md-cp.open .frm-md-cp-b').forEach(function(b) { b.style.maxHeight = 'none'; b.style.overflow = 'visible'; });
            var qEl = document.getElementById('frmArizaQty');
            if (qEl) { qEl.focus(); qEl.select(); }
        }, 50);

        function toplamHesapla() {
            var q = parseInt(document.getElementById('frmArizaQty').value) || 0;
            var p = parseFloat((document.getElementById('frmArizaFiyat').value || '0').replace(/,/g, '')) || 0;
            var el = document.getElementById('frmArizaToplam');
            if (el) el.textContent = fmt(F.Helpers.bankersRound(q * p, 2));
        }

        document.getElementById('frmArizaQtyMinus').addEventListener('click', function() { var v = parseInt(document.getElementById('frmArizaQty').value) || 1; if (v > 1) document.getElementById('frmArizaQty').value = v - 1; toplamHesapla(); });
        document.getElementById('frmArizaQtyPlus').addEventListener('click', function() { var v = parseInt(document.getElementById('frmArizaQty').value) || 0; document.getElementById('frmArizaQty').value = v + 1; toplamHesapla(); });
        document.getElementById('frmArizaQty').addEventListener('input', toplamHesapla);
        document.getElementById('frmArizaFiyat').addEventListener('input', toplamHesapla);

        document.getElementById('frmArizaUygula').addEventListener('click', function() {
            var miktar = parseInt(document.getElementById('frmArizaQty').value) || 0;
            var birimFiyat = parseFloat((document.getElementById('frmArizaFiyat').value || '0').replace(/,/g, '')) || 0;
            var aciklama = (document.getElementById('frmArizaAciklama').value || '').trim();
            if (miktar <= 0) { Swal.fire('Uyar\u0131', 'Miktar 0\'dan b\u00fcy\u00fck olmal\u0131', 'warning'); return; }
            var kdvOrani = F.Config.aktifKdvOrani();
            var tutar = F.Helpers.bankersRound(miktar * birimFiyat, 2);
            var kdv = F.Helpers.bankersRound(tutar * kdvOrani / 100, 2);
            F.Modal.kapat();
            F.Tablo.satirEkle({ satirId: F.State.yeniSatirId(), urunId: u.id, urunAdi: u.urun_adi, urunKodu: u.urun_kodu || '', resimUrl: u.resim_url || '', tip: 'duz', miktar: miktar, birimFiyat: birimFiyat, normalBirimFiyat: birimFiyat, fiyatKurali: null, tutar: tutar, kdvOrani: kdvOrani, kdv: kdv, toplam: tutar + kdv, depoId: null, not: aciklama, varyantlar: [], ffSatirlar: [], paketBilgi: null, kategoriId: u.kategori_id || null });
        });
    }

    /**
     * Fiyat gruplu arızalı modal (çok fiyatlı varyantlı ürünler)
     */
    function arizaFiyatGrupluModal(u, data, gruplar) {
        var esc = F.Helpers.escHtml;
        var fmt = F.Helpers.formatPara;
        var container = document.getElementById('frmOverlayContent');
        if (!container) return;

        var html = '<div class="frm-md-mc" style="--frm-ac:#dc2626;max-width:500px">';

        // Header
        html += '<div class="frm-md-sw"><div class="frm-md-sw-top"><div><div class="frm-md-sw-name">' + esc(u.urun_adi) + '</div><div class="frm-md-sw-cat">Ar\u0131zal\u0131 \u0130ade \u2014 ' + gruplar.length + ' Fiyat Grubu</div></div></div><div class="frm-md-sw-divider"></div></div>';

        // Body (scroll destekli)
        html += '<div class="frm-md-bd frm-ariza-scroll">';
        html += '<div class="frm-md-cp open"><div class="frm-md-cp-h"><div class="frm-md-cp-t"><i class="icon-layers"></i> Fiyat Gruplar\u0131</div></div><div class="frm-md-cp-b"><div class="frm-md-cp-in" style="padding:8px 14px">';

        gruplar.forEach(function(g, idx) {
            var modelSayisi = g.modeller.length;
            html += '<div class="frm-ariza-fg" data-idx="' + idx + '">';

            // Üst: model sayısı + badge'ler (3'e kadar) veya tooltip
            html += '<div class="frm-ariza-fg-label">';
            html += '<span class="frm-ariza-fg-count">' + modelSayisi + ' Model</span>';
            if (modelSayisi <= 3) {
                g.modeller.forEach(function(m) {
                    html += '<span class="frm-ariza-fg-badge">' + esc(m) + '</span>';
                });
            } else {
                // İlk 2 badge + tooltip
                html += '<span class="frm-ariza-fg-badge">' + esc(g.modeller[0]) + '</span>';
                html += '<span class="frm-ariza-fg-badge">' + esc(g.modeller[1]) + '</span>';
                html += '<span class="frm-ariza-fg-more" title="' + esc(g.modeller.join(', ')) + '">+' + (modelSayisi - 2) + '</span>';
            }
            html += '</div>';

            // Alt: fiyat + miktar stepper
            html += '<div class="frm-ariza-fg-row">';
            html += '<span class="frm-ariza-fg-fiyat">' + fmt(g.fiyat) + '</span>';
            html += '<div class="frm-md-qc" style="min-width:130px"><button type="button" class="frm-md-qc-btn frm-ariza-fg-minus" data-idx="' + idx + '"></button><input class="frm-md-qc-inp frm-ariza-fg-qty" type="text" inputmode="numeric" autocomplete="off" value="0" data-idx="' + idx + '" data-fiyat="' + g.fiyat + '"><button type="button" class="frm-md-qc-btn frm-md-qc-plus frm-ariza-fg-plus" data-idx="' + idx + '"></button></div>';
            html += '</div>';

            html += '</div>';
        });

        html += '</div></div></div>';

        // Arıza Açıklaması
        html += '<div class="frm-md-cp open"><div class="frm-md-cp-h"><div class="frm-md-cp-t"><i class="icon-alert-triangle"></i> Ar\u0131za A\u00e7\u0131klamas\u0131</div></div><div class="frm-md-cp-b"><div class="frm-md-cp-in"><textarea class="frm-md-txa" autocomplete="off" placeholder="Ar\u0131za detay\u0131n\u0131 yaz\u0131n\u0131z..." id="frmArizaAciklama" rows="2"></textarea></div></div></div>';
        html += '</div>';

        // Footer
        html += '<div class="frm-md-ft"><div><div class="frm-md-ft-lbl">Toplam Tutar</div><div class="frm-md-ft-line"><span class="frm-md-ft-val" id="frmArizaToplam">' + fmt(0) + '</span></div></div><button type="button" class="frm-md-btn" id="frmArizaUygula">Ekle</button></div>';
        html += '</div>';

        container.innerHTML = html;
        document.getElementById('frmOverlay').classList.add('frm-overlay-show');
        document.body.style.overflow = 'hidden';

        setTimeout(function() {
            container.querySelectorAll('.frm-md-cp.open .frm-md-cp-b').forEach(function(b) { b.style.maxHeight = 'none'; b.style.overflow = 'visible'; });
        }, 50);

        // Toplam hesapla
        function toplamHesapla() {
            var toplam = 0;
            container.querySelectorAll('.frm-ariza-fg-qty').forEach(function(inp) {
                var q = parseInt(inp.value) || 0;
                var p = parseFloat(inp.getAttribute('data-fiyat')) || 0;
                toplam += F.Helpers.bankersRound(q * p, 2);
            });
            var el = document.getElementById('frmArizaToplam');
            if (el) el.textContent = fmt(toplam);
        }

        // Qty +/- butonları (eski delegated handler temizle, birikim önle)
        $(container).off('click', '.frm-ariza-fg-minus, .frm-ariza-fg-plus');
        $(container).on('click', '.frm-ariza-fg-minus, .frm-ariza-fg-plus', function() {
            var idx = this.getAttribute('data-idx');
            var inp = container.querySelector('.frm-ariza-fg-qty[data-idx="' + idx + '"]');
            if (!inp) return;
            var val = parseInt(inp.value) || 0;
            if (this.classList.contains('frm-ariza-fg-minus')) {
                if (val > 0) inp.value = val - 1;
            } else {
                inp.value = val + 1;
            }
            toplamHesapla();
        });

        // Qty input değişimi
        container.querySelectorAll('.frm-ariza-fg-qty').forEach(function(inp) {
            inp.addEventListener('input', toplamHesapla);
        });

        // Ekle butonu
        document.getElementById('frmArizaUygula').addEventListener('click', function() {
            var aciklama = (document.getElementById('frmArizaAciklama').value || '').trim();
            var kdvOrani = F.Config.aktifKdvOrani();
            var eklenen = 0;

            // Değerleri ÖNCE topla (kapat container'ı temizler)
            var satirVerileri = [];
            container.querySelectorAll('.frm-ariza-fg-qty').forEach(function(inp) {
                var miktar = parseInt(inp.value) || 0;
                if (miktar <= 0) return;
                var birimFiyat = parseFloat(inp.getAttribute('data-fiyat')) || 0;
                satirVerileri.push({ miktar: miktar, birimFiyat: birimFiyat });
            });

            if (satirVerileri.length === 0) {
                Swal.fire('Uyar\u0131', 'En az bir fiyat grubuna miktar giriniz.', 'warning');
                return;
            }

            F.Modal.kapat();

            satirVerileri.forEach(function(sv) {
                var miktar = sv.miktar;
                var birimFiyat = sv.birimFiyat;
                var tutar = F.Helpers.bankersRound(miktar * birimFiyat, 2);
                var kdv = F.Helpers.bankersRound(tutar * kdvOrani / 100, 2);

                F.Tablo.satirEkle({
                    satirId: F.State.yeniSatirId(),
                    urunId: u.id,
                    urunAdi: u.urun_adi,
                    urunKodu: u.urun_kodu || '',
                    resimUrl: u.resim_url || '',
                    tip: 'duz',
                    miktar: miktar,
                    birimFiyat: birimFiyat,
                    normalBirimFiyat: birimFiyat,
                    fiyatKurali: null,
                    tutar: tutar,
                    kdvOrani: kdvOrani,
                    kdv: kdv,
                    toplam: tutar + kdv,
                    depoId: null,
                    not: aciklama,
                    varyantlar: [],
                    ffSatirlar: [],
                    paketBilgi: null,
                    kategoriId: u.kategori_id || null
                });
                eklenen++;
            });
        });
    }

    function urunDetayYukle(u) {
        F.Helpers.ajaxPost('urun-detay.php', {
            urun_id: u.id,
            depo_id: F.State.seciliDepoId,
            kaynak: u.urun_kaynak || 'sunix',
            mod: F.Config.mod,
            // Tedarik alışında varyant fiyatları ALIŞ fiyatıyla ön-dolar (satış/baz değil)
            tedarik_alis: F.Config.isTedarikAlis ? 1 : 0
        }, function(res) {
            if (res.success && res.data) {
                var data = res.data;
                // Kaynak haritası: bayi-own ürünleri satır/payload/stok-kontrol bu haritadan kaynak öğrenir
                F.State.urunKaynakMap = F.State.urunKaynakMap || {};
                F.State.urunKaynakMap[data.id] = data.urun_kaynak || u.urun_kaynak || 'sunix';
                F.Events.emit('urun:secildi', { urunData: data });

                var tip = belirleUrunTip(data);
                F.Events.emit('modal:ac', {
                    tip: tip,
                    urunData: data,
                    satirId: null
                });
            } else {
                Swal.fire('Hata', res.message || 'Ürün detayı yüklenemedi', 'error');
            }
        }, function() {
            Swal.fire('Hata', 'Ürün detayı yüklenirken hata oluştu', 'error');
        });
    }

    function belirleUrunTip(data) {
        if (data.kategori_id == 15 && data.model_varmi === 'evet' && data.paket_sablon) return 'kilif';
        if (data.model_varmi === 'evet' || data.renk_varmi === 'evet') return 'varyant';
        return 'duz';
    }

    // --- Focus / Active ---
    function setActive(idx) {
        dropdown.querySelectorAll('.frm-sd-item').forEach(function(el, i) {
            el.classList.toggle('active', i === idx);
        });
        renderDetay(sonuclar[idx]);
    }

    function focusGuncelle(items) {
        items.forEach(function(el) { el.classList.remove('active'); });
        if (focusIdx >= 0 && items[focusIdx]) {
            items[focusIdx].classList.add('active');
            items[focusIdx].scrollIntoView({ block: 'nearest' });
            renderDetay(sonuclar[focusIdx]);
        }
    }

    function yukleniyorGoster() {
        dropdown.innerHTML = '<div class="frm-sd-loading"><div class="frm-sd-spinner"></div> Aranıyor...</div>';
        ac();
    }

    // --- Yardımcılar ---
    function imgTag(u) {
        if (u.resim_url) return '<img src="' + esc(resimUrl(u.resim_url)) + '" alt="" onerror="this.parentNode.innerHTML=\'<i class=&quot;icon-image frm-sd-ph&quot;></i>\'">';
        return '<i class="icon-image frm-sd-ph"></i>';
    }
    var esc = F.Helpers.escHtml;
    var fPara = F.Helpers.formatParaSayi;
    function vurgula(t, q) { if (!q) return t; return t.replace(new RegExp('(' + q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi'), '<mark>$1</mark>'); }
    function fNum(n) { return Number(n || 0).toLocaleString('tr-TR'); }
    function fiyatAralikStr(u) {
        if (u.fiyat_min !== undefined && u.fiyat_max !== undefined) {
            var mn = parseFloat(u.fiyat_min) || 0;
            var mx = parseFloat(u.fiyat_max) || 0;
            if (Math.abs(mn - mx) > 0.001) return fPara(mn) + ' - ' + fPara(mx);
        }
        return fPara(u.satis_fiyati);
    }

})();
