/**
 * Form - Varyant Modal Kart Render: pRenk, pMR, pModel
 * Kaynak: denemeler/varyant-secim-temasi-v3.php
 */
(function() {
    'use strict';

    var F = window.Form;
    F.ModalVaryant = F.ModalVaryant || {};

    var container = null;

    F.ModalVaryant.init = function() {
        // Event bazlı çalışır
    };

    /**
     * Modal render
     */
    F.ModalVaryant.render = function(cont, urunData, satirId) {
        container = cont;
        F.ModalVaryant.resetState();
        F.ModalVaryant.ST.urunData = urunData;
        F.ModalVaryant.ST.satirId = satirId;

        // Ürün tipine göre aktif tab (utm.renk_varmi'ya göre belirle)
        if (urunData.model_varmi === 'evet') {
            // Model sekmesi her zaman öncelikli/varsayılan
            var hasModelOnly = false;
            if (urunData.modeller) {
                for (var ci = 0; ci < urunData.modeller.length; ci++) {
                    if (urunData.modeller[ci].renk_varmi !== 'evet') { hasModelOnly = true; break; }
                }
            }
            F.ModalVaryant.ST.vt = hasModelOnly ? 'model' : 'model_renk';
        } else {
            F.ModalVaryant.ST.vt = 'renk';
        }

        // Düzenleme modu: mevcut satırdan varyant verilerini geri yükle
        if (satirId) {
            var mevcutSatir = F.State.satirBul(satirId);
            if (mevcutSatir) {
                // Fiyat kuralı bilgisini satırdan yükle (API cevabı gelene kadar kullanılır)
                if (mevcutSatir.fiyatKurali) {
                    F.ModalVaryant.ST.fiyatKurali = mevcutSatir.fiyatKurali;
                    F.ModalVaryant.ST.varsayilanFiyatListesi = F.Helpers.fiyatKuraliUygula(urunData.fiyat || 0, mevcutSatir.fiyatKurali);
                }
                if (mevcutSatir.varyantlar && mevcutSatir.varyantlar.length > 0) {
                    // Build modelId lookup map: tm.id → utm.id (kart key'leri utm.id kullanır)
                    var modelIdMap = {};
                    if (urunData.modeller) {
                        for (var mi2 = 0; mi2 < urunData.modeller.length; mi2++) {
                            var mod2 = urunData.modeller[mi2];
                            // mod2.id = utm.id, mod2.telefon_model_id = tm.id
                            if (mod2.telefon_model_id) modelIdMap[mod2.telefon_model_id] = mod2.id;
                            modelIdMap[mod2.id] = mod2.id; // identity (utm.id → utm.id)
                        }
                    }
                    var urunOrijFiyat = urunData.fiyat || 0;
                    for (var vi = 0; vi < mevcutSatir.varyantlar.length; vi++) {
                        var v = mevcutSatir.varyantlar[vi];
                        var key;
                        if (v.tip && v.id != null) {
                            var prefix = v.tip === 'renk' ? 'r' : (v.tip === 'model' ? 'm' : 'mr');
                            key = prefix + '_' + (v.tip === 'model' ? (modelIdMap[v.id] || v.id) : v.id);
                        } else {
                            // Fallback: mevcut ID alanlarından key türet
                            if (v.telefonModelRenkId) { key = 'mr_' + v.telefonModelRenkId; }
                            else if (v.renkId) { key = 'r_' + v.renkId; }
                            else if (v.modelId) { key = 'm_' + (modelIdMap[v.modelId] || v.modelId); }
                            else { continue; }
                        }
                        if (v.miktar > 0) F.ModalVaryant.ST.q[key] = v.miktar;
                        // ORİJİNAL fiyatı yükle (indirim öncesi), sadece custom fiyatlarda (0 fiyat geçerli değerdir)
                        var orijFiyat = (v.normalBirimFiyat != null) ? v.normalBirimFiyat : ((v.birimFiyat != null) ? v.birimFiyat : undefined);
                        if (orijFiyat !== undefined && orijFiyat !== urunOrijFiyat) {
                            F.ModalVaryant.ST.p[key] = orijFiyat;
                        }
                        if (v.depoId !== undefined) F.ModalVaryant.ST.d[key] = v.depoId;
                        // Not: Çin siparişinde obj {tr, en}, diğer modlarda string
                        if (v.not_tr || v.not_en) {
                            F.ModalVaryant.ST.n[key] = { tr: v.not_tr || '', en: v.not_en || '' };
                        } else if (v.not) {
                            F.ModalVaryant.ST.n[key] = F.Config.isCinSiparis ? { tr: v.not, en: '' } : v.not;
                        }
                    }
                }
            }
        }

        // Fiyat listesi varsa fiyat hesapla (yeni ve düzenleme modu)
        if (F.State.fiyatGrubuId) {
            F.Fiyat.urunFiyatHesapla(urunData.id, function(sonuc) {
                if (sonuc && sonuc.kuralVar) {
                    var eskiFiyat = F.ModalVaryant.ST.varsayilanFiyatListesi;
                    F.ModalVaryant.ST.varsayilanFiyatListesi = sonuc.hesaplananFiyat;
                    F.ModalVaryant.ST.fiyatKurali = sonuc.kural;
                    // Sadece fiyat değiştiyse veya yeni eklemede grid'i yeniden çiz
                    if (!satirId || eskiFiyat === null || Math.abs((eskiFiyat || 0) - sonuc.hesaplananFiyat) > 0.005) {
                        F.ModalVaryant.renderGrid();
                        F.ModalVaryant.toplamGuncelle();
                    }
                }
            });
        }

        var esc = F.Helpers.escHtml;
        var html = '<div class="frm-vm-wrap">';

        // Header
        html += '<div class="frm-vm-header">';
        html += '<div class="frm-vm-title">' + esc(urunData.urun_adi) + '</div>';

        // Tabs (ürün tipine göre)
        html += '<div class="frm-vm-tabs">';
        if (urunData.renk_varmi === 'evet' && urunData.model_varmi === 'hayir') {
            html += '<button class="frm-vm-tab active" data-tab="renk"><i class="icon-droplet"></i> Renk</button>';
        }
        if (urunData.model_varmi === 'evet') {
            var hasRenk = urunData.model_renkler && urunData.model_renkler.length > 0;
            // renk_varmi='hayir' olan model var mı? (sadece model sekmesi gerekli mi?)
            var hasModelOnly = false;
            if (urunData.modeller) {
                for (var ti = 0; ti < urunData.modeller.length; ti++) {
                    if (urunData.modeller[ti].renk_varmi !== 'evet') { hasModelOnly = true; break; }
                }
            }
            // Model sekmesi önce (öncelikli)
            if (hasModelOnly || !hasRenk) {
                html += '<button class="frm-vm-tab' + (F.ModalVaryant.ST.vt === 'model' ? ' active' : '') + '" data-tab="model"><i class="icon-smartphone"></i> Model</button>';
            }
            if (hasRenk) {
                html += '<button class="frm-vm-tab' + (F.ModalVaryant.ST.vt === 'model_renk' ? ' active' : '') + '" data-tab="model_renk"><i class="icon-layers"></i> Model+Renk</button>';
            }
        }
        html += '</div>';

        // Depo Önizleme + Search
        html += F.Helpers.depoOnizlemeSelectHtml();
        html += '<div class="frm-vm-search-wrap"><i class="icon-search"></i><input type="text" class="frm-vm-search" id="frmVmSearch" autocomplete="off" placeholder="Varyant ara..."></div>';

        // Total pill
        html += '<div class="frm-vm-total-pill">Toplam: <b id="frmVmTotal">0</b></div>';

        html += '</div>';

        // Toolbar (brand chips)
        html += '<div class="frm-vm-toolbar">';
        html += '<div class="frm-vm-chips" id="frmVmChips"></div>';
        html += '</div>';

        // Content Panel
        html += '<div class="frm-vm-panel" id="frmVmGrid"></div>';

        // Footer
        html += '<div class="frm-vm-footer">';
        if (!(F.Config.isOnSiparis || F.State.onTalepAktif || F.Config.isCinSiparis)) {
            html += '<label class="frm-vm-chk-label"><input type="checkbox" id="frmVmStksuz" checked><span>Stoksuz göster</span></label>';
        }
        html += '<span class="frm-vm-footer-stat" style="margin-left:auto">Seçilen: <b id="frmVmSelCount">0</b> varyant</span>';
        html += '<span class="frm-vm-footer-stat">Toplam: <b id="frmVmSelTotal">0</b></span>';
        if (!(F.Config.isOnSiparis || F.State.onTalepAktif || F.Config.isCinSiparis)) {
            html += '<span class="frm-vm-footer-stat">Tutar: <b class="frm-vm-tutar-eski" id="frmVmSelTutarEski" style="display:none"></b><b id="frmVmSelTutar">$0.00</b></span>';
        }
        html += '<button class="frm-vm-btn-cancel" id="frmVmCancel"><i class="icon-x-circle"></i> İptal</button>';
        var vmBtnText = F.State.onTalepAktif ? 'Ön Talep Kaydet' : 'Sepete Ekle';
        html += '<button class="frm-vm-btn-add" id="frmVmAdd"><i class="icon-plus-circle"></i> ' + vmBtnText + '</button>';
        html += '</div>';

        html += '</div>';

        container.innerHTML = html;
        F.ModalVaryant.bindEvents();
        F.ModalVaryant.renderChips();
        F.ModalVaryant.renderGrid();

        // Stok tooltip event delegation başlat
        F.Helpers.stokTooltipInit(container);
    };

    /**
     * Event binding
     */
    F.ModalVaryant.bindEvents = function() {
        var cancelBtn = container.querySelector('#frmVmCancel');
        if (cancelBtn) cancelBtn.addEventListener('click', function() { F.Modal.guvenliKapat(); });

        // Tab değişimi
        container.querySelectorAll('.frm-vm-tab').forEach(function(tab) {
            tab.addEventListener('click', function() {
                container.querySelectorAll('.frm-vm-tab').forEach(function(t) { t.classList.remove('active'); });
                this.classList.add('active');
                F.ModalVaryant.ST.vt = this.getAttribute('data-tab');
                F.ModalVaryant.renderChips();
                F.ModalVaryant.renderGrid();
            });
        });

        // Arama
        var search = container.querySelector('#frmVmSearch');
        if (search) {
            search.addEventListener('input', F.Helpers.debounce(function() {
                F.ModalVaryant.ST.s = this.value.trim().toLowerCase();
                F.ModalVaryant.renderGrid();
            }, 200));
        }

        // Depo önizleme select
        var depoSel = container.querySelector('#frmDepoOzSelect');
        if (depoSel) {
            depoSel.addEventListener('change', function() {
                F.State.depoOnizleme = this.value === 'tumu' ? 'tumu' : parseInt(this.value);
                F.ModalVaryant.renderGrid();
            });
        }

        // Stoksuz toggle
        var stksuz = container.querySelector('#frmVmStksuz');
        if (stksuz) {
            stksuz.addEventListener('change', function() {
                F.ModalVaryant.ST.ns = this.checked;
                F.ModalVaryant.renderGrid();
            });
        }

        // Sepete Ekle
        var addBtn = container.querySelector('#frmVmAdd');
        if (addBtn) addBtn.addEventListener('click', function() { F.ModalVaryant.sepeteEkle(); });
    };

    /**
     * Marka chip'lerini render et
     */
    F.ModalVaryant.renderChips = function() {
        var data = F.ModalVaryant.ST.urunData;
        var chipsEl = container.querySelector('#frmVmChips');
        if (!chipsEl) return;

        // Markaları topla (sıralama backend'den geldiği gibi korunur)
        var markalar = {};
        var markaOrder = [];
        var kaynaklar = F.ModalVaryant.ST.vt === 'renk' ? [] :
            (F.ModalVaryant.ST.vt === 'model_renk' ? (data.model_renkler || []) : (data.modeller || []));

        for (var i = 0; i < kaynaklar.length; i++) {
            var m = kaynaklar[i];
            if (!markalar[m.marka_id]) {
                markalar[m.marka_id] = {
                    id: m.marka_id,
                    adi: m.marka_adi,
                    renk: m.marka_renk || '#666',
                    logo: m.marka_logo || ''
                };
                markaOrder.push(m.marka_id);
            }
        }

        var html = '<button class="frm-vm-chip' + (F.ModalVaryant.ST.br === 'all' ? ' active' : '') + '" data-marka="all" style="--c:#103595">Tümü</button>';
        for (var mi = 0; mi < markaOrder.length; mi++) {
            var mk = markalar[markaOrder[mi]];
            var isActive = F.ModalVaryant.ST.br == mk.id;
            html += '<button class="frm-vm-chip' + (isActive ? ' active' : '') + '" data-marka="' + mk.id + '" style="--c:' + F.Helpers.escHtml(mk.renk) + '">';
            if (mk.logo) {
                html += '<img class="frm-vm-chip-logo" src="' + F.Helpers.escHtml(resimUrl(mk.logo)) + '" onerror="this.style.display=\'none\';this.nextElementSibling&&(this.nextElementSibling.style.display=\'\')">';
                html += '<span style="display:none">' + F.Helpers.escHtml(mk.adi) + '</span>';
            } else {
                html += '<span class="frm-vm-chip-dot"></span>';
                html += F.Helpers.escHtml(mk.adi);
            }
            html += '</button>';
        }
        chipsEl.innerHTML = html;

        // Chip tıklama
        chipsEl.querySelectorAll('.frm-vm-chip').forEach(function(chip) {
            chip.addEventListener('click', function() {
                chipsEl.querySelectorAll('.frm-vm-chip').forEach(function(c) { c.classList.remove('active'); });
                this.classList.add('active');
                F.ModalVaryant.ST.br = this.getAttribute('data-marka');
                F.ModalVaryant.renderGrid();
            });
        });
    };

    /**
     * Grid render (aktif tab'a göre)
     */
    F.ModalVaryant.renderGrid = function() {
        var gridEl = container.querySelector('#frmVmGrid');
        if (!gridEl) return;

        var data = F.ModalVaryant.ST.urunData;
        var vt = F.ModalVaryant.ST.vt;

        if (vt === 'renk') {
            F.ModalVaryant.renderRenkGrid(gridEl, data.renkler || []);
        } else if (vt === 'model_renk') {
            F.ModalVaryant.renderMRGrid(gridEl, data);
        } else {
            F.ModalVaryant.renderModelGrid(gridEl, data.modeller || []);
        }
    };

    // --- Yardımcı: Renk kontrastı (helpers.js'den) ---
    var getTextColor = F.Helpers.getTextColor;
    var getTextShadow = F.Helpers.getTextShadow;

    // --- Renk kartı oluştur ---
    function colorCard(r, prefix) {
        var stok = F.Helpers.getDepoStok(r.depo_stoklar, r.stok);
        var key = prefix + '_' + r.id;
        var qty = F.ModalVaryant.ST.q[key] || 0;
        var isOos = (F.State.isIade || F.Config.isOnSiparis || (F.State.onTalepAktif && !F.Config.stokMiktarGizle) || F.Config.isCinSiparis || F.Config.stokKontrolAtla) ? false : (stok <= 0);
        var isSel = qty > 0;
        var esc = F.Helpers.escHtml;
        var orijinalFiyat = F.ModalVaryant.ST.urunData.fiyat || 0;
        var varsayilanFiyat = (F.ModalVaryant.ST.varsayilanFiyatListesi !== null)
            ? F.ModalVaryant.ST.varsayilanFiyatListesi
            : orijinalFiyat;
        var kural = F.ModalVaryant.ST.fiyatKurali;
        var fiyat;
        if (F.ModalVaryant.ST.p[key] !== undefined) {
            fiyat = F.ModalVaryant.ST.p[key];
            if (kural) {
                fiyat = F.Helpers.fiyatKuraliUygula(fiyat, kural);
            }
        } else {
            var modelFiyat = F.ModalVaryant.modelFiyatBul(key);
            if (modelFiyat !== null) {
                fiyat = kural ? F.Helpers.fiyatKuraliUygula(modelFiyat, kural) : modelFiyat;
            } else {
                fiyat = varsayilanFiyat;
            }
        }
        var gosterimFiyat = (F.Config.stokMiktarGizle || F.Config.indirimGizle) ? (F.ModalVaryant.ST.p[key] !== undefined ? F.ModalVaryant.ST.p[key] : (F.ModalVaryant.modelFiyatBul(key) || orijinalFiyat)) : fiyat;

        var cls = 'frm-vm-vc';
        if (isOos) cls += ' oos';
        if (isSel) cls += ' sel';

        var h = '<div class="' + cls + '" style="--ac:' + esc(r.renk_kodu || '#888') + ';--swatch-text:' + getTextColor(r.renk_kodu) + ';--swatch-shadow:' + getTextShadow(r.renk_kodu) + '">';

        // Badge
        h += '<div class="frm-vm-vc-badge">\u2713</div>';

        // Not badge (Çin siparişinde varyant başına not)
        var rNotRaw = (F.ModalVaryant.ST.n && F.ModalVaryant.ST.n[key]) || null;
        var rNotText = '';
        if (typeof rNotRaw === 'string') rNotText = rNotRaw;
        else if (rNotRaw && typeof rNotRaw === 'object') rNotText = rNotRaw.tr || rNotRaw.en || '';
        if (rNotText) {
            h += '<span class="frm-vm-vc-note-badge" title="' + esc(rNotText.substring(0, 120)) + '"><i class="icon-edit-3"></i></span>';
        }

        // Swatch
        h += '<div class="frm-vm-vc-swatch">';
        h += '<span class="frm-vm-vc-swatch-name">' + esc(r.renk_adi) + '</span>';
        if (!(F.Config.isOnSiparis || F.State.onTalepAktif || F.Config.isCinSiparis)) {
            var convFn = (F.Doviz && F.Doviz.aktif) ? F.Doviz.conv : function(v) { return v; };
            h += '<span class="frm-vm-vc-swatch-price">' + F.Helpers.formatPara(convFn(gosterimFiyat)) + '</span>';
        }
        h += '</div>';

        // Content: qty row
        h += '<div class="frm-vm-vc-content"><div class="frm-vm-vc-qty-row">';
        h += '<div class="frm-vm-vc-qty-group">';
        if ((F.Config.isOnSiparis || F.State.onTalepAktif || F.Config.isCinSiparis)) {
            // Ön talep/Çin siparişi: stok bilgisi gösterme
        } else if (F.State.isIade) {
            h += '<div class="frm-vm-vc-stk-bar"><span class="frm-vm-vc-stk-label">İADE</span><span class="frm-vm-vc-stk-val">-</span></div>';
        } else {
            h += '<div class="frm-vm-vc-stk-bar frm-stk-tt-wrap"><span class="frm-vm-vc-stk-label">' + F.Helpers.getDepoLabel() + '</span><span class="frm-vm-vc-stk-val">' + stok + '</span>';
            h += F.Helpers.depoTooltipHtml(r.depo_stoklar);
            h += '</div>';
        }
        h += '<input type="text" inputmode="numeric" class="frm-vm-vc-qty" autocomplete="off" data-id="' + key + '" value="' + (qty || '') + '" placeholder="0">';
        h += '<button type="button" class="frm-vm-vc-clear" data-id="' + key + '"' + (qty > 0 ? '' : ' style="display:none"') + '><i class="icon-x"></i></button>';
        h += '</div>';
        if (!(F.Config.isOnSiparis || F.State.onTalepAktif)) {
        h += '<button type="button" class="frm-vm-vc-detail-btn" data-id="' + key + '"><i class="icon-more-vertical"></i></button>';
        }
        h += '</div></div>';

        h += '</div>';
        return h;
    }

    // --- Model kartı oluştur ---
    function modelCard(m) {
        var stok = F.Helpers.getDepoStok(m.depo_stoklar, m.stok);
        var key = 'm_' + m.id;
        var qty = F.ModalVaryant.ST.q[key] || 0;
        var isOos = (F.State.isIade || F.Config.isOnSiparis || (F.State.onTalepAktif && !F.Config.stokMiktarGizle) || F.Config.isCinSiparis || F.Config.stokKontrolAtla) ? false : (stok <= 0);
        var isSel = qty > 0;
        var esc = F.Helpers.escHtml;
        var bc = m.marka_renk || '#103595';
        var orijinalFiyat = F.ModalVaryant.ST.urunData.fiyat || 0;
        var varsayilanFiyat = (F.ModalVaryant.ST.varsayilanFiyatListesi !== null)
            ? F.ModalVaryant.ST.varsayilanFiyatListesi
            : orijinalFiyat;
        var kural = F.ModalVaryant.ST.fiyatKurali;
        var fiyat;
        if (F.ModalVaryant.ST.p[key] !== undefined) {
            fiyat = F.ModalVaryant.ST.p[key];
            if (kural) {
                fiyat = F.Helpers.fiyatKuraliUygula(fiyat, kural);
            }
        } else {
            var modelFiyat = F.ModalVaryant.modelFiyatBul(key);
            if (modelFiyat !== null) {
                fiyat = kural ? F.Helpers.fiyatKuraliUygula(modelFiyat, kural) : modelFiyat;
            } else {
                fiyat = varsayilanFiyat;
            }
        }
        var gosterimFiyat = (F.Config.stokMiktarGizle || F.Config.indirimGizle) ? (F.ModalVaryant.ST.p[key] !== undefined ? F.ModalVaryant.ST.p[key] : (F.ModalVaryant.modelFiyatBul(key) || orijinalFiyat)) : fiyat;

        var cls = 'frm-vm-vc';
        if (isOos) cls += ' oos';
        if (isSel) cls += ' sel';

        var h = '<div class="' + cls + '" style="--ac:' + esc(bc) + ';--swatch-text:#fff;--swatch-shadow:0 1px 2px rgba(0,0,0,.3)">';

        h += '<div class="frm-vm-vc-badge">\u2713</div>';

        // Not badge (Çin siparişinde varyant başına not)
        var mNotRaw = (F.ModalVaryant.ST.n && F.ModalVaryant.ST.n[key]) || null;
        var mNotText = '';
        if (typeof mNotRaw === 'string') mNotText = mNotRaw;
        else if (mNotRaw && typeof mNotRaw === 'object') mNotText = mNotRaw.tr || mNotRaw.en || '';
        if (mNotText) {
            h += '<span class="frm-vm-vc-note-badge" title="' + esc(mNotText.substring(0, 120)) + '"><i class="icon-edit-3"></i></span>';
        }

        // Model swatch
        h += '<div class="frm-vm-vc-swatch-model' + (m.model_resim ? ' has-img' : '') + '">';
        if (m.model_resim) {
            h += '<img src="' + esc(resimUrl(m.model_resim)) + '" class="frm-vm-vc-model-thumb" onerror="this.style.display=\'none\'">';
        }
        h += '<span class="frm-vm-vc-swatch-name">' + esc(m.model_adi) + '</span>';
        if (!(F.Config.isOnSiparis || F.State.onTalepAktif || F.Config.isCinSiparis)) {
            var convFnM = (F.Doviz && F.Doviz.aktif) ? F.Doviz.conv : function(v) { return v; };
            h += '<span class="frm-vm-vc-swatch-price">' + F.Helpers.formatPara(convFnM(gosterimFiyat)) + '</span>';
        }
        h += '</div>';

        // Content
        h += '<div class="frm-vm-vc-content"><div class="frm-vm-vc-qty-row">';
        h += '<div class="frm-vm-vc-qty-group">';
        if ((F.Config.isOnSiparis || F.State.onTalepAktif || F.Config.isCinSiparis)) {
            // Ön talep/Çin siparişi: stok bilgisi gösterme
        } else if (F.State.isIade) {
            h += '<div class="frm-vm-vc-stk-bar"><span class="frm-vm-vc-stk-label">İADE</span><span class="frm-vm-vc-stk-val">-</span></div>';
        } else {
            h += '<div class="frm-vm-vc-stk-bar frm-stk-tt-wrap"><span class="frm-vm-vc-stk-label">' + F.Helpers.getDepoLabel() + '</span><span class="frm-vm-vc-stk-val">' + stok + '</span>';
            h += F.Helpers.depoTooltipHtml(m.depo_stoklar);
            h += '</div>';
        }
        h += '<input type="text" inputmode="numeric" class="frm-vm-vc-qty" autocomplete="off" data-id="' + key + '" value="' + (qty || '') + '" placeholder="0">';
        h += '<button type="button" class="frm-vm-vc-clear" data-id="' + key + '"' + (qty > 0 ? '' : ' style="display:none"') + '><i class="icon-x"></i></button>';
        h += '</div>';
        if (!(F.Config.isOnSiparis || F.State.onTalepAktif)) {
        h += '<button type="button" class="frm-vm-vc-detail-btn" data-id="' + key + '"><i class="icon-more-vertical"></i></button>';
        }
        h += '</div></div>';

        h += '</div>';
        return h;
    }

    /**
     * Renk kartları grid
     */
    F.ModalVaryant.renderRenkGrid = function(gridEl, renkler) {
        var html = '<div class="frm-vm-card-grid">';
        var sayac = 0;
        for (var i = 0; i < renkler.length; i++) {
            var r = renkler[i];
            if (!F.State.isIade && !F.Config.isOnSiparis && !F.State.onTalepAktif && !F.Config.isCinSiparis && !F.ModalVaryant.ST.ns && F.Helpers.getDepoStok(r.depo_stoklar, r.stok) <= 0) continue;
            if (F.ModalVaryant.ST.s && (r.renk_adi || '').toLowerCase().indexOf(F.ModalVaryant.ST.s) === -1) continue;
            html += colorCard(r, 'r');
            sayac++;
        }
        if (sayac === 0) html += '<div class="frm-vm-empty"><i class="icon-search"></i><span>Varyant bulunamadı</span></div>';
        html += '</div>';
        gridEl.innerHTML = html;
        F.ModalVaryantInput.bindInputs(gridEl);
    };

    /**
     * Model kartları grid
     */
    F.ModalVaryant.renderModelGrid = function(gridEl, modeller) {
        var html = '';
        var esc = F.Helpers.escHtml;

        // Markaya göre grupla
        var markalar = {};
        var markaOrder = [];
        for (var i = 0; i < modeller.length; i++) {
            var m = modeller[i];
            if (F.ModalVaryant.ST.br !== 'all' && m.marka_id != F.ModalVaryant.ST.br) continue;
            if (!F.State.isIade && !F.Config.isOnSiparis && !F.State.onTalepAktif && !F.Config.isCinSiparis && !F.ModalVaryant.ST.ns && F.Helpers.getDepoStok(m.depo_stoklar, m.stok) <= 0) continue;
            if (F.ModalVaryant.ST.s && (m.model_adi || '').toLowerCase().indexOf(F.ModalVaryant.ST.s) === -1) continue;

            var mk = m.marka_id;
            if (!markalar[mk]) {
                markalar[mk] = { adi: m.marka_adi, renk: m.marka_renk || '#103595', logo: m.marka_logo, items: [] };
                markaOrder.push(mk);
            }
            markalar[mk].items.push(m);
        }

        for (var mi = 0; mi < markaOrder.length; mi++) {
            var brand = markalar[markaOrder[mi]];
            html += '<div class="frm-vm-brand-box" style="--bc:' + esc(brand.renk) + '">';
            html += '<div class="frm-vm-brand-box-header">';
            if (brand.logo) {
                html += '<img class="frm-vm-brand-box-logo" src="' + esc(resimUrl(brand.logo)) + '" onerror="this.style.display=\'none\';this.nextElementSibling&&(this.nextElementSibling.style.display=\'\')">';
                html += '<span class="frm-vm-brand-box-name" style="display:none">' + esc(brand.adi) + '</span>';
            } else {
                html += '<div class="frm-vm-brand-box-icon">' + esc(brand.adi.charAt(0)) + '</div>';
                html += '<span class="frm-vm-brand-box-name">' + esc(brand.adi) + '</span>';
            }
            html += '</div>';
            html += '<div class="frm-vm-brand-box-body"><div class="frm-vm-card-grid">';
            for (var j = 0; j < brand.items.length; j++) {
                html += modelCard(brand.items[j]);
            }
            html += '</div></div></div>';
        }

        if (!html) html = '<div class="frm-vm-empty"><i class="icon-search"></i><span>Varyant bulunamadı</span></div>';
        gridEl.innerHTML = html;
        F.ModalVaryantInput.bindInputs(gridEl);
    };

    /**
     * Model+Renk grid (marka box → model grup → renk kartları)
     */
    F.ModalVaryant.renderMRGrid = function(gridEl, data) {
        var mrList = data.model_renkler || [];
        var esc = F.Helpers.escHtml;

        if (mrList.length === 0) {
            gridEl.innerHTML = '<div class="frm-vm-empty"><i class="icon-search"></i><span>Model+Renk verisi bulunamadı</span></div>';
            return;
        }

        // Marka → Model → Renkler yapısına dönüştür
        var markalar = {};
        var markaOrder = [];

        for (var i = 0; i < mrList.length; i++) {
            var mr = mrList[i];
            if (F.ModalVaryant.ST.br !== 'all' && mr.marka_id != F.ModalVaryant.ST.br) continue;
            if (!F.State.isIade && !F.Config.isOnSiparis && !F.State.onTalepAktif && !F.Config.isCinSiparis && !F.ModalVaryant.ST.ns && F.Helpers.getDepoStok(mr.depo_stoklar, mr.stok) <= 0) continue;
            if (F.ModalVaryant.ST.s) {
                var search = F.ModalVaryant.ST.s;
                if ((mr.model_adi || '').toLowerCase().indexOf(search) === -1 && (mr.renk_adi || '').toLowerCase().indexOf(search) === -1) continue;
            }

            var markaKey = mr.marka_id;
            if (!markalar[markaKey]) {
                markalar[markaKey] = { adi: mr.marka_adi, renk: mr.marka_renk || '#103595', logo: mr.marka_logo, modeller: {}, modelOrder: [] };
                markaOrder.push(markaKey);
            }

            var modelKey = mr.urun_telefon_model_id;
            if (!markalar[markaKey].modeller[modelKey]) {
                markalar[markaKey].modeller[modelKey] = { adi: mr.model_adi, renkler: [] };
                markalar[markaKey].modelOrder.push(modelKey);
            }
            markalar[markaKey].modeller[modelKey].renkler.push(mr);
        }

        var html = '';
        for (var mi = 0; mi < markaOrder.length; mi++) {
            var mk = markalar[markaOrder[mi]];
            html += '<div class="frm-vm-brand-box" style="--bc:' + esc(mk.renk) + '">';

            // Brand header
            html += '<div class="frm-vm-brand-box-header">';
            if (mk.logo) {
                html += '<img class="frm-vm-brand-box-logo" src="' + esc(resimUrl(mk.logo)) + '" onerror="this.style.display=\'none\';this.nextElementSibling&&(this.nextElementSibling.style.display=\'\')">';
                html += '<span class="frm-vm-brand-box-name" style="display:none">' + esc(mk.adi) + '</span>';
            } else {
                html += '<div class="frm-vm-brand-box-icon">' + esc(mk.adi.charAt(0)) + '</div>';
                html += '<span class="frm-vm-brand-box-name">' + esc(mk.adi) + '</span>';
            }
            html += '</div>';

            // Brand body with model groups
            html += '<div class="frm-vm-brand-box-body">';
            for (var moi = 0; moi < mk.modelOrder.length; moi++) {
                var mod = mk.modeller[mk.modelOrder[moi]];
                var modelId = 'frmVmMb_' + markaOrder[mi] + '_' + mk.modelOrder[moi];

                html += '<div class="frm-vm-model-group">';

                // Model header — stok toplamını hesapla
                var modelStokToplam = 0;
                for (var si = 0; si < mod.renkler.length; si++) {
                    modelStokToplam += F.Helpers.getDepoStok(mod.renkler[si].depo_stoklar, mod.renkler[si].stok);
                }

                html += '<div class="frm-vm-model-header" data-target="' + modelId + '">';
                html += '<span class="frm-vm-model-pill" style="background:' + esc(mk.renk) + '">';
                html += '<i class="icon-smartphone" style="font-size:13px;color:#fff"></i>';
                html += '<span class="frm-vm-model-name">' + esc(mod.adi) + '</span>';
                html += '<span class="frm-vm-model-qty-badge" id="' + modelId + '_qty">' + modelStokToplam + '</span>';
                html += '</span></div>';

                // Divider + body
                html += '<hr class="frm-vm-model-divider">';
                html += '<div class="frm-vm-model-body" id="' + modelId + '">';
                html += '<div class="frm-vm-card-grid">';
                for (var ri = 0; ri < mod.renkler.length; ri++) {
                    html += colorCard(mod.renkler[ri], 'mr');
                }
                html += '</div></div></div>';
            }
            html += '</div></div>';
        }

        if (!html) html = '<div class="frm-vm-empty"><i class="icon-search"></i><span>Varyant bulunamadı</span></div>';
        gridEl.innerHTML = html;

        // Model collapse toggle
        gridEl.querySelectorAll('.frm-vm-model-header').forEach(function(hd) {
            hd.addEventListener('click', function() {
                var target = this.getAttribute('data-target');
                var body = document.getElementById(target);
                if (body) body.classList.toggle('collapsed');
            });
        });

        F.ModalVaryantInput.bindInputs(gridEl);
    };

    // toplamGuncelle modal-varyant-filter.js dosyasında tanımlı
    // sepeteEkle + getVaryantData → modal-varyant-submit.js dosyasına taşındı

})();
