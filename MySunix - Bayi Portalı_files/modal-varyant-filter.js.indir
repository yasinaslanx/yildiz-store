/**
 * Form - Varyant Modal Filtre: Marka, Arama, Stoksuz Toggle
 */
(function() {
    'use strict';

    var F = window.Form;
    F.ModalVaryant = F.ModalVaryant || {};

    // Filtre işlevleri renderGrid içinde uygulanır
    // Bu dosya ek filtre yardımcılarını içerir

    /**
     * Metin normalize (Türkçe karakter toleransı)
     */
    F.ModalVaryant.normalize = function(str) {
        if (!str) return '';
        return str.toLowerCase()
            .replace(/ı/g, 'i')
            .replace(/ğ/g, 'g')
            .replace(/ü/g, 'u')
            .replace(/ş/g, 's')
            .replace(/ö/g, 'o')
            .replace(/ç/g, 'c')
            .replace(/İ/g, 'i')
            .replace(/Ğ/g, 'g')
            .replace(/Ü/g, 'u')
            .replace(/Ş/g, 's')
            .replace(/Ö/g, 'o')
            .replace(/Ç/g, 'c');
    };

    /**
     * Filtre eşleşme kontrolü
     */
    F.ModalVaryant.eslesiyorMu = function(text, arama) {
        if (!arama) return true;
        return F.ModalVaryant.normalize(text).indexOf(F.ModalVaryant.normalize(arama)) !== -1;
    };

    /**
     * Toplam bilgilerini güncelle (header total pill + footer stats)
     */
    F.ModalVaryant.toplamGuncelle = function() {
        var topMiktar = F.ModalVaryant.toplamMiktar();
        var secili = F.ModalVaryant.seciliSayisi();
        var topTutar = F.ModalVaryant.toplamTutar();

        // Header total pill
        var totalEl = document.getElementById('frmVmTotal');
        if (totalEl) totalEl.textContent = topMiktar;

        // Footer stats
        var countEl = document.getElementById('frmVmSelCount');
        if (countEl) countEl.textContent = secili;

        var selTotalEl = document.getElementById('frmVmSelTotal');
        if (selTotalEl) selTotalEl.textContent = topMiktar;

        var tutarEl = document.getElementById('frmVmSelTutar');
        // Display currency'de hesapla (çift bankersRound hassasiyet kaybını önle)
        var dovizAktif = (F.Doviz && F.Doviz.aktif && F.Doviz.kur > 0);
        var displayTutar = dovizAktif
            ? F.Helpers.bankersRound(topTutar * F.Doviz.kur, 2)
            : topTutar;

        // İndirim gizle: brüt (orijinal) tutarı göster
        var brutTutar = F.ModalVaryant.brutToplamTutar();
        var brutDisplay = dovizAktif
            ? F.Helpers.bankersRound(brutTutar * F.Doviz.kur, 2)
            : brutTutar;
        if (tutarEl) tutarEl.textContent = F.Helpers.formatPara(F.Config.indirimGizle ? brutDisplay : displayTutar);

        // Brüt (kuralsız) toplam — fiyat kuralı varsa üstü çizili göster (indirimGizle ise gizle)
        var eskiEl = document.getElementById('frmVmSelTutarEski');
        if (eskiEl) {
            if (!F.Config.indirimGizle && F.ModalVaryant.ST.fiyatKurali && Math.abs(brutDisplay - displayTutar) > 0.001) {
                eskiEl.textContent = F.Helpers.formatPara(brutDisplay);
                eskiEl.style.display = '';
            } else {
                eskiEl.style.display = 'none';
            }
        }
    };

})();
