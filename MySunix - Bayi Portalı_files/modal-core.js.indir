/**
 * Form - Modal Overlay Açma/Kapama/Keyboard Yönetimi
 * 2 katman: Ana overlay (varyant/kilif/düz) + Detay overlay (ürün detay popup)
 */
(function() {
    'use strict';

    var F = window.Form;

    F.Modal = {};

    // Ana overlay
    var overlay, overlayBg, overlayContent, overlayClose;
    // Detay overlay (üst katman - diğer modalların üstünde açılır)
    var detayOverlay, detayOverlayBg, detayOverlayContent, detayOverlayClose;

    F.Modal.init = function() {
        // Ana overlay referansları
        overlay = document.getElementById('frmOverlay');
        overlayBg = document.getElementById('frmOverlayBg');
        overlayContent = document.getElementById('frmOverlayContent');
        overlayClose = document.getElementById('frmOverlayClose');

        // Detay overlay referansları
        detayOverlay = document.getElementById('frmOverlayDetail');
        detayOverlayBg = document.getElementById('frmOverlayDetailBg');
        detayOverlayContent = document.getElementById('frmOverlayDetailContent');
        detayOverlayClose = document.getElementById('frmOverlayDetailClose');

        if (!overlay) return;

        // --- Ana overlay event'leri ---
        // Overlay arka planına tıklama → kapatma devre dışı (hatalı tıklamayla veri kaybını önler)

        if (overlayClose) {
            overlayClose.addEventListener('click', function() {
                F.Modal.guvenliKapat();
            });
        }

        // --- Detay overlay event'leri ---
        if (detayOverlay) {
            // Detay overlay arka planına tıklama → kapatma devre dışı

            if (detayOverlayClose) {
                detayOverlayClose.addEventListener('click', function() {
                    F.Modal.kapatDetay();
                });
            }
        }

        // ESC ile kapanmada veri kaybını önle
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                if (detayOverlay && detayOverlay.classList.contains('frm-overlay-show')) {
                    F.Modal.kapatDetay();
                } else if (overlay.classList.contains('frm-overlay-show')) {
                    F.Modal.guvenliKapat();
                }
            }
        });

        // Modal açma event'i
        F.Events.on('modal:ac', function(data) {
            F.Modal.ac(data.tip, data.urunData, data.satirId);
        });

        // Modal kapama event'i
        F.Events.on('modal:kapat', function() {
            F.Modal.kapat();
        });
    };

    /**
     * Ana modal aç
     * @param {string} tip - duz|varyant|kilif
     * @param {object} urunData - Ürün verileri
     * @param {string|null} satirId - Düzenleme için satır ID
     */
    F.Modal.ac = function(tip, urunData, satirId) {
        if (!overlay || !overlayContent) return;

        overlayContent.innerHTML = '';

        switch (tip) {
            case 'duz':
                if (F.ModalDuz && F.ModalDuz.render) {
                    F.ModalDuz.render(overlayContent, urunData, satirId);
                }
                break;
            case 'varyant':
                if (F.ModalVaryant && F.ModalVaryant.render) {
                    F.ModalVaryant.render(overlayContent, urunData, satirId);
                }
                break;
            case 'kilif':
                if (F.ModalKilif && F.ModalKilif.render) {
                    F.ModalKilif.render(overlayContent, urunData, satirId);
                }
                break;
        }

        overlay.classList.add('frm-overlay-show');
        document.body.style.overflow = 'hidden';

        // Açılış durum imzası (kapatırken "değişiklik var mı" kontrolü için)
        F.Modal._aktifTip = tip;
        F.Modal._acilisImza = F.Modal._durumImzasi();
    };

    /**
     * Modal açılışından beri değişiklik oldu mu kontrolü için durum imzası üret.
     * Varyant modalı: state objesinden okunur (tab/filtre/arama değişiminden bağımsız).
     * Kılıf + Düz modal: DOM veri-input'larından okunur.
     */
    F.Modal._durumImzasi = function() {
        var tip = F.Modal._aktifTip;
        if (tip === 'varyant' && F.ModalVaryant && F.ModalVaryant.ST) {
            var st = F.ModalVaryant.ST;
            var keys = Object.keys(st.q || {}).sort();
            var parts = [];
            for (var i = 0; i < keys.length; i++) {
                var k = keys[i];
                var q = st.q[k] || 0;
                if (q <= 0) continue;
                var nv = (st.n && st.n[k] != null) ? st.n[k] : '';
                var nStr = (typeof nv === 'string') ? nv : ((nv.tr || '') + '~' + (nv.en || ''));
                parts.push(k + '=' + q
                    + ',' + ((st.p && st.p[k] !== undefined) ? st.p[k] : '')
                    + ',' + ((st.d && st.d[k] !== undefined) ? st.d[k] : '')
                    + ',' + ((st.mtl && st.mtl[k] != null) ? st.mtl[k] : '')
                    + ',' + nStr);
            }
            return 'V|' + parts.join('|');
        }
        if (!overlayContent) return '';
        var sec = '.frm-km-qi[data-c], #frmMdQty, #frmMdFiyat, #frmMdDepo, #frmMdNot, input[name="frmMdSevkTipi"]:checked';
        var inputs = overlayContent.querySelectorAll(sec);
        var dparts = [];
        for (var j = 0; j < inputs.length; j++) {
            dparts.push((inputs[j].value || '').trim());
        }
        return (tip || '') + '|' + dparts.join('|');
    };

    /**
     * Güvenli kapanma — açılıştan beri değişiklik varsa onay sor
     */
    F.Modal.guvenliKapat = function() {
        // Modal açılışından beri gerçek bir değişiklik yoksa onaysız kapat
        if (F.Modal._durumImzasi() === F.Modal._acilisImza) {
            F.Modal.kapat();
            return;
        }
        if (typeof Swal !== 'undefined') {
            Swal.fire({
                title: 'Girişler kaybolacak',
                text: 'Modalı kapatmak istediğinize emin misiniz?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Evet, Kapat',
                cancelButtonText: 'Vazgeç',
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#6b7280'
            }).then(function(result) {
                if (result.isConfirmed) F.Modal.kapat();
            });
        } else {
            if (confirm('Girişler kaybolacak. Modalı kapatmak istediğinize emin misiniz?')) {
                F.Modal.kapat();
            }
        }
    };

    /**
     * Ana modal kapat
     */
    F.Modal.kapat = function() {
        if (!overlay) return;
        overlay.classList.remove('frm-overlay-show');
        document.body.style.overflow = '';
        overlayContent.innerHTML = '';

        // Ön talep flag sıfırla
        F.State.onTalepAktif = false;
        F.State.onTalepEditData = null;

        // Ürün ekleme sonrası arama inputuna otomatik focus
        setTimeout(function() {
            var aramaInput = document.getElementById('frmUrunArama');
            if (aramaInput && !aramaInput.readOnly) aramaInput.focus({preventScroll: true});
        }, 100);
    };

    /**
     * Detay modalı aç (ürün detay - her yerden erişilebilir)
     * Diğer modalların üstünde açılır, kapatılınca alttaki modal korunur.
     * @param {object} urunData - Ürün verileri
     * @param {object|null} varyantInfo - Varyant bilgisi (tip, adi, stok, renkKodu vb.)
     */
    F.Modal.acDetay = function(urunData, varyantInfo) {
        if (!detayOverlay || !detayOverlayContent) return;
        if (!F.ModalDuz || !F.ModalDuz.render) return;

        detayOverlayContent.innerHTML = '';
        F.ModalDuz.render(detayOverlayContent, urunData, null, varyantInfo);

        detayOverlay.classList.add('frm-overlay-show');
        document.body.style.overflow = 'hidden';
    };

    /**
     * Detay modalı kapat (alttaki modal korunur)
     */
    F.Modal.kapatDetay = function() {
        if (!detayOverlay) return;
        detayOverlay.classList.remove('frm-overlay-show');
        detayOverlayContent.innerHTML = '';

        // Altta ana overlay hala açıksa body overflow geri yükleme
        if (!overlay || !overlay.classList.contains('frm-overlay-show')) {
            document.body.style.overflow = '';
        }
    };

})();
