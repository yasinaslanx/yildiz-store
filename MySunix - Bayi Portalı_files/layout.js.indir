/**
 * Form - Sağ Panel Sticky Scroll
 */
(function() {
    'use strict';

    var F = window.Form;

    F.Layout = {};

    F.Layout.init = function() {
        var panel = document.getElementById('frmPanel');
        if (!panel) return;

        var stickyOffset = 80; // header yüksekliği

        function updateSticky() {
            var scrollTop = window.pageYOffset || document.documentElement.scrollTop;
            var parentRect = panel.parentElement.getBoundingClientRect();

            if (window.innerWidth > 1100) {
                if (parentRect.top < stickyOffset) {
                    panel.style.position = 'sticky';
                    panel.style.top = stickyOffset + 'px';
                } else {
                    panel.style.position = '';
                    panel.style.top = '';
                }
            } else {
                panel.style.position = '';
                panel.style.top = '';
            }
        }

        var ticking = false;
        window.addEventListener('scroll', function() {
            if (!ticking) {
                requestAnimationFrame(function() {
                    updateSticky();
                    ticking = false;
                });
                ticking = true;
            }
        });

        window.addEventListener('resize', updateSticky);
        updateSticky();
    };

})();
