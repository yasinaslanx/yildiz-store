/**
 * Form - Yardımcı Fonksiyonlar
 * bankersRound, formatPara, escHtml, vb.
 */
(function() {
    'use strict';

    var F = window.Form;

    F.Helpers = {};

    /**
     * Banker's Rounding (0.5'te çift sayıya yuvarlar)
     */
    F.Helpers.bankersRound = function(num, decimals) {
        var d = decimals || 0;
        var m = Math.pow(10, d);
        var n = num * m;
        var i = Math.floor(n);
        var f = n - i;
        if (Math.abs(f - 0.5) < 0.0000001) {
            return (i % 2 === 0 ? i : i + 1) / m;
        }
        return Math.round(n) / m;
    };

    /**
     * Para formatla ($1,234.56)
     */
    F.Helpers.formatPara = function(tutar, sembol) {
        if (typeof tutar !== 'number' || isNaN(tutar)) tutar = 0;
        sembol = sembol || F.Config.paraSembolu;
        var neg = tutar < 0;
        tutar = F.Helpers.bankersRound(Math.abs(tutar), 2);
        var parts = tutar.toFixed(2).split('.');
        parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        return (neg ? '-' : '') + sembol + parts[0] + '.' + parts[1];
    };

    /**
     * Sayı formatla (binlik ayırıcı)
     */
    F.Helpers.formatSayi = function(sayi) {
        if (typeof sayi !== 'number' || isNaN(sayi)) return '0';
        return sayi.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    };

    /**
     * HTML escape
     */
    F.Helpers.escHtml = function(str) {
        if (!str) return '';
        var div = document.createElement('div');
        div.appendChild(document.createTextNode(str));
        return div.innerHTML;
    };

    /**
     * Fiyat kuralını bir fiyata uygula (Banker's Rounding ile)
     * @param {number} fiyat - Orijinal fiyat
     * @param {object} kural - {deger, deger_tipi, islem_tipi}
     * @returns {number} Hesaplanmış fiyat
     *
     * deger_tipi:
     *   'yuzde' → birim fiyata % indirim/zam uygulanır (islem_tipi yönü belirler)
     *   'birim' → SABİT FİYAT: ürünün nihai fiyatı doğrudan girilen değerdir
     *             (indirim/zam yönü YOK SAYILIR — sabit fiyat = tek başına fiyat)
     */
    F.Helpers.fiyatKuraliUygula = function(fiyat, kural) {
        // Fiyatsız/0 satır veya varyant kural ALMAZ (satılamaz) — backend'in
        // "birimFiyat>0 iken kural" ilkesi ve yüzde davranışı ile birebir tutarlı.
        if (!kural || !fiyat) return fiyat || 0;
        // Sabit fiyat (birim): baz fiyattan bağımsız, doğrudan override
        if (kural.deger_tipi !== 'yuzde') {
            return Math.max(0, F.Helpers.bankersRound(kural.deger, 2));
        }
        var fark = F.Helpers.bankersRound(fiyat * kural.deger / 100, 2);
        var sonuc = (kural.islem_tipi === 'zam')
            ? F.Helpers.bankersRound(fiyat + fark, 2)
            : F.Helpers.bankersRound(fiyat - fark, 2);
        return Math.max(0, sonuc);
    };

    /**
     * Para formatla - sembolsüz (1,234.56)
     */
    F.Helpers.formatParaSayi = function(tutar) {
        return F.Helpers.bankersRound(Number(tutar || 0), 2).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    };

    /**
     * Arka plan rengine göre metin rengi belirle (kontrast)
     */
    F.Helpers.getTextColor = function(hex) {
        if (!hex || hex.length < 4) return '#fff';
        hex = hex.replace('#', '');
        if (hex.length === 3) hex = hex[0]+hex[0]+hex[1]+hex[1]+hex[2]+hex[2];
        var r = parseInt(hex.substr(0,2),16), g = parseInt(hex.substr(2,2),16), b = parseInt(hex.substr(4,2),16);
        var lum = (0.299*r + 0.587*g + 0.114*b) / 255;
        return lum > 0.6 ? '#1a1d23' : '#fff';
    };

    /**
     * Arka plan rengine göre metin gölgesi
     */
    F.Helpers.getTextShadow = function(hex) {
        var c = F.Helpers.getTextColor(hex);
        return c === '#fff' ? '0 1px 2px rgba(0,0,0,.3)' : '0 1px 2px rgba(255,255,255,.3)';
    };

    /**
     * Debounce
     */
    F.Helpers.debounce = function(fn, delay) {
        var timer = null;
        return function() {
            var args = arguments;
            var ctx = this;
            clearTimeout(timer);
            timer = setTimeout(function() {
                fn.apply(ctx, args);
            }, delay);
        };
    };

    /**
     * AJAX POST helper
     */
    F.Helpers.ajaxPost = function(url, data, onSuccess, onError) {
        $.ajax({
            url: F.Config.ajaxBase + url,
            type: 'POST',
            data: data,
            dataType: 'json',
            success: function(res) {
                if (onSuccess) onSuccess(res);
            },
            error: function(xhr, status, err) {
                console.error('[Form.AJAX] Hata:', url, err);
                if (onError) onError(err);
            }
        });
    };

    /**
     * AJAX GET helper
     */
    F.Helpers.ajaxGet = function(url, data, onSuccess, onError) {
        $.ajax({
            url: F.Config.ajaxBase + url,
            type: 'GET',
            data: data,
            dataType: 'json',
            success: function(res) {
                if (onSuccess) onSuccess(res);
            },
            error: function(xhr, status, err) {
                console.error('[Form.AJAX] Hata:', url, err);
                if (onError) onError(err);
            }
        });
    };

    /**
     * Depo kırılım tooltip HTML'i oluştur
     */
    F.Helpers.depoTooltipHtml = function(depoStoklar) {
        if (!depoStoklar || !depoStoklar.length) return '';
        var h = '<div class="frm-stk-tt">';
        for (var i = 0; i < depoStoklar.length; i++) {
            var ds = depoStoklar[i];
            h += '<div class="frm-stk-tt-r"><span class="frm-stk-tt-l">' +
                 F.Helpers.escHtml(ds.depo_adi) + '</span><span class="frm-stk-tt-v">' +
                 (parseInt(ds.miktar) || 0) + '</span></div>';
        }
        h += '</div>';
        return h;
    };

    /**
     * Depo önizleme: seçili depoya göre stok miktarını döndür
     */
    F.Helpers.getDepoStok = function(depoStoklar, toplamStok) {
        var depoId = F.State.depoOnizleme;
        if (!depoId || depoId === 'tumu') return parseInt(toplamStok) || 0;
        if (!depoStoklar || !depoStoklar.length) return 0;
        // depo_id ile eşleştir
        for (var i = 0; i < depoStoklar.length; i++) {
            if (depoStoklar[i].depo_id != null && depoStoklar[i].depo_id == depoId) return parseInt(depoStoklar[i].miktar) || 0;
        }
        // Fallback: depo_adi ile eşleştir
        var depolar = F.Config.depolar || [];
        var depoAdi = '';
        for (var d = 0; d < depolar.length; d++) {
            if (depolar[d].id == depoId) { depoAdi = depolar[d].adi; break; }
        }
        if (depoAdi) {
            for (var j = 0; j < depoStoklar.length; j++) {
                if (depoStoklar[j].depo_adi === depoAdi) return parseInt(depoStoklar[j].miktar) || 0;
            }
        }
        return 0;
    };

    /**
     * Depo önizleme: stok label'ı (depo adı veya "STOK")
     */
    F.Helpers.getDepoLabel = function() {
        var depoId = F.State.depoOnizleme;
        if (!depoId || depoId === 'tumu') return 'STOK';
        var depolar = F.Config.depolar || [];
        for (var i = 0; i < depolar.length; i++) {
            if (depolar[i].id == depoId) return depolar[i].adi;
        }
        return 'STOK';
    };

    /**
     * Depo önizleme select HTML'i oluştur
     */
    F.Helpers.depoOnizlemeSelectHtml = function() {
        if (F.State.isIade || F.Config.isOnSiparis || F.State.onTalepAktif || F.Config.isCinSiparis) return '';
        var depolar = F.Config.depolar || [];
        var secili = F.State.depoOnizleme || F.Config.varsayilanDepoId;
        var h = '<div class="frm-depo-oz-wrap">';
        h += '<label class="frm-depo-oz-label">Depo Önizleme</label>';
        h += '<select class="frm-depo-oz-select" id="frmDepoOzSelect">';
        h += '<option value="tumu"' + (secili === 'tumu' ? ' selected' : '') + '>Tüm Depolar</option>';
        for (var i = 0; i < depolar.length; i++) {
            var d = depolar[i];
            if (d.su != null && !d.su) continue;
            h += '<option value="' + d.id + '"' + (d.id == secili ? ' selected' : '') + '>' + F.Helpers.escHtml(d.adi) + '</option>';
        }
        h += '</select></div>';
        return h;
    };

    /**
     * Koli/Paket bilgisini okunabilir metne çevir.
     * Ana ERP "Koli & Paket" sayfasından (index.php?sayfa=koli-paket) girilen veriyi gösterir.
     *   koli_ici_paket_adet (P) : 1 kolide kaç paket
     *   paket_ici_urun_adet (U) : 1 pakette kaç ürün (opsiyonel)
     *   koli_tipi               : 'koli_paket' (Koli›Paket) | 'koli_paket_urun' (Koli›Paket›Ürün)
     * @returns {{kisa:string, tam:string}|null} Veri yoksa null.
     */
    F.Helpers.koliBilgi = function(u) {
        if (!u) return null;
        var p = parseInt(u.koli_ici_paket_adet, 10) || 0;
        var ur = parseInt(u.paket_ici_urun_adet, 10) || 0;
        var tip = u.koli_tipi || '';
        if (p <= 0 && ur <= 0) return null;
        function fnum(n) { return Number(n || 0).toLocaleString('tr-TR'); }

        // Koli › Paket › Ürün — hem koli içi paket hem paket içi ürün adedi tanımlı (çarpan YOK)
        if (tip === 'koli_paket_urun' && p > 0 && ur > 0) {
            return {
                kisa: 'Kolide ' + fnum(p) + ' paket',
                tam: 'Koli Adet : ' + fnum(p) + ' / Paket Adet : ' + fnum(ur)
            };
        }
        // Sadece koli içi paket adedi tanımlı (Koli › Paket)
        if (p > 0) {
            return {
                kisa: 'Kolide ' + fnum(p) + ' paket',
                tam: 'Koli Adet : ' + fnum(p)
            };
        }
        return null;
    };

    /**
     * Stok tooltip event delegation başlat (container içindeki .frm-stk-tt-wrap elemanları için)
     */
    F.Helpers.stokTooltipInit = function(container) {
        $(container).off('mouseenter mouseleave', '.frm-stk-tt-wrap');
        $(container).on('mouseenter', '.frm-stk-tt-wrap', function() {
            var tt = $(this).children('.frm-stk-tt');
            if (!tt.length) return;
            var r = this.getBoundingClientRect();
            var w = tt.outerWidth() || 140;
            var l = r.left + (r.width / 2) - (w / 2);
            var t = r.top - tt.outerHeight() - 8;
            if (l < 10) l = 10;
            if (l + w > window.innerWidth - 10) l = window.innerWidth - w - 10;
            if (t < 10) t = r.bottom + 8;
            tt.css({ left: l + 'px', top: t + 'px' }).addClass('frm-stk-tt-visible');
        }).on('mouseleave', '.frm-stk-tt-wrap', function() {
            $(this).children('.frm-stk-tt').removeClass('frm-stk-tt-visible');
        });
    };

    /**
     * Koli bilgisi için sistem (custom) tooltip.
     * [data-koli-tip] attribute'u olan herhangi bir elemanda hover/focus'ta
     * body seviyesinde floating bir kutu gösterir (kart overflow:hidden'ı aşar).
     * document'e tek sefer delegation bağlar — dinamik kartlarda da çalışır.
     */
    F.Helpers.koliTooltipInit = function() {
        if (F.Helpers._koliTtBound) return;
        F.Helpers._koliTtBound = true;

        var el = null;
        function tt() {
            if (!el) {
                el = document.createElement('div');
                el.className = 'frm-koli-tt';
                document.body.appendChild(el);
            }
            return el;
        }
        function goster(target) {
            var metin = target.getAttribute('data-koli-tip');
            if (!metin) return;
            var t = tt();
            t.textContent = metin;
            t.classList.add('frm-koli-tt-visible');
            var r = target.getBoundingClientRect();
            var w = t.offsetWidth, h = t.offsetHeight;
            var left = r.left + (r.width / 2) - (w / 2);
            var top = r.top - h - 8;
            if (left < 8) left = 8;
            if (left + w > window.innerWidth - 8) left = window.innerWidth - w - 8;
            if (top < 8) top = r.bottom + 8; // üstte yer yoksa altta göster
            t.style.left = left + 'px';
            t.style.top = top + 'px';
        }
        function gizle() {
            if (el) el.classList.remove('frm-koli-tt-visible');
        }

        $(document)
            .on('mouseenter', '[data-koli-tip]', function() { goster(this); })
            .on('mouseleave', '[data-koli-tip]', gizle)
            .on('focusin', '[data-koli-tip]', function() { goster(this); })
            .on('focusout', '[data-koli-tip]', gizle);
        // Scroll/resize'da gizle (konum kaymasın)
        window.addEventListener('scroll', gizle, true);
        window.addEventListener('resize', gizle);
    };

    // DOM hazır olunca koli tooltip delegation'ını bağla
    $(function() { F.Helpers.koliTooltipInit(); });

})();
