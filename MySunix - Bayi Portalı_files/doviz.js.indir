/**
 * Form - Döviz Dönüşüm Modülü
 * TL müşteri seçildiğinde USD→TL dönüşümü sağlar.
 * State her zaman USD tutar, dönüşüm display ve save katmanında uygulanır.
 */
(function() {
    'use strict';

    var F = window.Form;

    F.Doviz = {
        aktif: false,       // TL modu aktif mi?
        kur: 0,             // USD/TRY kuru (örn: 44.18)
        _yuklemeModuAtla: false  // Yükleme sırasında otomatik aktifleşmeyi atla
    };

    /**
     * Init - Event listener'lar bağla
     */
    F.Doviz.init = function() {
        if (F.Config.isOnSiparis || F.Config.isSevkiyat) return;

        // Müşteri seçildiğinde para birimini kontrol et
        F.Events.on('musteri:secildi', function(data) {
            // Yükleme modu: yukle.js kendi yönetecek
            if (F.Doviz._yuklemeModuAtla) return;

            if (data && (data.paraBirimi === 'TRY' || data.paraBirimi === 'TL')) {
                F.Doviz.aktifEt();
            } else {
                F.Doviz.deaktifEt();
            }
        });

        // Müşteri temizlendiğinde USD'ye dön
        F.Events.on('musteri:temizlendi', function() {
            F.Doviz.deaktifEt();
        });

        // Kur input event binding
        var kurInp = document.getElementById('frmDvKurInput');
        if (kurInp) {
            kurInp.addEventListener('change', function() {
                var yeniKur = parseFloat(this.value) || 0;
                if (yeniKur > 0) {
                    F.Doviz.kurGuncelle(yeniKur);
                }
            });
            kurInp.addEventListener('keydown', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    this.blur();
                }
            });
        }
    };

    /**
     * TL modunu aktifle
     * @param {number} kur - Opsiyonel kur değeri. Yoksa otomatik yüklenir.
     */
    F.Doviz.aktifEt = function(kur) {
        F.Doviz.aktif = true;

        if (kur && kur > 0) {
            F.Doviz.kur = kur;
            F.Doviz._modUygula();
        } else {
            // Kur yükle
            F.Doviz.kurYukle(function(yuklenenKur) {
                F.Doviz.kur = yuklenenKur;
                F.Doviz._modUygula();
            });
        }
    };

    /**
     * USD moduna geri dön
     */
    F.Doviz.deaktifEt = function() {
        if (!F.Doviz.aktif) return;

        F.Doviz.aktif = false;
        F.Doviz.kur = 0;
        F.Config.paraSembolu = '$';
        F.State.paraBirimi = 'USD';
        F.State.dovizKuru = 0;

        F.Doviz.panelGizle();
        F.Tablo.tumSatirlariYenidenCiz();
        F.Events.emit('hesaplama:guncelle');
    };

    /**
     * Mod uygula (aktifEt sonrası)
     */
    F.Doviz._modUygula = function() {
        F.Config.paraSembolu = '₺';
        F.State.paraBirimi = 'TRY';
        F.State.dovizKuru = F.Doviz.kur;

        F.Doviz.panelGoster();
        F.Doviz.panelKurGuncelle();
        F.Tablo.tumSatirlariYenidenCiz();
        F.Events.emit('hesaplama:guncelle');
    };

    /**
     * Kur yükle
     * Öncelik: 1) window.DovizKurlari, 2) AJAX, 3) Manuel giriş
     */
    F.Doviz.kurYukle = function(cb) {
        // 1) Header widget'tan al
        if (window.DovizKurlari && typeof window.DovizKurlari.getRate === 'function') {
            var rate = window.DovizKurlari.getRate('USD');
            if (rate && rate > 0) {
                if (cb) cb(rate);
                return;
            }
        }

        // 2) AJAX ile al (endpoint ana ERP formatında 'data' döndürür)
        $.ajax({
            url: 'ajax/doviz-kur.php',
            type: 'GET',
            dataType: 'json',
            success: function(res) {
                if (res && res.success && res.data && res.data.USD) {
                    var rate = parseFloat(res.data.USD.satis) || 0;
                    if (rate > 0) {
                        if (cb) cb(rate);
                        return;
                    }
                }
                // Kur alınamadı - 0 döndür, kullanıcı manuel girecek
                if (cb) cb(0);
            },
            error: function() {
                if (cb) cb(0);
            }
        });
    };

    /**
     * Manuel kur değişikliği
     */
    F.Doviz.kurGuncelle = function(yeniKur) {
        F.Doviz.kur = yeniKur;
        F.State.dovizKuru = yeniKur;

        // Manuel TL satırlar: TL fiyat sabit kalır, USD yeniden hesaplanır
        for (var i = 0; i < F.State.satirlar.length; i++) {
            var s = F.State.satirlar[i];
            if (s.manuelTlFiyat != null) {
                s.birimFiyat = F.Helpers.bankersRound(s.manuelTlFiyat / yeniKur, 6);
                s.normalBirimFiyat = s.birimFiyat;
            }
            if (s.varyantlar) {
                for (var j = 0; j < s.varyantlar.length; j++) {
                    var v = s.varyantlar[j];
                    if (v.manuelTlFiyat != null) {
                        v.birimFiyat = F.Helpers.bankersRound(v.manuelTlFiyat / yeniKur, 6);
                        v.normalBirimFiyat = v.birimFiyat;
                    }
                }
            }
        }

        // Tüm fiyatları yeniden hesapla
        F.Tablo.tumSatirlariYenidenCiz();
        F.Events.emit('hesaplama:guncelle');
        F.Events.emit('doviz:kurDegisti');
    };

    /**
     * USD tutarı TL'ye dönüştür (Banker's Rounding ile)
     */
    F.Doviz.usdToTl = function(amount) {
        if (!F.Doviz.kur || F.Doviz.kur <= 0) return amount;
        return F.Helpers.bankersRound(amount * F.Doviz.kur, 2);
    };

    /**
     * Dönüşüm fonksiyonu: aktifse TL'ye çevir, değilse olduğu gibi döndür
     */
    F.Doviz.conv = function(amount) {
        if (F.Doviz.aktif) {
            return F.Doviz.usdToTl(amount);
        }
        return amount;
    };

    /**
     * TL tutarı USD'ye dönüştür (ara hesaplama hassasiyeti için 6 ondalık)
     * Not: usdToTl gösterimde 2 ondalık kullanır, tlToUsd ara değer olduğu için
     * 6 ondalık ile TL→USD→TL round-trip hassasiyeti korunur.
     */
    F.Doviz.tlToUsd = function(amount) {
        if (!F.Doviz.kur || F.Doviz.kur <= 0) return amount;
        return F.Helpers.bankersRound(amount / F.Doviz.kur, 6);
    };

    /**
     * Display currency'den base currency'ye (USD) dönüştür
     * Aktifse TL→USD, değilse olduğu gibi döndür
     */
    F.Doviz.toBase = function(amount) {
        if (F.Doviz.aktif) return F.Doviz.tlToUsd(amount);
        return amount;
    };

    /**
     * Aktif para birimi sembolünü döndür
     */
    F.Doviz.aktifSembol = function() {
        return F.Doviz.aktif ? '₺' : '$';
    };

    /**
     * Panel göster
     */
    F.Doviz.panelGoster = function() {
        var panel = document.getElementById('frmDvPanel');
        if (panel) panel.style.display = '';

        // Readonly modda input'u disable et
        if (F.Config.readonly) {
            var inp = document.getElementById('frmDvKurInput');
            if (inp) inp.disabled = true;
        }
    };

    /**
     * Panel gizle
     */
    F.Doviz.panelGizle = function() {
        var panel = document.getElementById('frmDvPanel');
        if (panel) panel.style.display = 'none';
    };

    /**
     * Panel kur değerini güncelle
     */
    F.Doviz.panelKurGuncelle = function() {
        var inp = document.getElementById('frmDvKurInput');
        if (inp) {
            inp.value = F.Doviz.kur > 0 ? F.Doviz.kur.toFixed(4) : '';
        }

        // Kaynak badge (görüntüleme/düzenleme modunda gizle)
        var kaynak = document.getElementById('frmDvKaynak');
        if (kaynak) {
            if (F.Config.readonly || F.Config.mod === 'siparis-duzenle') {
                kaynak.style.display = 'none';
            } else if (window.DovizKurlari && window.DovizKurlari.lastUpdate) {
                kaynak.textContent = 'HaremAltın';
            } else if (F.Doviz.kur > 0) {
                kaynak.textContent = 'Güncel Kur';
            } else {
                kaynak.textContent = 'Manuel Giriş';
            }
        }
    };

})();
