/**
 * Merkez Fiyat Değişim — Header çan badge + Mağazam giriş modalı
 * Sadece Mağazam erişimi olan bayilerde çalışır. 60sn polling + oturum başına 1 kez modal.
 */
(function () {
    if (typeof window.bayiMagazamErisim !== 'undefined' && !window.bayiMagazamErisim) return;

    function el(id) { return document.getElementById(id); }

    function guncelleBadge(sayi) {
        var wrap = el('bpHwFiyatNotif'), cnt = el('mfdNotifCount');
        if (!wrap) return;
        if (sayi > 0) { wrap.style.display = ''; if (cnt) cnt.textContent = sayi > 99 ? '99+' : sayi; }
        else { wrap.style.display = 'none'; }
    }

    function fp(s) { return parseFloat(s || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
    function esc(s) {
        if (s == null) return '';
        return String(s).replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }
    function resim(u) {
        if (!u) return '';
        if (typeof resimUrl === 'function') return resimUrl(u);
        if (/^https?:\/\//i.test(u)) return u;
        var p = String(u).replace(/^\/+/, '');
        if (p.indexOf('uploads/') === 0 || p.indexOf('upload/') === 0) return p; // same-origin (bayi/.htaccess)
        return 'https://sunixhub.com/' + p;
    }

    // Bir kalemin fiyat chip'leri. Eski merkez referansı 0 ise: bu "değişim" değil ilk
    // fiyatlandırmadır → "Yeni" + satış fiyatı (eski→yeni oku gösterilmez).
    function fiyatChips(b) {
        var eski = parseFloat(b.eski_merkez_fiyat) || 0;
        var yeni = fp(b.yeni_merkez_fiyat);
        if (eski < 0.0001) {
            return '<div class="gp-chips">'
                + '<span class="gp-chip gp-chip--yeni-rozet">Yeni</span>'
                + '<span class="gp-chip gp-chip--satis">$' + yeni + '</span>'
                + '</div>';
        }
        return '<div class="gp-chips">'
            + '<span class="gp-chip gp-chip--fy-eski">$' + fp(eski) + '</span>'
            + '<span class="gp-fy-ok">→</span>'
            + '<span class="gp-chip gp-chip--fy-yeni">$' + yeni + '</span>'
            + '</div>';
    }

    // Günde 1 kez gösterim takibi (kalıcı). sessionStorage oturum/tab kapanınca
    // sıfırlandığı için modal tekrar tekrar geliyordu → localStorage + bugünün tarihi
    // ile bayi bazında günde tek gösterim. Kullanıcı "Kapat"a basınca da o gün
    // bir daha açılmaz (badge/çan görünmeye devam eder, sadece popup susar).
    function mfdGunBugun() {
        var d = new Date();
        return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2);
    }
    function mfdModalKey() {
        var bid = window.bayiAktifId || '';
        return 'mfd_modal_gun_' + bid;
    }
    function mfdModalBugunGosterildi() {
        try { return localStorage.getItem(mfdModalKey()) === mfdGunBugun(); } catch (e) { return false; }
    }
    function mfdModalBugunIsaretle() {
        try { localStorage.setItem(mfdModalKey(), mfdGunBugun()); } catch (e) {}
    }

    function modalBelki(sayi, onizleme) {
        if (sayi <= 0) return;
        if (typeof Swal === 'undefined') return;
        if (mfdModalBugunGosterildi()) return;

        var oniz = onizleme || [];
        var liste = oniz.slice(0, 4).map(function (b) {
            var ad = esc(b.urun_adi) + (b.varyant_adi ? ' · ' + esc(b.varyant_adi) : '');
            var img = resim(b.resim_url);
            var imgHtml = img
                ? '<img src="' + esc(img) + '" alt="" onerror="this.style.display=\'none\';var ic=this.parentNode.querySelector(\'i\');if(ic)ic.style.display=\'\'">'
                : '';
            var iconHtml = '<i class="icon-trending-up"' + (img ? ' style="display:none"' : '') + '></i>';
            return '<div class="gp-item">'
                + '<div class="gp-item-img">' + iconHtml + imgHtml + '</div>'
                + '<div class="gp-item-body">'
                + '<div class="gp-item-ad">' + ad + '</div>'
                + fiyatChips(b)
                + '</div></div>';
        }).join('');

        var kalan = sayi - oniz.length;
        var fazla = kalan > 0 ? '<div class="gp-fazla">+ ' + kalan + ' ürün daha</div>' : '';

        Swal.fire({
            html: '<div class="gp-head gp-head--fiyat">'
                    + '<div class="gp-head-ic"><i class="icon-trending-up"></i></div>'
                    + '<div class="gp-head-tx">'
                        + '<div class="gp-head-title">' + sayi + ' Üründe Merkez Fiyatı Değişti</div>'
                    + '</div>'
                + '</div>'
                + '<div class="gp-liste">' + liste + fazla + '</div>',
            showCancelButton: true,
            confirmButtonText: 'İncele ve Güncelle',
            cancelButtonText: 'Kapat',
            reverseButtons: true,
            buttonsStyling: false,
            width: 480,
            customClass: {
                popup: 'gp-popup gp-popup--fiyat',
                actions: 'gp-actions',
                confirmButton: 'gp-btn gp-btn--primary',
                cancelButton: 'gp-btn gp-btn--ghost'
            }
        }).then(function (res) {
            if (res.isConfirmed) window.location.href = 'index.php?sayfa=merkez-fiyat-degisim';
        });

        mfdModalBugunIsaretle();
        // "Okundu" işaretle (durum bekliyor kalır, badge düşmez)
        fetch('ajax/merkez-fiyat-degisim/okundu.php', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } }).catch(function () {});
    }

    function tazele() {
        fetch('ajax/merkez-fiyat-degisim/sayi.php', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.json(); })
            .then(function (res) {
                if (!res || !res.success) return;
                var sayi = res.sayi || 0;
                guncelleBadge(sayi);
                modalBelki(sayi, res.onizleme || []);
            }).catch(function () {});
    }
    window.mfdBadgeTazele = tazele;

    document.addEventListener('DOMContentLoaded', function () {
        tazele();
        setInterval(tazele, 60000);
    });
})();
