/**
 * Form - Kategori Bazlı Tablo Gruplama
 * Satırları kategori adına göre sıralar ve grup başlıkları ekler.
 */
(function() {
    'use strict';

    var F = window.Form;

    F.Gruplama = {};

    F.Gruplama.init = function() {
        F.Events.on('siparis:yuklendi', function() {
            F.Gruplama.uygula();
        });
    };

    /**
     * State.satirlar dizisini kategoriAdi'na göre Türkçe alfabetik sırala
     */
    F.Gruplama.sirala = function() {
        F.State.satirlar.sort(function(a, b) {
            var katA = (a.kategoriAdi || 'Diğer').toLowerCase();
            var katB = (b.kategoriAdi || 'Diğer').toLowerCase();
            return katA.localeCompare(katB, 'tr');
        });
    };

    /**
     * Render sırası (tek nokta) — uygula + tumSatirlariYenidenCiz ortak kullanır.
     * Barkod modu açıksa recency'ye göre (son dokunulan kategori en üste); değilse
     * State.satirlar (kategori-alfabetik). State'i MUTASYONA UĞRATMAZ → görsel-only.
     * F.BarkodMod yalnız Mağazam form.php'de yüklenir; tedarik/iade'de tanımsız → normal sıra.
     */
    F.Gruplama.renderSirasi = function(satirlar) {
        if (F.BarkodMod && F.BarkodMod.aktif() && F.BarkodMod.sirali) {
            return F.BarkodMod.sirali(satirlar);
        }
        return satirlar;
    };

    /**
     * Gruplama uygula — state sırala + DOM yeniden çiz (hesaplama yapmaz)
     */
    F.Gruplama.uygula = function() {
        var tbody = document.getElementById('frmTbody');
        if (!tbody) return;
        if (F.State.satirlar.length === 0) {
            F.Tablo.bosKontrol();
            return;
        }

        F.Gruplama.sirala();

        // Görüntü sırası tek noktadan (barkod modunda son dokunulan kategori en üste).
        var renderSatirlar = F.Gruplama.renderSirasi(F.State.satirlar);

        tbody.innerHTML = '';

        var sonKategori = null;
        var colSpan = F.Gruplama._colSpan();

        for (var i = 0; i < renderSatirlar.length; i++) {
            var s = renderSatirlar[i];
            var katAdi = s.kategoriAdi || 'Diğer';

            if (katAdi !== sonKategori) {
                var katSayisi = F.Gruplama._kategoriSayisi(katAdi);
                tbody.insertAdjacentHTML('beforeend', F.Gruplama.baslikHtml(s.kategoriId, katAdi, katSayisi, colSpan));
                sonKategori = katAdi;
            }

            var html = F.Tablo.satirHtml(s);
            if (s.ffSatirlar && s.ffSatirlar.length > 0) {
                html += F.Tablo.ffSatirlarHtml(s);
            }
            tbody.insertAdjacentHTML('beforeend', html);
        }

        F.Tablo.numaralariGuncelle();
        F.Tablo.toplamMiktarGuncelle();
    };

    /**
     * Kategori başlık satırı HTML'i (ürün listesi referans stili)
     */
    F.Gruplama.baslikHtml = function(katId, katAdi, sayi, colSpan) {
        var esc = F.Helpers.escHtml;
        return '<tr class="frm-kat-baslik" data-kategori-id="' + katId + '">' +
            '<td colspan="' + colSpan + '">' +
            '<div class="frm-kat-icerik">' +
            '<i class="icon-grid"></i>' +
            '<span class="frm-kat-adi">' + esc(katAdi) + '</span>' +
            '<span class="frm-kat-sayi">' + sayi + '</span>' +
            '</div></td></tr>';
    };

    /**
     * Belirli kategori adına sahip satır sayısını hesapla
     */
    F.Gruplama._kategoriSayisi = function(katAdi) {
        var sayi = 0;
        for (var i = 0; i < F.State.satirlar.length; i++) {
            if ((F.State.satirlar[i].kategoriAdi || 'Diğer') === katAdi) sayi++;
        }
        return sayi;
    };

    /**
     * Tablo colspan hesapla (moda göre)
     */
    F.Gruplama._colSpan = function() {
        if (F.Config.isCinSiparis) {
            return F.State.readonly ? 3 : 4;
        } else if (F.Config.isOnSiparis || F.Config.isSevkiyat) {
            return F.State.readonly ? 2 : 3;
        } else {
            return F.State.readonly ? 5 : 6;
        }
    };

})();
