/**
 * Form - İade Ek Alanları (kategori, kargo, hedef depo)
 * Sipariş modunda no-op.
 *
 * Hedef depo KATEGORİYE göre değişir:
 *   - Ürün İade (normal)  → satışa uygun (mağaza) depolar → ürün tekrar satılabilir
 *   - Arızalı İade (arizali) → arıza (servis) depolar
 * Seçili depo F.State.seciliDepoId'ye yazılır → kaydet.js her satırın depo_id'sini buradan alır.
 * Liste init.js (iadeKategoriInit → guncelle) tarafından kategori değişiminde yenilenir.
 */
(function() {
    'use strict';

    var F = window.Form;

    F.IadeAlanlari = {};

    // Kategori → görünüm metinleri
    var KAT_GORUNUM = {
        normal: {
            depolar: 'magazaDepolar',
            label: '<i class="icon-home"></i> Hedef Depo',
            hint: '<i class="icon-info"></i> Satışa uygun (sağlam) iade ürünleri bu mağaza deposuna girer, tekrar satışa hazır olur.',
            bos: '<i class="icon-alert-triangle"></i> Satışa uygun (mağaza) depo tanımlı değil. Ürün iadesi alınamaz.'
        },
        arizali: {
            depolar: 'servisDepolar',
            label: '<i class="icon-tool"></i> Arıza Deposu',
            hint: '<i class="icon-info"></i> Arızalı iade ürünleri bu arıza (servis) deposuna girer.',
            bos: '<i class="icon-alert-triangle"></i> Arıza (servis) depo tanımlı değil. Arızalı iade alınamaz.'
        }
    };

    /**
     * Verilen kategori için uygun depo listesini döndür (Config'ten).
     */
    F.IadeAlanlari.kategoriDepolari = function(kat) {
        var g = KAT_GORUNUM[kat] || KAT_GORUNUM.normal;
        return (F.Config[g.depolar] || []);
    };

    /**
     * Hedef depo seçicisini kategoriye göre yeniden doldur + label/hint güncelle.
     * @param {string} kat       'normal' | 'arizali'
     * @param {number} [seciliId] Düzenlemede orijinal depoyu seçili getirmek için
     */
    F.IadeAlanlari.depolariYenile = function(kat, seciliId) {
        var depoSel = document.getElementById('frmIadeDepo');
        if (!depoSel) return;

        var g = KAT_GORUNUM[kat] || KAT_GORUNUM.normal;
        var liste = F.IadeAlanlari.kategoriDepolari(kat);

        var labelEl = document.getElementById('frmIadeDepoLabel');
        var hintEl = document.getElementById('frmIadeDepoHint');
        if (labelEl) labelEl.innerHTML = g.label;

        // Option'ları kur
        var html = '';
        for (var i = 0; i < liste.length; i++) {
            html += '<option value="' + liste[i].id + '">' + F.Helpers.escHtml(liste[i].adi) + '</option>';
        }
        depoSel.innerHTML = html;

        if (liste.length === 0) {
            // Bu kategori için uygun depo yok → seçici devre dışı, uyarı göster
            depoSel.disabled = true;
            F.State.seciliDepoId = 0;
            if (hintEl) {
                hintEl.innerHTML = g.bos;
                hintEl.classList.add('frm-iade-depo-hint-uyari');
            }
            return;
        }

        if (!F.Config.readonly) depoSel.disabled = false;
        if (hintEl) {
            hintEl.innerHTML = g.hint;
            hintEl.classList.remove('frm-iade-depo-hint-uyari');
        }

        // Seçili depoyu belirle: verilen seciliId listede varsa onu, yoksa ilk depo
        var hedef = 0;
        if (seciliId) {
            for (var j = 0; j < liste.length; j++) {
                if (liste[j].id === parseInt(seciliId, 10)) { hedef = liste[j].id; break; }
            }
        }
        if (!hedef) hedef = liste[0].id;

        depoSel.value = String(hedef);
        F.State.seciliDepoId = hedef;
    };

    F.IadeAlanlari.init = function() {
        if (!F.Config.isIade) return;

        var depoSel = document.getElementById('frmIadeDepo');
        if (depoSel) {
            // Kullanıcı seçici üzerinden depo değiştirince merkezi state'i + tüm mevcut
            // satırların deposunu güncelle (sağ panel = "tüm iade ürünleri bu depoya").
            // (Liste içeriği depolariYenile ile değişir ama element sabit → listener korunur.)
            depoSel.addEventListener('change', function() {
                var v = parseInt(this.value, 10);
                if (v > 0) {
                    F.State.seciliDepoId = v;
                    F.IadeAlanlari.satirDepolariniUygula(v);
                }
            });

            // Başlangıç: aktif kategoriye göre listeyi kur (iadeKategoriInit zaten guncelle
            // içinde çağırır; burada da defansif çağrı — sıra fark etmez).
            F.IadeAlanlari.depolariYenile(F.State.iadeKategorisi);
        }
    };

    /**
     * Tüm mevcut iade satırlarının (ve varyantlarının) hedef deposunu güncelle.
     * Kullanıcı sağ panelden depo değiştirince çağrılır → eklenmiş/yüklenmiş satırlar da
     * yeni depoya taşınır (yoksa kaydette satırın eski depoId'si kazanırdı).
     */
    F.IadeAlanlari.satirDepolariniUygula = function(depoId) {
        if (!depoId) return;
        var satirlar = F.State.satirlar || [];
        for (var i = 0; i < satirlar.length; i++) {
            satirlar[i].depoId = depoId;
            var vs = satirlar[i].varyantlar || [];
            for (var j = 0; j < vs.length; j++) {
                vs[j].depoId = depoId;
            }
        }
    };

    // Düzenleme modunda yükleme sonrası: kategorinin listesini kurup orijinal depoyu seç
    F.IadeAlanlari.depoSec = function(depoId) {
        if (!depoId) return;
        F.IadeAlanlari.depolariYenile(F.State.iadeKategorisi, depoId);
    };

})();
