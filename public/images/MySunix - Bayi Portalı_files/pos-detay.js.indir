(function() {
    'use strict';
    var F = window.Form;
    if (!F || !F.Pos) return;

    F.Pos.Detay = {};

    var _overlay, _icerik, _kapatBtn;
    var _aktif = false;
    var _resimler = [];

    F.Pos.Detay.init = function() {
        _overlay = document.getElementById('frmPosDetayOverlay');
        _icerik = document.getElementById('frmPosDetayIcerik');
        _kapatBtn = document.getElementById('frmPosDetayKapat');
        if (!_overlay) return;

        _kapatBtn.addEventListener('click', F.Pos.Detay.kapat);
        _overlay.addEventListener('click', function(e) {
            if (e.target === _overlay) F.Pos.Detay.kapat();
        });
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && _aktif) {
                var lb = document.getElementById('frmPosDetLightbox');
                if (lb && lb.classList.contains('aktif')) { _lightboxKapat(); return; }
                F.Pos.Detay.kapat();
            }
        });
    };

    F.Pos.Detay.ac = function(urunId, kaynak) {
        if (!_overlay || !_icerik) return;
        _icerik.innerHTML = '<div class="frm-pos-det-yukle"><i class="icon-loader"></i> Yükleniyor...</div>';
        _overlay.classList.add('aktif');
        _aktif = true;

        F.Helpers.ajaxPost(F.Pos.Config.ajaxUrl.replace('pos-urunler.php', 'pos-urun-detay.php'), {
            urun_id: urunId,
            kaynak: kaynak || 'sunix'
        }, function(res) {
            if (res.success && res.data) {
                _resimler = res.data.resimler || [];
                _icerik.innerHTML = _renderIcerik(res.data);
                _galeriInit();
            } else {
                _icerik.innerHTML = '<div class="frm-pos-det-bos"><i class="icon-alert-circle"></i><br>Ürün bilgisi yüklenemedi</div>';
            }
        }, function() {
            _icerik.innerHTML = '<div class="frm-pos-det-bos"><i class="icon-alert-circle"></i><br>Bağlantı hatası</div>';
        });
    };

    F.Pos.Detay.kapat = function() {
        if (!_overlay) return;
        _overlay.classList.remove('aktif');
        _aktif = false;
    };

    function _esc(s) { return F.Helpers.escHtml(s || ''); }

    function _imgUrl(url) {
        if (!url) return '';
        if (window._bayiResimUrl) return window._bayiResimUrl(url);
        return url;
    }

    function _renderIcerik(d) {
        var h = '';
        h += _renderHeader(d);

        var teknik = d.teknik_ozellikler || {};
        var genelBakis = teknik.genel_bakis || [];
        var genelMetin = (genelBakis.length > 0 && genelBakis[0].deger) ? genelBakis[0].deger : '';

        h += '<div class="frm-pos-det-ust">';
        h += _renderGaleri(d.resimler);
        h += _renderSagPanel(d, genelMetin);
        h += '</div>';

        h += _renderTeknikSections(teknik, true);

        if (d.desteklenen_modeller && d.desteklenen_modeller.length > 0) {
            h += _renderModeller(d.desteklenen_modeller);
        }

        h += _renderLightbox();

        return h;
    }

    function _renderHeader(d) {
        var h = '<div class="frm-pos-det-header">';
        if (d.kategori_adi) h += '<div class="frm-pos-det-hdr-kat">' + _esc(d.kategori_adi) + '</div>';
        h += '<div class="frm-pos-det-hdr-ad">' + _esc(d.urun_adi) + '</div>';
        var kb = (F.Helpers && F.Helpers.koliBilgi) ? F.Helpers.koliBilgi(d) : null;
        if (kb) h += '<div class="frm-pos-det-hdr-koli"><i class="icon-package"></i> ' + _esc(kb.tam) + '</div>';
        h += '</div>';
        return h;
    }

    function _renderGaleri(resimler) {
        if (!resimler || resimler.length === 0) {
            return '<div class="frm-pos-det-galeri"><div class="frm-pos-det-ana-resim"><i class="icon-image" style="font-size:3rem;color:#cbd5e1"></i></div></div>';
        }
        var h = '<div class="frm-pos-det-galeri">';
        h += '<div class="frm-pos-det-ana-resim" id="frmPosDetAnaResimWrap">';
        h += '<img src="' + _esc(_imgUrl(resimler[0].resim_yolu)) + '" id="frmPosDetAnaImg" alt="">';
        h += '<div class="frm-pos-det-zoom-hint"><i class="icon-zoom-in"></i></div>';
        h += '</div>';
        if (resimler.length > 1) {
            h += '<div class="frm-pos-det-thumbs">';
            for (var i = 0; i < resimler.length; i++) {
                h += '<div class="frm-pos-det-thumb' + (i === 0 ? ' aktif' : '') + '" data-src="' + _esc(_imgUrl(resimler[i].resim_yolu)) + '" data-idx="' + i + '">';
                h += '<img src="' + _esc(_imgUrl(resimler[i].resim_yolu)) + '" alt="">';
                h += '</div>';
            }
            h += '</div>';
        }
        h += '</div>';
        return h;
    }

    function _renderSagPanel(d, genelMetin) {
        var h = '<div class="frm-pos-det-bilgi">';

        if (genelMetin) {
            var metin = genelMetin.replace(/\\n/g, '\n');
            var paragraflar = metin.split('\n').filter(function(p) { return p.trim() !== ''; });
            h += '<div class="frm-pos-det-genel">';
            h += '<div class="frm-pos-det-genel-baslik"><i class="icon-book-open"></i> Genel Bakış</div>';
            h += '<div class="frm-pos-det-genel-metin">';
            for (var i = 0; i < paragraflar.length; i++) {
                h += '<p>' + _esc(paragraflar[i].trim()) + '</p>';
            }
            h += '</div></div>';
        }

        if (d.aciklama) {
            h += '<div class="frm-pos-det-aciklama">' + _esc(d.aciklama).replace(/\n/g, '<br>') + '</div>';
        }

        if (d.ozellikler && typeof d.ozellikler === 'object') {
            var keys = Object.keys(d.ozellikler);
            if (keys.length > 0) {
                h += '<table class="frm-pos-det-oz-tablo">';
                for (var j = 0; j < keys.length; j++) {
                    h += '<tr><th>' + _esc(keys[j]) + '</th><td>' + _esc(d.ozellikler[keys[j]]) + '</td></tr>';
                }
                h += '</table>';
            }
        }

        h += '</div>';
        return h;
    }

    function _renderTeknikSections(teknik, skipGenel) {
        if (!teknik || Object.keys(teknik).length === 0) return '';

        var urunOz = teknik.urun_ozellikleri || [];
        var teknikOz = teknik.teknik_ozellikler || [];
        var kutu = teknik.kutu_icerigi || [];
        var uyum = teknik.uyumluluk || [];

        var hasContent = urunOz.length > 0 || teknikOz.length > 0 || kutu.length > 0 || uyum.length > 0;
        if (!hasContent && skipGenel) return '';

        var h = '<div class="frm-pos-det-sections">';

        if (!skipGenel) {
            var genelBakis = teknik.genel_bakis || [];
            if (genelBakis.length > 0 && genelBakis[0].deger) {
                h += _renderSection('icon-book-open', 'Genel Bakış', _renderGenel(genelBakis));
            }
        }

        if (urunOz.length > 0) h += _renderSection('icon-tag', 'Ürün Özellikleri', _renderKartlar(urunOz));
        if (teknikOz.length > 0) h += _renderSection('icon-cpu', 'Teknik Özellikler', _renderKartlar(teknikOz));

        var kutuHtml = kutu.length > 0 ? _renderSection('icon-package', 'Kutu İçeriği', _renderKutu(kutu)) : '';
        var uyumHtml = '';
        if (uyum.length > 0) {
            var uyumIc = _renderUyumluluk(uyum);
            if (uyumIc) uyumHtml = _renderSection('icon-globe', 'Uyumluluk', uyumIc);
        }
        if (kutuHtml && uyumHtml) {
            h += '<div class="frm-pos-det-iki-sutun">' + kutuHtml + uyumHtml + '</div>';
        } else {
            h += kutuHtml + uyumHtml;
        }

        h += '</div>';
        return h;
    }

    function _renderSection(icon, baslik, icerik) {
        return '<div class="frm-pos-det-sec">' +
            '<div class="frm-pos-det-sec-head"><i class="' + icon + '"></i><span>' + _esc(baslik) + '</span></div>' +
            '<div class="frm-pos-det-sec-body">' + icerik + '</div></div>';
    }

    function _renderGenel(genelBakis) {
        var metin = (genelBakis[0].deger || '').replace(/\\n/g, '\n');
        var paragraflar = metin.split('\n').filter(function(p) { return p.trim() !== ''; });
        var h = '<div class="frm-pos-det-genel-metin">';
        for (var i = 0; i < paragraflar.length; i++) h += '<p>' + _esc(paragraflar[i].trim()) + '</p>';
        h += '</div>';
        return h;
    }

    function _renderKartlar(items) {
        var h = '<div class="frm-pos-det-kartlar">';
        for (var i = 0; i < items.length; i++) {
            if (items[i].anahtar && items[i].deger) {
                h += '<div class="frm-pos-det-kart"><div class="frm-pos-det-kart-key">' + _esc(items[i].anahtar) + '</div><div class="frm-pos-det-kart-val">' + _esc(items[i].deger) + '</div></div>';
            }
        }
        h += '</div>';
        return h;
    }

    function _renderKutu(kutu) {
        var h = '<div class="frm-pos-det-liste">';
        for (var i = 0; i < kutu.length; i++) {
            if (kutu[i].deger) h += '<div class="frm-pos-det-liste-item"><i class="icon-check-circle"></i><span>' + _esc(kutu[i].deger) + '</span></div>';
        }
        h += '</div>';
        return h;
    }

    function _renderUyumluluk(uyum) {
        var aktif = [], ek = [];
        for (var i = 0; i < uyum.length; i++) {
            if (uyum[i].anahtar) { if (uyum[i].deger === '1') aktif.push(uyum[i].anahtar); }
            else if (uyum[i].deger) ek.push(uyum[i].deger);
        }
        if (!aktif.length && !ek.length) return '';
        var h = '';
        if (aktif.length) {
            h += '<div class="frm-pos-det-platformlar">';
            for (var j = 0; j < aktif.length; j++) h += '<span class="frm-pos-det-plat">' + _esc(aktif[j]) + '</span>';
            h += '</div>';
        }
        if (ek.length) {
            h += '<div class="frm-pos-det-liste" style="margin-top:12px">';
            for (var k = 0; k < ek.length; k++) h += '<div class="frm-pos-det-liste-item"><i class="icon-check-circle"></i><span>' + _esc(ek[k]) + '</span></div>';
            h += '</div>';
        }
        return h;
    }

    function _renderModeller(markalar) {
        var toplamModel = 0;
        for (var i = 0; i < markalar.length; i++) toplamModel += markalar[i].modeller.length;

        var h = '<div class="frm-pos-det-modeller">';
        h += '<div class="frm-pos-det-sec-head"><i class="icon-smartphone"></i><span>Desteklenen Modeller</span><span class="frm-pos-det-mod-badge">' + toplamModel + '</span></div>';

        for (var j = 0; j < markalar.length; j++) {
            var mk = markalar[j];
            var renk = mk.renk || '#475569';
            var logoSrc = mk.logo_url || '';
            var harf = mk.marka_adi ? mk.marka_adi.charAt(0).toUpperCase() : '?';
            var modelSayisi = mk.modeller.length;

            h += '<div class="frm-pos-det-mk">';
            h += '<div class="frm-pos-det-mk-head">';
            h += '<div class="frm-pos-det-mk-logo" style="background:' + _esc(renk) + '">';
            if (logoSrc) {
                h += '<img src="' + _esc(_imgUrl(logoSrc)) + '" alt="" onerror="this.remove()">';
            }
            h += '<span>' + _esc(harf) + '</span>';
            h += '</div>';
            h += '<div class="frm-pos-det-mk-info">';
            h += '<div class="frm-pos-det-mk-adi">' + _esc(mk.marka_adi) + '</div>';
            h += '<div class="frm-pos-det-mk-sayi">' + modelSayisi + ' model</div>';
            h += '</div></div>';

            h += '<div class="frm-pos-det-mk-body">';
            for (var k = 0; k < mk.modeller.length; k++) {
                var mdl = mk.modeller[k];
                if (mdl.renkler && mdl.renkler.length > 0) {
                    h += '<div class="frm-pos-det-mk-model">';
                    h += '<div class="frm-pos-det-mk-model-adi">' + _esc(mdl.model_adi) + '</div>';
                    h += '<div class="frm-pos-det-mk-renkler">';
                    for (var l = 0; l < mdl.renkler.length; l++) {
                        var rk = mdl.renkler[l];
                        h += '<span class="frm-pos-det-mk-renk" style="--rc:' + _esc(rk.renk_kodu || '#94a3b8') + '">' + _esc(rk.renk_adi) + '</span>';
                    }
                    h += '</div></div>';
                } else {
                    h += '<span class="frm-pos-det-mk-pill">' + _esc(mdl.model_adi) + '</span>';
                }
            }
            h += '</div></div>';
        }
        h += '</div>';
        return h;
    }

    // --- Lightbox ---
    function _renderLightbox() {
        return '<div class="frm-pos-det-lb" id="frmPosDetLightbox">' +
            '<div class="frm-pos-det-lb-bg" id="frmPosDetLbBg"></div>' +
            '<button type="button" class="frm-pos-det-lb-kapat" id="frmPosDetLbKapat"><i class="icon-x"></i></button>' +
            '<button type="button" class="frm-pos-det-lb-nav frm-pos-det-lb-prev" id="frmPosDetLbPrev"><i class="icon-chevron-left"></i></button>' +
            '<img class="frm-pos-det-lb-img" id="frmPosDetLbImg" src="" alt="">' +
            '<button type="button" class="frm-pos-det-lb-nav frm-pos-det-lb-next" id="frmPosDetLbNext"><i class="icon-chevron-right"></i></button>' +
            '<div class="frm-pos-det-lb-counter" id="frmPosDetLbCounter"></div>' +
            '</div>';
    }

    var _lbIdx = 0;
    function _lightboxAc(idx) {
        if (!_resimler.length) return;
        _lbIdx = idx || 0;
        var lb = document.getElementById('frmPosDetLightbox');
        if (!lb) return;
        lb.classList.add('aktif');
        _lightboxGoster();
    }
    function _lightboxKapat() {
        var lb = document.getElementById('frmPosDetLightbox');
        if (lb) lb.classList.remove('aktif');
    }
    function _lightboxGoster() {
        var img = document.getElementById('frmPosDetLbImg');
        var counter = document.getElementById('frmPosDetLbCounter');
        if (!img) return;
        img.src = _imgUrl(_resimler[_lbIdx].resim_yolu);
        if (counter) counter.textContent = (_lbIdx + 1) + ' / ' + _resimler.length;
    }

    function _galeriInit() {
        var thumbs = document.querySelectorAll('.frm-pos-det-thumb');
        var anaImg = document.getElementById('frmPosDetAnaImg');
        if (anaImg) anaImg.style.transition = 'opacity .15s ease';

        thumbs.forEach(function(t) {
            t.addEventListener('click', function() {
                thumbs.forEach(function(x) { x.classList.remove('aktif'); });
                t.classList.add('aktif');
                if (anaImg) {
                    anaImg.style.opacity = '0';
                    setTimeout(function() { anaImg.src = t.getAttribute('data-src'); anaImg.style.opacity = '1'; }, 150);
                }
            });
        });

        var anaWrap = document.getElementById('frmPosDetAnaResimWrap');
        if (anaWrap) {
            anaWrap.addEventListener('click', function() {
                var aktifThumb = document.querySelector('.frm-pos-det-thumb.aktif');
                var idx = aktifThumb ? parseInt(aktifThumb.getAttribute('data-idx')) || 0 : 0;
                _lightboxAc(idx);
            });
        }

        var lbBg = document.getElementById('frmPosDetLbBg');
        var lbKapat = document.getElementById('frmPosDetLbKapat');
        var lbPrev = document.getElementById('frmPosDetLbPrev');
        var lbNext = document.getElementById('frmPosDetLbNext');
        if (lbBg) lbBg.addEventListener('click', _lightboxKapat);
        if (lbKapat) lbKapat.addEventListener('click', _lightboxKapat);
        if (lbPrev) lbPrev.addEventListener('click', function() { _lbIdx = (_lbIdx - 1 + _resimler.length) % _resimler.length; _lightboxGoster(); });
        if (lbNext) lbNext.addEventListener('click', function() { _lbIdx = (_lbIdx + 1) % _resimler.length; _lightboxGoster(); });
    }

})();
