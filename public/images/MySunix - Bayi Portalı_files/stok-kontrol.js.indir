/**
 * Form - Stok Yeterlilik Kontrolü
 *
 * Miktar girilirken anlık stok kontrolü yapar.
 * Tüm satışa uygun depoların toplamını baz alır.
 * 4 varyant tipi destekler: düz, renk, model, model_renk.
 *
 * Davranış: Stok yetersizse uyarı gösterir.
 * "Yine de Devam Et" butonu sadece Genel Yönetici'ye görünür.
 */
(function() {
    'use strict';

    var F = window.Form;
    F.StokKontrol = {};

    var cache = {};
    var debounceTimer = null;
    var DEBOUNCE_MS = 400;
    var onayliUrunler = {};
    var orijinalMiktarlar = {};

    function modUygunMu() {
        var mod = F.Config.mod;
        return mod === 'siparis-yeni' || mod === 'siparis-duzenle';
    }

    function yoneticiMi() {
        return !!F.Config.isGenelYonetici;
    }

    function cacheKey(urunId, varyantTip, varyantId) {
        return urunId + '_' + (varyantTip || 'duz') + '_' + (varyantId || 0);
    }

    F.StokKontrol.kontrol = function(params) {
        if (!modUygunMu()) { if (params.callback) params.callback({ yeterli: true }); return; }
        if (F.Config.readonly) { if (params.callback) params.callback({ yeterli: true }); return; }
        if (F.Config.isIade) { if (params.callback) params.callback({ yeterli: true }); return; }
        if (F.Config.stokKontrolAtla) { if (params.callback) params.callback({ yeterli: true }); return; }

        if (!F.Config.stokMiktarGizle) {
            var key = cacheKey(params.urunId, params.varyantTip, params.varyantId);
            if (cache[key] !== undefined) {
                var sonuc = degerlendir(cache[key], params.miktar);
                if (params.callback) params.callback(sonuc);
                return;
            }
        }

        if (debounceTimer) clearTimeout(debounceTimer);
        debounceTimer = setTimeout(function() {
            ajaxKontrol(params);
        }, DEBOUNCE_MS);
    };

    F.StokKontrol.anlikKontrol = function(params) {
        if (!modUygunMu() || F.Config.readonly || F.Config.isIade || F.Config.stokKontrolAtla) {
            if (params.callback) params.callback({ yeterli: true });
            return;
        }
        ajaxKontrol(params);
    };

    function ajaxKontrol(params) {
        $.ajax({
            url: F.Config.ajaxBase + 'stok-kontrol.php',
            method: 'POST',
            data: {
                urun_id: params.urunId,
                varyant_tip: params.varyantTip || '',
                varyant_id: params.varyantId || 0,
                miktar: params.miktar || 0,
                kaynak: (F.State.urunKaynakMap && F.State.urunKaynakMap[params.urunId]) || 'sunix'
            },
            dataType: 'json',
            success: function(res) {
                if (res.success) {
                    if (res.mevcut_stok !== undefined) {
                        var key = cacheKey(params.urunId, params.varyantTip, params.varyantId);
                        cache[key] = res.mevcut_stok;
                        var sonuc = degerlendir(res.mevcut_stok, params.miktar);
                        if (params.callback) params.callback(sonuc);
                    } else {
                        if (params.callback) params.callback({
                            yeterli: !!res.yeterli,
                            mevcut_stok: 0,
                            istenen: params.miktar,
                            fark: 0
                        });
                    }
                } else {
                    // Fail-closed: sunucu hatası → stok yetersiz kabul et
                    if (params.callback) params.callback({ yeterli: false, mevcut_stok: 0, istenen: params.miktar, fark: params.miktar });
                }
            },
            error: function() {
                // Fail-closed: AJAX hatası → stok yetersiz kabul et
                if (params.callback) params.callback({ yeterli: false, mevcut_stok: 0, istenen: params.miktar, fark: params.miktar });
            }
        });
    }

    function degerlendir(mevcutStok, istenenMiktar) {
        return {
            yeterli: mevcutStok >= istenenMiktar,
            mevcut_stok: mevcutStok,
            istenen: istenenMiktar,
            fark: istenenMiktar - mevcutStok
        };
    }

    /**
     * Stok yetersiz uyarısı göster
     * Yönetici: "Yine de Devam Et" + "İptal" butonları
     * Diğer kullanıcılar: Sadece "Tamam" (engel)
     * @returns Promise<boolean>
     */
    F.StokKontrol.uyariGoster = function(urunAdi, mevcutStok, istenenMiktar) {
        if (F.Config.stokKontrolAtla) return Promise.resolve(true);
        var eksik = Math.ceil(istenenMiktar - mevcutStok);
        var izinVar = yoneticiMi();
        var gizle = !!F.Config.stokMiktarGizle;

        var html = '<div class="frm-stok-uyari">' +
            '<div class="frm-stok-uyari-urun">' + F.Helpers.escHtml(urunAdi) + '</div>';

        if (gizle) {
            html += '<div class="frm-stok-uyari-bilgi" style="margin-top:16px">Girilen miktarlarla devam etme yetkiniz yok. Lütfen bayi temsilcinizle iletişime geçin.</div>';
        } else {
            html += '<div class="frm-stok-uyari-tablo">' +
                '<div class="frm-stok-uyari-satir">' +
                    '<span class="frm-stok-uyari-etiket">Mevcut Stok</span>' +
                    '<span class="frm-stok-uyari-deger">' + Math.floor(mevcutStok) + '</span>' +
                '</div>' +
                '<div class="frm-stok-uyari-satir">' +
                    '<span class="frm-stok-uyari-etiket">İstenen Miktar</span>' +
                    '<span class="frm-stok-uyari-deger">' + Math.floor(istenenMiktar) + '</span>' +
                '</div>' +
                '<div class="frm-stok-uyari-satir frm-stok-uyari-eksik">' +
                    '<span class="frm-stok-uyari-etiket">Eksik</span>' +
                    '<span class="frm-stok-uyari-deger">' + eksik + '</span>' +
                '</div>' +
            '</div>' +
            (izinVar ? '' : '<div class="frm-stok-uyari-bilgi">Girilen miktarlarla devam etme yetkiniz yok. Lütfen bayi temsilcinizle iletişime geçin.</div>');
        }

        html += '</div>';

        return Swal.fire({
            icon: 'none',
            title: '',
            html: html,
            showCancelButton: izinVar,
            showConfirmButton: izinVar,
            showDenyButton: !izinVar,
            confirmButtonText: '<i class="icon-check"></i> Yine de Devam Et',
            cancelButtonText: 'İptal',
            denyButtonText: 'Tamam',
            confirmButtonColor: '#103595',
            cancelButtonColor: '#6b7280',
            denyButtonColor: '#6b7280',
            customClass: {
                popup: 'frm-stok-uyari-popup',
                htmlContainer: 'frm-stok-uyari-container'
            },
            allowOutsideClick: false
        }).then(function(result) {
            return izinVar && result.isConfirmed;
        });
    };

    /**
     * Çoklu varyant stok yetersiz uyarısı (varyant + kılıf modal için)
     * @returns Promise<boolean>
     */
    F.StokKontrol.cokluUyariGoster = function(yetersizler, urunData) {
        if (F.Config.stokKontrolAtla) return Promise.resolve(true);
        var izinVar = yoneticiMi();
        var gizle = !!F.Config.stokMiktarGizle;

        var html = '<div class="frm-stok-uyari">' +
            '<div class="frm-stok-uyari-urun">' + F.Helpers.escHtml(urunData ? urunData.urun_adi : '') + '</div>';

        if (gizle) {
            html += '<div class="frm-stok-uyari-liste">';
            for (var i = 0; i < yetersizler.length; i++) {
                var y = yetersizler[i];
                html += '<div class="frm-stok-uyari-liste-satir">' +
                    '<span class="frm-stok-uyari-liste-adi">' + F.Helpers.escHtml(y.adi || '?') + '</span>' +
                    '<span class="frm-stok-uyari-liste-stok" style="color:#dc2626;font-weight:600">Yetersiz</span>' +
                    '</div>';
            }
            html += '</div>' +
                '<div class="frm-stok-uyari-bilgi">Girilen miktarlarla devam etme yetkiniz yok. Lütfen bayi temsilcinizle iletişime geçin.</div>';
        } else {
            html += '<div class="frm-stok-uyari-liste">';
            for (var i = 0; i < yetersizler.length; i++) {
                var y = yetersizler[i];
                html += '<div class="frm-stok-uyari-liste-satir">' +
                    '<span class="frm-stok-uyari-liste-adi">' + F.Helpers.escHtml(y.adi || '?') + '</span>' +
                    '<span class="frm-stok-uyari-liste-stok">Stok: <b>' + Math.floor(y.mevcut) + '</b></span>' +
                    '<span class="frm-stok-uyari-liste-istenen">İstenen: <b>' + Math.floor(y.istenen) + '</b></span>' +
                    '</div>';
            }
            html += '</div>' +
                (izinVar ? '' : '<div class="frm-stok-uyari-bilgi">Girilen miktarlarla devam etme yetkiniz yok. Lütfen bayi temsilcinizle iletişime geçin.</div>');
        }

        html += '</div>';

        return Swal.fire({
            icon: 'none',
            title: '',
            html: html,
            showCancelButton: izinVar,
            showConfirmButton: izinVar,
            showDenyButton: !izinVar,
            confirmButtonText: '<i class="icon-check"></i> Yine de Devam Et',
            cancelButtonText: 'İptal',
            denyButtonText: 'Tamam',
            confirmButtonColor: '#103595',
            cancelButtonColor: '#6b7280',
            denyButtonColor: '#6b7280',
            customClass: {
                popup: 'frm-stok-uyari-popup',
                htmlContainer: 'frm-stok-uyari-container'
            },
            allowOutsideClick: false
        }).then(function(result) {
            return izinVar && result.isConfirmed;
        });
    };

    F.StokKontrol.onayLogla = function(urunId, varyantTip, varyantId, mevcutStok, istenenMiktar) {
        $.ajax({
            url: F.Config.ajaxBase + 'stok-kontrol-log.php',
            method: 'POST',
            data: {
                urun_id: urunId,
                varyant_tip: varyantTip || '',
                varyant_id: varyantId || 0,
                mevcut_stok: mevcutStok,
                istenen_miktar: istenenMiktar
            }
        });
    };

    F.StokKontrol.onayliIsaretle = function(urunId, varyantTip, varyantId) {
        var key = cacheKey(urunId, varyantTip, varyantId);
        onayliUrunler[key] = true;
    };

    F.StokKontrol.onayliMi = function(urunId, varyantTip, varyantId) {
        var key = cacheKey(urunId, varyantTip, varyantId);
        return !!onayliUrunler[key];
    };

    F.StokKontrol.cacheSifirla = function() {
        cache = {};
        onayliUrunler = {};
    };

    /**
     * Düzenleme modunda orijinal miktarları kaydet (yukle.js'den çağrılır)
     * Key: urunId_varyantTip_varyantId → miktar
     */
    F.StokKontrol.orijinalMiktarKaydet = function(urunId, varyantTip, varyantId, miktar) {
        var key = cacheKey(urunId, varyantTip, varyantId);
        orijinalMiktarlar[key] = (orijinalMiktarlar[key] || 0) + miktar;
    };

    /**
     * Düzenleme modunda fark miktarını hesapla
     * Yeni miktar - eski miktar. Fark ≤ 0 ise stok kontrolü gerekmez.
     */
    F.StokKontrol.farkMiktarHesapla = function(urunId, varyantTip, varyantId, yeniMiktar) {
        if (F.Config.mod !== 'siparis-duzenle') return yeniMiktar;
        var key = cacheKey(urunId, varyantTip, varyantId);
        var eski = orijinalMiktarlar[key] || 0;
        return yeniMiktar - eski;
    };

    F.StokKontrol.duzenlemeModuMu = function() {
        return F.Config.mod === 'siparis-duzenle';
    };

    F.StokKontrol.inputDurumGoster = function(inputEl, yeterli, mevcutStok) {
        if (!inputEl) return;
        inputEl.style.borderColor = yeterli ? '' : '#ef4444';
        if (F.Config.stokMiktarGizle) {
            inputEl.title = yeterli ? '' : 'Stok yetersiz';
        } else {
            inputEl.title = yeterli ? '' : 'Stok yetersiz! Mevcut: ' + Math.floor(mevcutStok);
        }
    };

    var CAM_DEPO_ID = 22;

    /**
     * Cam Depo kontrolü — herkes görür, sadece yönetici "devam et" diyebilir
     * @param {number} depoId
     * @returns {boolean} true = Cam Depo seçili ve engel var
     */
    F.StokKontrol.camDepoMu = function(depoId) {
        return parseInt(depoId) === CAM_DEPO_ID;
    };

    /**
     * Cam Depo uyarısı göster (stok uyarı stiliyle)
     * Yönetici: "Yine de Devam Et"
     * Diğer: "Tamam" (engel)
     * @returns Promise<boolean>
     */
    F.StokKontrol.camDepoUyariGoster = function(urunAdi) {
        var izinVar = yoneticiMi();

        var html = '<div class="frm-stok-uyari">' +
            '<div class="frm-stok-uyari-urun">Cam Depo Satış Kısıtlaması</div>' +
            '<div style="padding:12px 24px;font-size:13px;color:#374151;">' +
                '<b>' + F.Helpers.escHtml(urunAdi || '') + '</b> için Cam Depo seçildi.<br><br>' +
                'Cam Depo\'dan satış yapmak özel yetki gerektirir.' +
            '</div>' +
            (izinVar ? '' : '<div class="frm-stok-uyari-bilgi">Bu depodan satış yapma yetkiniz yok. Farklı bir depo seçin veya yöneticinize başvurun.</div>') +
            '</div>';

        return Swal.fire({
            icon: 'none',
            title: '',
            html: html,
            showCancelButton: izinVar,
            showConfirmButton: izinVar,
            showDenyButton: !izinVar,
            confirmButtonText: '<i class="icon-check"></i> Yine de Devam Et',
            cancelButtonText: 'İptal',
            denyButtonText: 'Tamam',
            confirmButtonColor: '#103595',
            cancelButtonColor: '#6b7280',
            denyButtonColor: '#6b7280',
            customClass: {
                popup: 'frm-stok-uyari-popup',
                htmlContainer: 'frm-stok-uyari-container'
            },
            allowOutsideClick: false
        }).then(function(result) {
            return izinVar && result.isConfirmed;
        });
    };

    /**
     * Depo listesindeki bir varyant grubunda Cam Depo var mı kontrol et
     */
    F.StokKontrol.varyantlardaCamDepoVarMi = function(varyantlar) {
        for (var i = 0; i < varyantlar.length; i++) {
            if (parseInt(varyantlar[i].depoId) === CAM_DEPO_ID) return true;
        }
        return false;
    };

})();
