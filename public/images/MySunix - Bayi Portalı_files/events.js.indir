/**
 * Form - Custom Event Bus
 * Modüller arası iletişim
 */
(function() {
    'use strict';

    var F = window.Form;
    var listeners = {};

    F.Events = {
        /**
         * Event dinle
         * @param {string} event - Event adı (ör: 'musteri:secildi')
         * @param {function} callback - Callback fonksiyonu
         */
        on: function(event, callback) {
            if (!listeners[event]) listeners[event] = [];
            listeners[event].push(callback);
        },

        /**
         * Event dinlemeyi kaldır
         */
        off: function(event, callback) {
            if (!listeners[event]) return;
            if (!callback) return;
            listeners[event] = listeners[event].filter(function(fn) {
                return fn !== callback;
            });
        },

        /**
         * Event yayınla
         * @param {string} event - Event adı
         * @param {*} data - Event verisi
         */
        emit: function(event, data) {
            if (!listeners[event]) return;
            for (var i = 0; i < listeners[event].length; i++) {
                try {
                    listeners[event][i](data);
                } catch (e) {
                    console.error('[Form.Events] Hata:', event, e);
                }
            }
        }
    };

})();
