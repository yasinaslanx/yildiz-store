(function() {
    'use strict';
    var F = window.Form;
    if (!F || !F.Pos) return;

    F.Pos.Kategori = {};

    var _viewMode = 'list';

    F.Pos.Kategori.yukle = function() {
        if (F.Pos.State.kategoriler) {
            F.Pos.Kategori.render();
            return;
        }

        F.Helpers.ajaxPost(F.Pos.Config.ajaxUrl, { aksiyon: 'kategoriler' }, function(res) {
            if (res.success) {
                F.Pos.State.kategoriler = res.kategoriler;
                F.Pos.Kategori.render();
            }
        });
    };

    F.Pos.Kategori.render = function() {
        var container = document.getElementById('frmPosSidebar');
        if (!container) return;

        var kategoriler = F.Pos.State.kategoriler || [];
        var toplamUrun = 0;
        _topla(kategoriler, function(n) { toplamUrun += n; });

        var saved = localStorage.getItem('frm_pos_cat_view');
        if (saved === 'grid' || saved === 'list') _viewMode = saved;

        var html = '';

        html += '<div class="frm-pos-cat-head">';
        html += '<span>Kategoriler</span>';
        html += '<div class="frm-pos-cat-mode">';
        html += '<button type="button" class="frm-pos-cat-mode-btn' + (_viewMode === 'list' ? ' active' : '') + '" data-view="list" title="Liste"><i class="icon-list"></i></button>';
        html += '<button type="button" class="frm-pos-cat-mode-btn' + (_viewMode === 'grid' ? ' active' : '') + '" data-view="grid" title="Kare"><i class="icon-grid"></i></button>';
        html += '</div>';
        html += '</div>';

        html += '<div class="frm-pos-cat-items">';

        html += '<button type="button" class="frm-pos-cat-item active" data-id="0">';
        html += '<i class="icon-layers"></i>';
        html += '<span>Tüm Ürünler</span>';
        html += '</button>';

        for (var i = 0; i < kategoriler.length; i++) {
            var k = kategoriler[i];
            var icon = k.icon || 'icon-folder';
            html += '<button type="button" class="frm-pos-cat-item" data-id="' + k.id + '">';
            html += '<i class="' + F.Helpers.escHtml(icon) + '"></i>';
            html += '<span>' + F.Helpers.escHtml(k.kategori_adi) + '</span>';
            html += '</button>';
        }

        html += '</div>';

        html += '<div class="frm-pos-cat-footer">' + toplamUrun + ' ürün</div>';

        container.innerHTML = html;
        container.classList.remove('frm-pos-cat-grid', 'frm-pos-cat-list');
        container.classList.add('frm-pos-cat-' + _viewMode);

        _bindEvents(container);
    };

    function _topla(arr, cb) {
        for (var i = 0; i < arr.length; i++) {
            cb(arr[i].urun_sayisi || 0);
            if (arr[i].children && arr[i].children.length) _topla(arr[i].children, cb);
        }
    }

    function _bindEvents(container) {
        container.addEventListener('click', function(e) {
            var item = e.target.closest('.frm-pos-cat-item');
            if (item) {
                container.querySelectorAll('.frm-pos-cat-item').forEach(function(el) {
                    el.classList.remove('active');
                });
                item.classList.add('active');

                var id = parseInt(item.getAttribute('data-id')) || 0;
                F.Pos.State.aktifKategoriId = id === 0 ? null : id;
                F.Events.emit('pos:kategori-secildi', { id: F.Pos.State.aktifKategoriId });
                return;
            }

            var modeBtn = e.target.closest('.frm-pos-cat-mode-btn');
            if (modeBtn) {
                var view = modeBtn.getAttribute('data-view');
                _viewMode = view;
                localStorage.setItem('frm_pos_cat_view', view);

                container.classList.remove('frm-pos-cat-grid', 'frm-pos-cat-list');
                container.classList.add('frm-pos-cat-' + view);

                container.querySelectorAll('.frm-pos-cat-mode-btn').forEach(function(b) {
                    b.classList.remove('active');
                });
                modeBtn.classList.add('active');
            }
        });
    }

})();
