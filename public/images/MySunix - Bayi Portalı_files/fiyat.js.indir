/**
 * Form - Fiyat Listesi Entegrasyonu + Fiyat Grubu
 */
(function() {
    'use strict';

    var F = window.Form;

    F.Fiyat = {};

    var oncekiFiyatGrubuId = null;

    /**
     * Manuel fiyat listesi seçiminde çağrılır:
     * Bir sonraki müşteri değişiminin "aynı liste" karşılaştırmasını doğru yapması için
     * önceki ID'yi manuel seçim ile senkronize eder.
     */
    F.Fiyat.aktifFiyatGrubuIdSet = function(id) {
        oncekiFiyatGrubuId = id || null;
    };

    /**
     * Init
     */
    F.Fiyat.init = function() {
        if (F.Config.isOnSiparis || F.Config.isSevkiyat) return;
        // Readonly modda (görüntüleme) fiyat yeniden hesaplanmamalı — DB'deki fiyatlar korunur
        if (F.State.readonly) return;

        F.Events.on('musteri:secildi', function(data) {
            var yeniFiyatGrubuId = data.fiyatGrubuId || null;
            F.State.fiyatGrubuId = yeniFiyatGrubuId;

            if (yeniFiyatGrubuId) {
                F.Fiyat.fiyatGrubuYukle(yeniFiyatGrubuId);

                // Tabloda satır varsa ve fiyat grubu değiştiyse toplu hesapla
                if (F.State.satirlar.length > 0 && yeniFiyatGrubuId !== oncekiFiyatGrubuId) {
                    F.Fiyat.topluFiyatHesapla();
                }
            } else if (oncekiFiyatGrubuId && F.State.satirlar.length > 0) {
                // Fiyat grubu kalktı ama önceden vardı → orijinal fiyatlara dön
                F.Fiyat.kurallariTemizle();
            }

            oncekiFiyatGrubuId = yeniFiyatGrubuId;
        });

        // Yeni satır eklendiğinde indirim kontrolü (AJAX race condition güvenlik ağı)
        F.Events.on('satir:eklendi', function(data) {
            if (!F.State.fiyatGrubuId) return;
            var satir = F.State.satirBul(data.satirId);
            if (!satir || satir.fiyatKurali) return; // Zaten kuralı var
            // Bayi kendi ürünü (kaynak=bayi) → fiyat grubu kuralı UYGULANMAZ (fiyat = BAZ, USD)
            if (satir.urunKaynak === 'bayi') return;

            F.Fiyat.urunFiyatHesapla(satir.urunId, function(sonuc) {
                if (!sonuc || !sonuc.kuralVar) return;
                var guncelSatir = F.State.satirBul(data.satirId);
                if (!guncelSatir || guncelSatir.fiyatKurali) return;

                // Satırın mevcut baz fiyatını koru (kullanıcı değiştirmiş olabilir; 0 dahil geçerli bir değerdir)
                var bazFiyat = (guncelSatir.normalBirimFiyat != null) ? guncelSatir.normalBirimFiyat : sonuc.birimFiyat;
                guncelSatir.normalBirimFiyat = bazFiyat;
                guncelSatir.birimFiyat = F.Helpers.fiyatKuraliUygula(bazFiyat, sonuc.kural);
                guncelSatir.fiyatKurali = sonuc.kural;
                guncelSatir.sdKart = sonuc.sdKart || 0;

                // Varyant fiyatlarına kuralı uygula (0 fiyat geçerli değerdir)
                if (guncelSatir.varyantlar && guncelSatir.varyantlar.length > 0) {
                    for (var v = 0; v < guncelSatir.varyantlar.length; v++) {
                        var vr = guncelSatir.varyantlar[v];
                        var orijFiyat = (vr.normalBirimFiyat != null) ? vr.normalBirimFiyat : ((vr.birimFiyat != null) ? vr.birimFiyat : 0);
                        vr.normalBirimFiyat = orijFiyat;
                        vr.birimFiyat = F.Helpers.fiyatKuraliUygula(orijFiyat, sonuc.kural);
                    }
                }

                F.Tablo.tumSatirlariYenidenCiz();
                F.Events.emit('hesaplama:guncelle');
            });
        });

        F.Events.on('musteri:temizlendi', function() {
            var eskiFiyatGrubuId = F.State.fiyatGrubuId;
            F.State.fiyatGrubuId = null;
            F.Fiyat.fiyatGrubuBilgi = null;

            // Kuralları temizle ve orijinal fiyatlara dön
            if (eskiFiyatGrubuId && F.State.satirlar.length > 0) {
                F.Fiyat.kurallariTemizle();
            }

            oncekiFiyatGrubuId = null;
        });
    };

    /**
     * Fiyat grubu bilgilerini kaydet
     * Ürün bazlı fiyatlar her modal açılışında sorgulanır
     */
    F.Fiyat.fiyatGrubuYukle = function(grubuId) {
        F.State.fiyatGrubuId = grubuId;
        F.Events.emit('fiyat:yuklendi', { fiyatGrubuId: grubuId });
    };

    /**
     * Ürün için fiyat hesapla (tekil - modal'lar kullanır)
     */
    F.Fiyat.urunFiyatHesapla = function(urunId, callback) {
        var fiyatGrubuId = F.State.fiyatGrubuId || 0;
        var musteriId = F.State.musteriId || 0;

        if (!fiyatGrubuId) {
            if (callback) callback(null);
            return;
        }

        var url = 'fiyat-hesapla.php?urun_id=' + urunId +
                  '&fiyat_grubu_id=' + fiyatGrubuId +
                  '&musteri_id=' + musteriId;

        F.Helpers.ajaxGet(url, null, function(res) {
            if (res.success && callback) {
                callback({
                    birimFiyat: res.birim_fiyat,
                    hesaplananFiyat: res.hesaplanan_fiyat,
                    kuralVar: res.kural_var,
                    kural: res.kural,
                    kdvOrani: res.kdv_orani,
                    sdKart: res.sd_kart || 0,
                    // Geriye uyumluluk
                    indirimOrani: res.indirim_orani,
                    indirimTutari: res.indirim_tutari,
                    indirimliFiyat: res.indirimli_fiyat
                });
            }
        });
    };

    /**
     * Toplu fiyat hesapla - müşteri değiştiğinde tablodaki tüm ürünler için
     */
    F.Fiyat.topluFiyatHesapla = function() {
        var fiyatGrubuId = F.State.fiyatGrubuId;
        if (!fiyatGrubuId || F.State.satirlar.length === 0) return;

        // Unique ürün ID'leri topla (bayi kendi ürünü kural akışına GİRMEZ → atla)
        var urunMap = {};
        var urunler = [];
        for (var i = 0; i < F.State.satirlar.length; i++) {
            var sat = F.State.satirlar[i];
            if (sat.urunKaynak === 'bayi') continue;
            var uid = sat.urunId;
            if (!urunMap[uid]) {
                urunMap[uid] = true;
                urunler.push({ urun_id: uid, urun_kaynak: 'sunix' });
            }
        }

        $.ajax({
            url: F.Config.ajaxBase + 'toplu-fiyat-hesapla.php',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                fiyat_grubu_id: fiyatGrubuId,
                urunler: urunler
            }),
            dataType: 'json',
            success: function(res) {
                if (!res.success) return;

                // Sonuçları ürün ID'ye göre map'le
                var sonucMap = {};
                for (var j = 0; j < (res.sonuclar || []).length; j++) {
                    var s = res.sonuclar[j];
                    sonucMap[s.urun_id] = s;
                }

                // Satırlara uygula
                for (var k = 0; k < F.State.satirlar.length; k++) {
                    var satir = F.State.satirlar[k];
                    if (satir.urunKaynak === 'bayi') continue; // bayi kendi ürünü kural almaz
                    var sonuc = sonucMap[satir.urunId];
                    if (!sonuc) continue;

                    if (sonuc.kural_var) {
                        // Mevcut baz fiyatı koru, yeni kuralı uygula (0 fiyat geçerli değerdir)
                        var bazFiyat = (satir.normalBirimFiyat != null) ? satir.normalBirimFiyat : sonuc.birim_fiyat;
                        satir.normalBirimFiyat = bazFiyat;
                        satir.birimFiyat = F.Helpers.fiyatKuraliUygula(bazFiyat, sonuc.kural);
                        satir.fiyatKurali = sonuc.kural;
                        satir.sdKart = sonuc.sd_kart || 0;

                        // Tüm varyant fiyatlarına kuralı uygula (0 fiyat geçerli değerdir)
                        if (satir.varyantlar && satir.varyantlar.length > 0) {
                            for (var v = 0; v < satir.varyantlar.length; v++) {
                                var vr = satir.varyantlar[v];
                                var orijFiyat = (vr.normalBirimFiyat != null) ? vr.normalBirimFiyat : ((vr.birimFiyat != null) ? vr.birimFiyat : 0);
                                vr.normalBirimFiyat = orijFiyat;
                                vr.birimFiyat = F.Helpers.fiyatKuraliUygula(orijFiyat, sonuc.kural);
                            }
                        }
                    } else if (satir.fiyatKurali) {
                        // Yeni müşterinin listesinde kural yok → orijinal fiyata dön (0 fiyat geçerli)
                        if (satir.varyantlar && satir.varyantlar.length > 0) {
                            for (var v2 = 0; v2 < satir.varyantlar.length; v2++) {
                                if (satir.varyantlar[v2].normalBirimFiyat != null) {
                                    satir.varyantlar[v2].birimFiyat = satir.varyantlar[v2].normalBirimFiyat;
                                }
                            }
                        }
                        satir.birimFiyat = (satir.normalBirimFiyat != null) ? satir.normalBirimFiyat : sonuc.birim_fiyat;
                        satir.fiyatKurali = null;
                        satir.sdKart = 0;
                    }
                }

                // Tabloyu yeniden çiz
                F.Tablo.tumSatirlariYenidenCiz();

                // Hesaplamayı güncelle
                F.Events.emit('hesaplama:guncelle');
            },
            error: function(xhr, status, err) {
                console.error('[Form.Fiyat] Toplu fiyat hesaplama hatası:', err);
            }
        });
    };

    /**
     * Kuralları temizle - orijinal fiyatlara dön
     */
    F.Fiyat.kurallariTemizle = function() {
        for (var i = 0; i < F.State.satirlar.length; i++) {
            var satir = F.State.satirlar[i];
            if (satir.fiyatKurali && satir.normalBirimFiyat != null) {
                // Tüm varyant fiyatlarını orijinale döndür (0 fiyat geçerli değerdir)
                if (satir.varyantlar && satir.varyantlar.length > 0) {
                    for (var v = 0; v < satir.varyantlar.length; v++) {
                        if (satir.varyantlar[v].normalBirimFiyat != null) {
                            satir.varyantlar[v].birimFiyat = satir.varyantlar[v].normalBirimFiyat;
                        }
                    }
                }
                satir.birimFiyat = satir.normalBirimFiyat;
                satir.fiyatKurali = null;
                satir.sdKart = 0;
            }
        }

        // Tabloyu yeniden çiz
        F.Tablo.tumSatirlariYenidenCiz();

        // Hesaplamayı güncelle
        F.Events.emit('hesaplama:guncelle');
    };

    /**
     * Geçmiş fiyatları yükle
     */
    F.Fiyat.gecmisFiyatYukle = function(urunId, callback) {
        var musteriId = F.State.musteriId || 0;
        var musteriTipi = F.State.musteriTipi || '';

        var url = 'gecmis-fiyatlar.php?urun_id=' + urunId +
                  '&musteri_id=' + musteriId +
                  '&musteri_tipi=' + musteriTipi;

        F.Helpers.ajaxGet(url, null, function(res) {
            if (res.success && callback) {
                callback(res);
            }
        });
    };

})();
