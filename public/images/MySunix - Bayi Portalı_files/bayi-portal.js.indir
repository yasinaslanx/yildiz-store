// ==========================================
// BAYI ARAMA WİDGET FONKSİYONLARI
// ==========================================

let bayiAramaTimeout = null;
let bayiAramaSonuclar = null;

$(document).ready(function() {
    initBayiArama();
});

function initBayiArama() {
    const $widget = $('#bayiSearchWidget');
    const $input = $('#bayiAramaInput');

    if (!$widget.length || !$input.length) return;

    // Sonuç dropdown'ını oluştur
    if (!$('#bayiAramaSonuclar').length) {
        $widget.append(`
            <div class="bayi-search-results" id="bayiAramaSonuclar">
                <div class="search-results-inner">
                    <!-- Sonuçlar buraya gelecek -->
                </div>
            </div>
        `);
    }
    bayiAramaSonuclar = $('#bayiAramaSonuclar');

    // Input olayları
    $input.on('input', function() {
        const aranan = $(this).val().trim();

        // Debounce
        clearTimeout(bayiAramaTimeout);

        if (aranan.length < 2) {
            bayiAramaSonuclar.removeClass('show');
            return;
        }

        bayiAramaTimeout = setTimeout(function() {
            bayiAramaYap(aranan);
        }, 300);
    });

    // Focus/blur olayları
    $input.on('focus', function() {
        if ($(this).val().trim().length >= 2) {
            bayiAramaSonuclar.addClass('show');
        }
    });

    // Dışarı tıklanınca kapat
    $(document).on('click', function(e) {
        if (!$(e.target).closest('#bayiSearchWidget').length) {
            bayiAramaSonuclar.removeClass('show');
        }
    });

    // "/" kısayolu
    $(document).on('keydown', function(e) {
        // Input veya textarea içinde değilse ve "/" tuşuna basılırsa
        if (e.key === '/' && !$(e.target).is('input, textarea, select')) {
            e.preventDefault();
            $input.focus();
        }
        // ESC tuşu
        if (e.key === 'Escape') {
            $input.blur();
            bayiAramaSonuclar.removeClass('show');
        }
    });

    // Sonuç öğelerine tıklama
    $(document).on('click', '.bayi-search-result-item', function(e) {
        e.preventDefault();
        const href = $(this).attr('href');
        if (href && href !== '#') {
            window.location.href = href;
        }
    });
}

function bayiAramaYap(aranan) {
    const $sonuclar = bayiAramaSonuclar.find('.search-results-inner');

    // Loading göster
    $sonuclar.html(`
        <div class="search-loading">
            <i class="icon-loader spinning"></i>
            <span>Aranıyor...</span>
        </div>
    `);
    bayiAramaSonuclar.addClass('show');

    $.ajax({
        url: 'ajax/arama.php',
        type: 'POST',
        dataType: 'json',
        data: { aranan: aranan },
        success: function(response) {
            if (response.success) {
                bayiAramaSonuclariGoster(response.data, aranan);
            } else {
                $sonuclar.html(`
                    <div class="search-empty">
                        <i class="icon-search"></i>
                        <span>${response.message || 'Sonuç bulunamadı'}</span>
                    </div>
                `);
            }
        },
        error: function() {
            $sonuclar.html(`
                <div class="search-empty error">
                    <i class="icon-alert-circle"></i>
                    <span>Arama yapılırken hata oluştu</span>
                </div>
            `);
        }
    });
}

function bayiAramaSonuclariGoster(data, aranan) {
    const $sonuclar = bayiAramaSonuclar.find('.search-results-inner');
    let html = '';

    // Ürünler
    if (data.urunler && data.urunler.length > 0) {
        html += `<div class="search-section">
            <div class="search-section-title">
                <i class="icon-box"></i>
                <span>Ürünler</span>
                <span class="count">${data.urunler.length}</span>
            </div>`;
        data.urunler.forEach(function(urun) {
            const resim = urun.resim ? resimUrl(urun.resim) : resimUrl('images/no-image.jpg');
            html += `
                <a href="index.php?sayfa=urun-detay&id=${urun.id}" class="bayi-search-result-item urun">
                    <img src="${resim}" alt="${urun.urun_adi}" class="result-img">
                    <div class="result-info">
                        <span class="result-title">${highlightText(urun.urun_adi, aranan)}</span>
                        <span class="result-meta">${urun.urun_kodu || ''}</span>
                    </div>
                    <span class="result-price">${formatPara(urun.fiyat, 'USD')}</span>
                </a>`;
        });
        html += `</div>`;
    }

    // Siparişler
    if (data.siparisler && data.siparisler.length > 0) {
        html += `<div class="search-section">
            <div class="search-section-title">
                <i class="icon-shopping-cart"></i>
                <span>Siparişler</span>
                <span class="count">${data.siparisler.length}</span>
            </div>`;
        data.siparisler.forEach(function(siparis) {
            const durumClass = siparis.durum_class || 'bekliyor';
            html += `
                <a href="index.php?sayfa=sunix-siparis&mod=siparis-goruntule&id=${siparis.id}" class="bayi-search-result-item siparis">
                    <div class="result-icon">
                        <i class="icon-shopping-cart"></i>
                    </div>
                    <div class="result-info">
                        <span class="result-title">${highlightText(siparis.siparis_no || '#' + siparis.id, aranan)}</span>
                        <span class="result-meta">${formatTarih(siparis.tarih)}</span>
                    </div>
                    <span class="result-badge ${durumClass}">${siparis.durum || 'Bekliyor'}</span>
                </a>`;
        });
        html += `</div>`;
    }

    // Faturalar
    if (data.faturalar && data.faturalar.length > 0) {
        html += `<div class="search-section">
            <div class="search-section-title">
                <i class="icon-file-text"></i>
                <span>Faturalar</span>
                <span class="count">${data.faturalar.length}</span>
            </div>`;
        data.faturalar.forEach(function(fatura) {
            html += `
                <a href="index.php?sayfa=fatura-detay&id=${fatura.id}" class="bayi-search-result-item fatura">
                    <div class="result-icon">
                        <i class="icon-file-text"></i>
                    </div>
                    <div class="result-info">
                        <span class="result-title">${highlightText(fatura.fatura_no || '#' + fatura.id, aranan)}</span>
                        <span class="result-meta">${formatTarih(fatura.tarih)}</span>
                    </div>
                    <span class="result-amount">${formatPara(fatura.toplam, fatura.para_birimi || 'USD')}</span>
                </a>`;
        });
        html += `</div>`;
    }

    if (!html) {
        html = `
            <div class="search-empty">
                <i class="icon-search"></i>
                <span>"${aranan}" için sonuç bulunamadı</span>
            </div>`;
    }

    $sonuclar.html(html);
}

function highlightText(text, aranan) {
    if (!text || !aranan) return text || '';
    const regex = new RegExp('(' + aranan.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
    return text.replace(regex, '<mark>$1</mark>');
}

// ==========================================
// ÖN SİPARİŞ BİLDİRİM SİSTEMİ
// ==========================================


/**
 * HTML escape fonksiyonu
 */
function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

/**
 * SunixGo Hızlı Satış - Header'dan erişim
 * Token oluşturup yeni sekmede açar
 */
function hizliSatisAc() {
    $.ajax({
        url: 'ajax/sunixgo-bayi-onizleme.php',
        type: 'POST',
        dataType: 'json',
        data: { cihaz_tipi: 'pc' },
        beforeSend: function() {
            Swal.fire({
                title: 'Hazırlanıyor...',
                text: 'SunixGo hızlı satış ekranı açılıyor',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });
        },
        success: function(response) {
            Swal.close();
            if (response.success) {
                window.open(response.url, '_blank');
            } else {
                showError(response.message || 'Hızlı satış ekranı açılamadı.');
            }
        },
        error: function(xhr) {
            Swal.close();
            handleAjaxError(xhr);
        }
    });
}

// Otomatik Tamamlama Engelleme - tutar-formatli ve type=number
$(document).ready(function() {
    function autocompleteKapat(kapsam) {
        (kapsam || document).querySelectorAll('input.tutar-formatli, input[type="number"]')
            .forEach(function(el) { el.setAttribute('autocomplete', 'off'); });
    }
    autocompleteKapat();
    new MutationObserver(function(ml) {
        ml.forEach(function(m) {
            if (m.type === 'childList') {
                m.addedNodes.forEach(function(n) {
                    if (n.nodeType === 1) {
                        if (n.tagName === 'INPUT' && (n.classList.contains('tutar-formatli') || n.type === 'number'))
                            n.setAttribute('autocomplete', 'off');
                        autocompleteKapat(n);
                    }
                });
            }
        });
    }).observe(document.body, { childList: true, subtree: true });
});

// ==========================================
// GLOBAL TUTAR HELPERS (Ana ERP main.js ile aynı imza)
// Format: 1,234,567.89 (binlik ayırıcı virgül, ondalık nokta)
// ==========================================

// Banker's Rounding (Round Half to Even) — ana ERP js/main.js ile BİREBİR aynı.
// ÖNEMLİ: tl-usd-donusum.js ve tahsilat hesaplamaları çıplak bankersRound() çağırır;
// bayi'de global tanımlı olmadığı için ReferenceError veriyordu (USD dönüşümü çalışmıyordu).
// Namespace'li kopyalar (BMD.Helpers/F.Helpers.bankersRound) aynı formülü kullanır.
function bankersRound(num, decimals) {
    var d = decimals || 0;
    var m = Math.pow(10, d);
    var n = num * m;
    var i = Math.floor(n);
    var f = n - i;
    if (Math.abs(f - 0.5) < 0.0000001) {
        return (i % 2 === 0 ? i : i + 1) / m;
    }
    return Math.round(n) / m;
}

function formatTutar(value) {
    if (!value && value !== 0) return '';
    let numStr = String(value).replace(/[^0-9.]/g, '');
    let parts = numStr.split('.');
    if (parts.length > 2) {
        numStr = parts[0] + '.' + parts.slice(1).join('');
    }
    let num = parseFloat(numStr);
    if (isNaN(num)) return '';
    return num.toLocaleString('en-US', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
    });
}

// Kur formatı (4 ondalık) — ana ERP main.js ile birebir.
// ÖNEMLİ: tl-usd-donusum.js bu fonksiyonu kullanır; bayi'de tanımlı olmadığı için
// USD dönüşüm paneli ReferenceError ile kırılıyordu (kur 0 görünmesi). Burada global tanımlı.
function formatKur(value) {
    if (!value && value !== 0) return '';
    var num = parseFloat(String(value).replace(/[^0-9.]/g, ''));
    if (isNaN(num)) return '';
    return num.toFixed(4);
}

function unformatTutar(value) {
    if (value === null || value === undefined || value === '') return 0;
    if (typeof value === 'number') return value;

    var str = String(value);

    // Ayraç çözümü — backend bayiTutarParse (config.php) ile BİREBİR:
    // hem nokta hem virgül varsa SON gelen ondalık ayracıdır.
    var lastDot = str.lastIndexOf('.');
    var lastComma = str.lastIndexOf(',');

    if (lastDot !== -1 && lastComma !== -1) {
        if (lastComma > lastDot) {
            // Avrupa/Türkçe: 1.234,56 (nokta binlik, virgül ondalık)
            str = str.replace(/\./g, '').replace(',', '.');
        } else {
            // ABD: 1,234.56 (virgül binlik)
            str = str.replace(/,/g, '');
        }
    } else if (lastComma !== -1) {
        // Sadece virgül: virgülden sonra <=2 hane ise ondalık, değilse binlik
        var afterComma = str.substring(lastComma + 1).replace(/[^0-9]/g, '');
        if (afterComma.length <= 2) {
            str = str.substring(0, lastComma) + '.' + str.substring(lastComma + 1);
        }
    }

    str = str.replace(/,/g, '');
    str = str.replace(/[^0-9.\-]/g, '');

    var firstDot = str.indexOf('.');
    if (firstDot !== -1) {
        str = str.substring(0, firstDot + 1) + str.substring(firstDot + 1).replace(/\./g, '');
    }

    if (str === '' || str === '-' || str === '.') return 0;

    var result = parseFloat(str);
    return isNaN(result) ? 0 : result;
}

// ==========================================
// CANLI TUTAR INPUT FORMATLAMA (ana ERP js/main.js ile birebir)
// .tutar-formatli sınıfı olan tüm input'larda yazarken canlı formatlar.
// Format: 1,234,567.89 (binlik ayırıcı virgül, ondalık nokta).
// ÖNEMLİ: Bayi portalında bu motor eksikti — inputlar formatlanmıyordu,
// kullanıcı "1.234,56" yazınca PHP str_replace ile bozuluyordu (açılış bakiyesi hatası).
// ==========================================

/**
 * Input'a yazarken canlı formatlama.
 * Binlik ayırıcı (virgül) otomatik eklenir, virgül ondalık olarak yazılırsa noktaya çevrilir.
 */
function formatTutarInput(input) {
    let val = input.value;
    let cursorPos = input.selectionStart || 0;

    // Kullanıcı virgül yazdıysa (cursor'dan hemen önce) ve nokta yoksa → noktaya çevir
    if (cursorPos > 0 && val[cursorPos - 1] === ',' && val.indexOf('.') === -1) {
        val = val.substring(0, cursorPos - 1) + '.' + val.substring(cursorPos);
    }

    // Cursor'dan önceki "gerçek" karakter sayısını say (virgüller hariç)
    let realCharsBefore = 0;
    for (let i = 0; i < cursorPos && i < val.length; i++) {
        if (val[i] !== ',') {
            realCharsBefore++;
        }
    }

    // Tüm virgülleri kaldır (binlik ayırıcıları temizle, yeniden ekleyeceğiz)
    val = val.replace(/,/g, '');
    // Sadece rakam ve nokta kalsın
    val = val.replace(/[^0-9.]/g, '');

    // Birden fazla nokta varsa sadece ilkini tut
    let firstDot = val.indexOf('.');
    if (firstDot !== -1) {
        val = val.substring(0, firstDot + 1) + val.substring(firstDot + 1).replace(/\./g, '');
    }

    // Parçalara ayır
    let parts = val.split('.');

    // Ondalık kısmı 2 haneyle sınırla
    if (parts[1] && parts[1].length > 2) {
        parts[1] = parts[1].substring(0, 2);
    }

    // Tam sayı kısmına binlik ayırıcı ekle
    if (parts[0]) {
        parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    }

    let result = parts.join('.');

    // Değişiklik varsa güncelle
    if (input.value !== result) {
        input.value = result;

        // Yeni cursor pozisyonunu bul (gerçek karakter sayısına göre)
        let newPos = 0;
        let count = 0;
        for (let i = 0; i < result.length; i++) {
            if (count >= realCharsBefore) {
                break;
            }
            if (result[i] !== ',') {
                count++;
            }
            newPos = i + 1;
        }

        newPos = Math.max(0, Math.min(newPos, result.length));

        try {
            input.setSelectionRange(newPos, newPos);
        } catch (e) {}
    }
}

/**
 * Input blur olduğunda tam format uygula (1,234,567.89).
 */
function formatTutarBlur(input) {
    let rawValue = input.value.trim();
    if (rawValue === '') {
        input.value = '';
        return;
    }
    let value = unformatTutar(rawValue);
    input.value = formatTutar(value);
}

// Sayfa yüklendiğinde tutar-formatli event listener'larını bağla
$(document).ready(function() {
    // Input event - yazarken canlı formatlama
    $(document).on('input', '.tutar-formatli', function() {
        formatTutarInput(this);
    });

    // Blur event - focus kaybedince tam format
    $(document).on('blur', '.tutar-formatli', function() {
        formatTutarBlur(this);
    });

    // Focus event - tıklandığında tüm metni seç
    $(document).on('focus', '.tutar-formatli', function() {
        let input = this;
        setTimeout(function() {
            input.select();
        }, 0);
    });

    // Otomatik Tamamlama Engelleme - tutar-formatli ve type=number
    function autocompleteKapat(kapsam) {
        (kapsam || document).querySelectorAll('input.tutar-formatli, input[type="number"]')
            .forEach(function(el) { el.setAttribute('autocomplete', 'off'); });
    }
    autocompleteKapat();
    new MutationObserver(function(ml) {
        ml.forEach(function(m) {
            if (m.type === 'childList') {
                m.addedNodes.forEach(function(n) {
                    if (n.nodeType === 1) {
                        if (n.tagName === 'INPUT' && (n.classList.contains('tutar-formatli') || n.type === 'number'))
                            n.setAttribute('autocomplete', 'off');
                        autocompleteKapat(n);
                    }
                });
            }
        });
    }).observe(document.body, { childList: true, subtree: true });
});

// ==========================================
// PARA GİRİŞİ BİLEŞENİ (dinamik) — PHP bayiParaInput() ile BİREBİR
// JS ile üretilen satır/modallarda kullanılır (toplu ekle, form modülleri vb.).
// Çıktı .bp-para yapısı (sembol + formatlı input). Format: .tutar-formatli/.kur-formatli
// delegation üzerinden (yukarıdaki motor). CSS: css/money-input.css
// ==========================================
function bayiParaInput(o) {
    o = o || {};
    var sembol      = o.sembol || '$';
    var placeholder = (o.placeholder != null) ? o.placeholder : '0.00';
    var kur = !!o.kur;
    var sm  = !!o.sm;
    var fmtClass = kur ? 'kur-formatli' : 'tutar-formatli';

    // value ön-formatla — Avrupa+ABD toleranslı parse (unformatTutar = backend bayiTutarParse ile aynı).
    // Naif parseFloat KULLANMA: "1.234,56" gibi Avrupa formatını bozar (1.23'e düşer).
    var valOut = '';
    if (o.value !== undefined && o.value !== null && o.value !== '') {
        var n = (typeof o.value === 'number')
            ? o.value
            : (typeof unformatTutar === 'function' ? unformatTutar(o.value) : parseFloat(String(o.value).replace(/,/g, '')));
        if (!isNaN(n)) {
            valOut = kur
                ? (typeof formatKur === 'function' ? formatKur(n) : n.toFixed(4))
                : (typeof formatTutar === 'function' ? formatTutar(n) : n.toFixed(2));
        } else {
            valOut = String(o.value);
        }
    }

    var wrap = 'bp-para';
    if (sm)  wrap += ' bp-para--sm';
    if (kur) wrap += ' bp-para--kur';
    if (o.wrapClass) wrap += ' ' + o.wrapClass;

    var inpClass = 'bp-para-inp ' + fmtClass;
    if (o.class) inpClass += ' ' + o.class;

    function esc(s) {
        return String(s == null ? '' : s)
            .replace(/&/g, '&amp;').replace(/"/g, '&quot;')
            .replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    var wrapAttr = o.symWatch ? ' data-sym-watch="' + esc(o.symWatch) + '"' : '';
    var h = '<div class="' + esc(wrap) + '"' + wrapAttr + '>';
    h += '<span class="bp-para-sym">' + esc(sembol) + '</span>';
    h += '<input type="text" inputmode="decimal" class="' + esc(inpClass) + '"';
    if (o.name) h += ' name="' + esc(o.name) + '"';
    if (o.id)   h += ' id="' + esc(o.id) + '"';
    h += ' value="' + esc(valOut) + '"';
    h += ' placeholder="' + esc(placeholder) + '"';
    h += ' autocomplete="off"';
    if (o.required) h += ' required';
    if (o.attrs) h += ' ' + o.attrs; // ham — çağıran güvenli string vermeli
    h += '></div>';
    return h;
}

// Para birimi kodu → sembol (sembol senkronu için)
var BP_PARA_SEMBOL = { TRY: '₺', TL: '₺', USD: '$', USDT: '$', EUR: '€', GBP: '£', CNY: '¥', RMB: '¥' };

// Kur (4 ondalık döviz kuru) inputları — AYRI delegation.
// tutar-formatli (2 ondalık) kullanılmaz; blur'da formatKur (43.1647), focus'ta seç.
$(document).ready(function () {
    $(document).on('blur', '.kur-formatli', function () {
        var v = unformatTutar(this.value);
        this.value = v ? formatKur(v) : '';
    });
    $(document).on('focus', '.kur-formatli', function () {
        var el = this;
        setTimeout(function () { el.select(); }, 0);
    });

    // Sembol senkronu: .bp-para[data-sym-watch="<key>"] → key = select id VEYA radio grup adı.
    // İlgili select/radio değişince eşleşen .bp-para sembolü güncellenir.
    $(document).on('change', 'select, input[type="radio"]', function () {
        var key = this.id || this.name;
        if (!key) return;
        var sym = BP_PARA_SEMBOL[String(this.value).toUpperCase()];
        if (!sym) return;
        document.querySelectorAll('.bp-para[data-sym-watch="' + key + '"] .bp-para-sym').forEach(function (el) {
            el.textContent = sym;
        });
    });
});

// ==========================================
// TAHSİLAT BADGE / ANİMASYON STUB'LARI
// Ana ERP'de #tahsilatBadge sidebar elementine animasyon yapar.
// Bayi sidebar'ında bu element yok; fonksiyonlar zaten badge yoksa erken return ediyor.
// Tahsilat success callback'lerinin kırılmaması için no-op stub yeterli.
// ==========================================

function tahsilatAnimasyonuBaslat(baslangicEl) {
    var badge = document.getElementById('tahsilatBadge');
    if (!badge) return;
    // Bayi tarafında ileride badge eklenirse ana ERP versiyonu kopyalanabilir.
}

function tahsilatBadgeGuncelle() {
    var badge = document.getElementById('tahsilatBadge');
    if (!badge) return;
}

// ==========================================
// TAHSİLAT SATIR DETAY TOGGLE + İPTAL
// Render edilen tablolardan inline onclick ile çağrılır.
// ==========================================

function tahsilatDetayToggle(detayId) {
    var detay = document.getElementById(detayId);
    if (!detay) return;
    var tetik = detay.previousElementSibling;
    if (detay.style.display === 'none' || !detay.style.display) {
        detay.style.display = 'table-row';
        if (tetik) tetik.classList.add('active');
    } else {
        detay.style.display = 'none';
        if (tetik) tetik.classList.remove('active');
    }
}

function tahsilatIptalEt(tahsilatId) {
    if (!tahsilatId) return;
    Swal.fire({
        title: 'Tahsilatı İptal Et',
        text: 'Bu tahsilat iptal edilecek; kasa bakiyesi ve cari hareket geri alınacak. Devam edilsin mi?',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#ef4444',
        cancelButtonColor: '#6b7280',
        confirmButtonText: 'Evet, iptal et',
        cancelButtonText: 'Vazgeç'
    }).then(function (sonuc) {
        if (!sonuc.isConfirmed) return;
        $.ajax({
            url: 'ajax/musteri-detay/tahsilat.php',
            method: 'POST',
            dataType: 'json',
            data: { islem: 'tahsilat-iptal', tahsilat_id: tahsilatId },
            success: function (r) {
                if (r.success) {
                    Swal.fire({ icon: 'success', title: 'İptal Edildi', timer: 1500, showConfirmButton: false });
                    if (window.BayiMusteriDetay) {
                        var BMD = window.BayiMusteriDetay;
                        BMD.Ozet && BMD.Ozet.yukle();
                        BMD.Ozet && BMD.Ozet.musteriHeaderYukle();
                        BMD.Tahsilat && BMD.Tahsilat.listeYukle && BMD.Tahsilat.listeYukle();
                        BMD.CariEkstre && BMD.CariEkstre.yukle();
                    }
                } else {
                    Swal.fire({ icon: 'error', title: 'Hata', text: r.message || 'İptal edilemedi' });
                }
            },
            error: function () {
                Swal.fire({ icon: 'error', title: 'Hata', text: 'Sunucu hatası' });
            }
        });
    });
}
