console.log('[Bayi Portal] layout-wrap sınıfları:', document.querySelector('.layout-wrap')?.className);

// Sunix ana site base URL - proxy sistemi için tüm resim/asset URL'leri bu prefix ile başlamalı
const SUNIX_BASE_URL = 'https://sunixhub.com/';

/**
 * Resim URL'sini tam URL'ye çevir
 * Proxy sistemi nedeniyle relative URL'ler çalışmaz, bu fonksiyon tüm URL'leri absolute yapar
 * @param {string} url - Resim URL'si (relative veya absolute)
 * @returns {string} - Tam URL
 */
function resimUrl(url) {
    if (!url) return '';
    if (url.startsWith('http://') || url.startsWith('https://') || url.startsWith('data:')) {
        return url;
    }
    var p = url.replace(/^\/+/, '');
    // uploads/ ve upload/ bayi/.htaccess rewrite ile same-origin servis edilir —
    // cross-origin sunixhub.com istekleri Chrome Local Network Access engeline takılabiliyor
    if (p.indexOf('uploads/') === 0 || p.indexOf('upload/') === 0) return p;
    return SUNIX_BASE_URL + p;
}

/**
 * Asset URL'sini tam URL'ye çevir (CSS, JS, resim vb.)
 * @param {string} path - Asset path
 * @returns {string} - Tam URL
 */
function assetUrl(path) {
    if (!path) return '';
    if (path.startsWith('http://') || path.startsWith('https://') || path.startsWith('data:')) {
        return path;
    }
    var p = path.replace(/^\/+/, '');
    if (p.indexOf('uploads/') === 0 || p.indexOf('upload/') === 0) return p;
    return SUNIX_BASE_URL + p;
}

