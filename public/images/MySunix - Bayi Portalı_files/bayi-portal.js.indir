// Personel Modu Çıkışı (üst banttaki "Personel Çıkışı" butonu için)
function personelImpersonationCikis() {
    Swal.fire({
        title: 'Personel Modundan Çık',
        text: 'Ana ERP\'ye dönmek istediğinize emin misiniz?',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#dc2626',
        cancelButtonColor: '#6b7280',
        confirmButtonText: 'Evet, Çık',
        cancelButtonText: 'İptal'
    }).then((result) => {
        if (!result.isConfirmed) return;
        $.ajax({
            url: 'ajax/personel-cikis.php',
            type: 'POST',
            dataType: 'json',
            data: { islem: 'cikis' },
            success: function(r) {
                window.location.href = r && r.redirect ? r.redirect : 'https://sunixhub.com/';
            },
            error: function() {
                window.location.href = 'https://sunixhub.com/';
            }
        });
    });
}

// Bayi → şoför geçişinden "Bayiye Dön" (aynı-domain oturum köprüsü).
// Cookie değişimi + yönlendirme SUNUCU-TARAFI (Set-Cookie + 302) yapılır → fetch cookie-yarışı
// ("too many redirects") önlenir. Onaydan sonra TOP-LEVEL form POST ile gidilir.
function servisBayiyeDon() {
    Swal.fire({
        title: 'Bayiye Dön',
        text: 'Şoför modundan çıkıp bayi yönetimine dönmek istiyor musunuz?',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#103595',
        cancelButtonColor: '#6b7280',
        confirmButtonText: 'Evet, Dön',
        cancelButtonText: 'İptal'
    }).then((result) => {
        if (!result.isConfirmed) return;
        var form = document.createElement('form');
        form.method = 'POST';
        form.action = 'ajax/servis-gecis-cikis.php';
        document.body.appendChild(form);
        form.submit();
    });
}

// Impersonation bandı: sessionStorage kontrolü + kapatma butonu
(function() {
    var bant = document.getElementById('bpImpBant');
    if (!bant) return;

    if (sessionStorage.getItem('bp_imp_bant_kapali') === '1') {
        bant.classList.add('bp-imp-bant--gizli');
        return;
    }

    var kapatBtn = document.getElementById('bpImpBantKapat');
    if (kapatBtn) {
        kapatBtn.addEventListener('click', function() {
            bant.classList.add('bp-imp-bant--kapaniyor');
            bant.addEventListener('animationend', function() {
                bant.classList.add('bp-imp-bant--gizli');
            }, { once: true });
            sessionStorage.setItem('bp_imp_bant_kapali', '1');
        });
    }
})();

// Çıkış Yap
function bayiCikisYap() {
    // Bayi → şoför geçiş oturumu: "Çıkış" yerine bayiye dön
    if (window.bpIsBayiGecis) {
        servisBayiyeDon();
        return;
    }
    if (document.getElementById('bpImpBant')) {
        Swal.fire({
            icon: 'info',
            title: 'Personel Modu Aktif',
            html: 'Bu bayi oturumu <b>personel modundadır</b>.<br>Sağ alttaki <b>Personel Çıkışı</b> butonunu kullanın (gizlediyseniz sayfayı yenileyin).',
            confirmButtonColor: '#dc2626',
            confirmButtonText: 'Anladım'
        });
        return;
    }

    Swal.fire({
        title: 'Çıkış Yap',
        text: 'Oturumunuzu kapatmak istediğinize emin misiniz?',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#103595',
        cancelButtonColor: '#6b7280',
        confirmButtonText: 'Evet, Çıkış Yap',
        cancelButtonText: 'İptal'
    }).then((result) => {
        if (result.isConfirmed) {
            $.ajax({
                url: 'ajax/login.php',
                type: 'POST',
                dataType: 'json',
                data: { islem: 'cikis' },
                success: function(response) {
                    if (response.is_impersonation) {
                        // Backend impersonation tespit etti — banner butonunu göster
                        Swal.fire({
                            icon: 'info',
                            title: 'Personel Modu',
                            text: response.message,
                            confirmButtonColor: '#dc2626'
                        });
                        return;
                    }
                    window.location.href = 'giris.php';
                },
                error: function() {
                    window.location.href = 'giris.php';
                }
            });
        }
    });
}

// Para formatı
function formatPara(tutar, birim = 'USD') {
    const semboller = { 'USD': '$', 'EUR': '€', 'TRY': '₺' };
    return new Intl.NumberFormat('tr-TR', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
    }).format(tutar) + ' ' + (semboller[birim] || birim);
}

// Tarih formatı
function formatTarih(tarih) {
    if (!tarih) return '-';
    return new Date(tarih).toLocaleDateString('tr-TR', {
        day: '2-digit', month: '2-digit', year: 'numeric',
        hour: '2-digit', minute: '2-digit'
    });
}

// Loading göster
function showLoading(msg = 'Yükleniyor...') {
    Swal.fire({
        title: msg,
        allowOutsideClick: false,
        didOpen: () => Swal.showLoading()
    });
}

// Loading gizle
function hideLoading() {
    Swal.close();
}

// Başarılı mesaj
function showSuccess(msg, callback) {
    Swal.fire({
        title: 'Başarılı!',
        text: msg,
        icon: 'success',
        confirmButtonColor: '#103595'
    }).then(() => {
        if (callback) callback();
    });
}

// Hata mesajı
function showError(msg) {
    Swal.fire({
        title: 'Hata!',
        text: msg,
        icon: 'error',
        confirmButtonColor: '#103595'
    });
}

// Onay modalı
function showConfirm(title, text, callback) {
    Swal.fire({
        title: title,
        text: text,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#103595',
        cancelButtonColor: '#6b7280',
        confirmButtonText: 'Evet',
        cancelButtonText: 'İptal'
    }).then((result) => {
        if (result.isConfirmed && callback) {
            callback();
        }
    });
}

// AJAX hata yönetimi
function handleAjaxError(xhr, status, error) {
    console.error('AJAX Error:', status, error);
    let errorMsg = 'Bir hata oluştu. Lütfen tekrar deneyin.';

    if (xhr.responseJSON && xhr.responseJSON.message) {
        errorMsg = xhr.responseJSON.message;
    } else if (xhr.status === 401) {
        errorMsg = 'Oturumunuz sonlanmış. Lütfen tekrar giriş yapın.';
        setTimeout(() => window.location.href = 'giris.php', 2000);
    } else if (xhr.status === 403) {
        errorMsg = 'Bu işlem için yetkiniz bulunmuyor.';
    } else if (xhr.status === 500) {
        errorMsg = 'Sunucu hatası oluştu. Lütfen daha sonra tekrar deneyin.';
    }

    showError(errorMsg);
}

