/**
 * Form - Dirty State Tracking (Form Kaybı Önleme)
 * Kullanıcı formda değişiklik yaptığında sayfa çıkışını engeller.
 */
(function() {
    'use strict';

    var F = window.Form;

    F.Dirty = {};

    var kirli = false;
    var aktif = true;

    /**
     * Init
     */
    F.Dirty.init = function() {
        // Readonly modda devre dışı
        if (F.Config.readonly) {
            aktif = false;
            return;
        }

        // Event bus dinle
        F.Events.on('satir:eklendi', function() { F.Dirty.pisBirak(); });
        F.Events.on('satir:silindi', function() { F.Dirty.pisBirak(); });
        F.Events.on('satir:guncellendi', function() { F.Dirty.pisBirak(); });
        F.Events.on('musteri:secildi', function() { F.Dirty.pisBirak(); });
        F.Events.on('musteri:temizlendi', function() { F.Dirty.pisBirak(); });

        // Not alanı ve tarih alanları input/change event dinle
        var alanlar = ['frmNot', 'frmTarih', 'frmSaat', 'frmSevkTarih', 'frmVade', 'frmKdvOrani'];
        alanlar.forEach(function(id) {
            var el = document.getElementById(id);
            if (el) {
                el.addEventListener('input', function() { F.Dirty.pisBirak(); });
                el.addEventListener('change', function() { F.Dirty.pisBirak(); });
            }
        });

        // beforeunload event (tarayıcı kapanma/yenileme)
        window.addEventListener('beforeunload', function(e) {
            if (kirli && aktif) {
                if (F.OtomatikKayit && (F.OtomatikKayit.durum === 'kaydedildi' || F.OtomatikKayit.durum === 'kaydediliyor')) return;
                e.preventDefault();
                e.returnValue = '';
            }
        });

        // Menü linkleri intercept
        F.Dirty.menuIntercept();
    };

    /**
     * Menü linkleri intercept - tıklamada uyarı göster
     */
    F.Dirty.menuIntercept = function() {
        // Sol menü ve header linkleri
        var selectors = '.section-menu-left a[href], .header-dashboard a[href]';

        document.addEventListener('click', function(e) {
            if (!kirli || !aktif) return;
            if (F.OtomatikKayit && F.OtomatikKayit.durum === 'kaydedildi') return;

            var link = e.target.closest(selectors);
            if (!link) return;

            var href = link.getAttribute('href');
            if (!href || href === '#' || href.startsWith('javascript:')) return;

            e.preventDefault();
            e.stopPropagation();

            Swal.fire({
                icon: 'warning',
                title: 'Kaydedilmemiş Değişiklikler',
                text: 'Formdaki değişiklikler kaydedilmedi. Sayfadan ayrılmak istediğinize emin misiniz?',
                showCancelButton: true,
                confirmButtonText: 'Evet, Ayrıl',
                cancelButtonText: 'Kalarak Devam Et',
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#103595'
            }).then(function(result) {
                if (result.isConfirmed) {
                    aktif = false;
                    kirli = false;
                    window.location.href = href;
                }
            });
        }, true);
    };

    /**
     * Formu kirli olarak işaretle
     */
    F.Dirty.pisBirak = function() {
        if (!aktif) return;
        kirli = true;
        if (F.OtomatikKayit && F.OtomatikKayit.tetikle) {
            F.OtomatikKayit.tetikle();
        }
    };

    /**
     * Dirty state temizle (kayıt sonrası çağrılır)
     */
    F.Dirty.temizle = function() {
        kirli = false;
    };

    /**
     * Dirty state kontrolü
     */
    F.Dirty.kirliMi = function() {
        return kirli;
    };

})();
