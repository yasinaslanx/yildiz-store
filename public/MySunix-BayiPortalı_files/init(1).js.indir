/**
 * Form - Sayfa Başlatma
 * Mod algılama, event binding, modül init
 */
(function() {
    'use strict';

    var F = window.Form;

    F.Init = {};

    F.Init.basla = function() {
        // Satış ekranı görünüm ayarı: fiyat listesi indirim/zam rozeti + üstü çizili liste
        // fiyatı gizleme. FormConfig.indirimZamGizle YALNIZCA Mağazam satışında (form.php)
        // set edilir; Sunix Merkez (sunix-siparis.php) tarafında tanımsızdır → etkilenmez.
        if (window.FormConfig && window.FormConfig.indirimZamGizle) {
            document.body.classList.add('frm-fiyat-gizli');
        }

        // Bayi konteksti: müşteri = bayi otomatik
        if (F.Config.isBayi && window._bayiAutoMusteri) {
            var bm = window._bayiAutoMusteri;
            F.State.musteriId = bm.id;
            F.State.musteriTipi = 'bayi';
            F.State.musteriAdi = bm.adi;
            F.State.fiyatGrubuId = bm.fiyatGrubuId;
            F.State.fiyatGrubuAdi = bm.fiyatGrubuAdi || '';
            F.State.paraBirimi = bm.paraBirimi || 'USD';
            F.State.vadeGun = bm.vadeGun || 0;
            // NOT: indirimYuzde set edilmez — ERP musteri.js de set etmez.
            // İndirim fiyat grubu kuralları üzerinden uygulanır (çift indirim önleme).
        }

        // Layout (sticky panel)
        if (F.Layout && F.Layout.init) F.Layout.init();

        // Müşteri arama widget
        if (F.Musteri && F.Musteri.init) F.Musteri.init();

        // Ürün arama
        if (F.UrunArama && F.UrunArama.init) F.UrunArama.init();

        // Tablo
        if (F.Tablo && F.Tablo.init) F.Tablo.init();
        if (F.TabloVaryant && F.TabloVaryant.init) F.TabloVaryant.init();
        if (F.TabloHover && F.TabloHover.init) F.TabloHover.init();
        if (F.TabloToggle && F.TabloToggle.init) F.TabloToggle.init();
        if (F.TabloNot && F.TabloNot.init) F.TabloNot.init();
        if (F.Gruplama && F.Gruplama.init) F.Gruplama.init();

        // Hesaplama
        if (F.Hesaplama && F.Hesaplama.init) F.Hesaplama.init();

        // Döviz
        if (F.Doviz && F.Doviz.init) F.Doviz.init();

        // Fiyat
        if (F.Fiyat && F.Fiyat.init) F.Fiyat.init();

        // Fiyat Listesi Dropdown (manuel seçim UI)
        if (F.FiyatListesiDropdown && F.FiyatListesiDropdown.init) F.FiyatListesiDropdown.init();

        // Hızlı İndirim (Mağazam: kuralsız liste fiyatında toplu indirim)
        if (F.HizliIndirim && F.HizliIndirim.init) F.HizliIndirim.init();

        // Modaller
        if (F.Modal && F.Modal.init) F.Modal.init();
        if (F.ModalDuz && F.ModalDuz.init) F.ModalDuz.init();
        if (F.ModalVaryant && F.ModalVaryant.init) F.ModalVaryant.init();
        if (F.ModalKilif && F.ModalKilif.init) F.ModalKilif.init();

        // Dirty state tracking (form kaybı önleme)
        if (F.Dirty && F.Dirty.init) F.Dirty.init();

        // Kaydet
        if (F.Kaydet && F.Kaydet.init) F.Kaydet.init();

        // Durum Bar (sipariş aşamaları progress)
        if (F.DurumBar && F.DurumBar.init) F.DurumBar.init();

        // Aksiyonlar (iptal vb.)
        if (F.AksiyonIptal && F.AksiyonIptal.init) F.AksiyonIptal.init();

        // Aksiyonlar (kopyala)
        if (F.AksiyonKopyala && F.AksiyonKopyala.init) F.AksiyonKopyala.init();

        // Aksiyonlar (sıfırla)
        if (F.AksiyonSifirla && F.AksiyonSifirla.init) F.AksiyonSifirla.init();

        // Aksiyonlar (onayla)
        if (F.AksiyonOnayla && F.AksiyonOnayla.init) F.AksiyonOnayla.init();

        // Aksiyonlar (yazdır)
        if (F.AksiyonYazdir && F.AksiyonYazdir.init) F.AksiyonYazdir.init();

        // Kargo Bilgileri (sadece görüntüleme modunda)
        if (F.KargoBilgi && F.KargoBilgi.init) F.KargoBilgi.init();

        // Hazırlama Bilgileri (sadece görüntüleme modunda)
        if (F.HazirlamaBilgi && F.HazirlamaBilgi.init) F.HazirlamaBilgi.init();

        // Koli Bilgileri (sadece görüntüleme modunda)
        if (F.KoliBilgi && F.KoliBilgi.init) F.KoliBilgi.init();

        // Sipariş Geçmişi (sadece görüntüleme modunda)
        if (F.Gecmis && F.Gecmis.init) F.Gecmis.init();

        // Miktar Değişikliği Uyarısı (sadece görüntüleme modunda)
        if (F.MiktarUyari && F.MiktarUyari.init) F.MiktarUyari.init();

        // İade kategori seçimi (sadece iade modunda)
        if (F.State.isIade) F.Init.iadeKategoriInit();

        // İade ek alanları (sadece iade modunda)
        if (F.IadeAlanlari && F.IadeAlanlari.init) F.IadeAlanlari.init();

        // Ön sipariş alanları (sadece ön sipariş modunda)
        if (F.OnSiparisAlanlari && F.OnSiparisAlanlari.init) F.OnSiparisAlanlari.init();

        // Ön talep modal (siparis-yeni modunda)
        if (F.OnTalep && F.OnTalep.init) F.OnTalep.init();

        // Sevkiyat alanları (sadece sevkiyat modunda)
        if (F.SevkiyatAlanlari && F.SevkiyatAlanlari.init) F.SevkiyatAlanlari.init();

        // Kampanya alanları (sadece kampanya modunda)
        if (F.KampanyaAlanlari && F.KampanyaAlanlari.init) F.KampanyaAlanlari.init();

        // Çin sipariş alanları (sadece çin sipariş modunda)
        if (F.CinSiparisAlanlari && F.CinSiparisAlanlari.init) F.CinSiparisAlanlari.init();

        // Kampanya otomatik uygulama (sipariş modunda)
        if (F.Kampanya && F.Kampanya.init) F.Kampanya.init();

        // Kampanya hediye UI (sipariş modunda)
        if (F.KampanyaUI && F.KampanyaUI.init) F.KampanyaUI.init();

        // Tarih ve saat alanları
        F.Init.tarihInit();

        // Otomatik kayıt (sepet koruma)
        if (F.OtomatikKayit && F.OtomatikKayit.init) F.OtomatikKayit.init();

        // Mod bazlı düzenleme/yükleme — sepet auto-load veya mevcut sipariş
        if (F.Config.mod === 'siparis-yeni' && !F.Config.kopyalaId && F.Config.isBayi && F.OtomatikKayit && F.OtomatikKayit.sepetKontrol) {
            F.OtomatikKayit.sepetKontrol(function(sepetId) {
                if (sepetId && F.State.satirlar.length === 0 && !(F.Dirty && F.Dirty.kirliMi())) {
                    F.Config.id = sepetId;
                    F.Config.mod = 'siparis-duzenle';
                    if (F.Yukle && F.Yukle.init) F.Yukle.init();
                }
            });
        } else if ((F.State.id || F.Config.kopyalaId) && F.Yukle && F.Yukle.init) {
            F.Yukle.init();
        }

        // URL'den gelen bayi_id ile müşteri otomatik seçimi (bayi-musteri-detay → form yönlendirmesi)
        if (F.Config.autoMusteri && !F.State.id && !F.Config.kopyalaId) {
            var am = F.Config.autoMusteri;
            F.Musteri.set({
                id: am.id,
                tip: am.tip,
                adi: am.adi,
                fiyat_grubu_id: am.fiyat_grubu_id,
                fiyat_grubu_adi: am.fiyat_grubu_adi,
                fiyat_liste_tipi: am.fiyat_liste_tipi
            });
            F.State.paraBirimi = am.para_birimi || 'USD';
            F.State.kdvDahil = am.kdv_dahil || 'hayir';
            F.State.musteriKdvOrani = am.kdv_orani || 0;
            F.State.vadeGun = am.vade || 0;

            var kdvInp = document.getElementById('frmKdvOrani');
            if (kdvInp) {
                kdvInp.value = (am.kdv_dahil === 'evet') ? (am.kdv_orani || 0) : 0;
            }
            if (am.vade > 0) {
                F.Events.emit('siparis-tarihi:degisti');
            }

            F.Events.emit('musteri:secildi', {
                id: am.id,
                tip: am.tip,
                adi: am.adi,
                fiyatGrubuId: am.fiyat_grubu_id,
                paraBirimi: am.para_birimi,
                kdvDahil: am.kdv_dahil || 'hayir',
                kdvOrani: am.kdv_orani || 0,
                vade: am.vade
            });
        }

        // Bayi konteksti: tüm modüller init olduktan sonra musteri:secildi emit et
        // Bu sayede F.Doviz (TL modu), F.Fiyat (fiyat grubu), F.Hesaplama (KDV) düzgün çalışır
        if (F.Config.isBayi && window._bayiAutoMusteri) {
            var bm = window._bayiAutoMusteri;

            // KDV input'unu ata (musteri.js sec() fonksiyonunun yaptığı gibi)
            var kdvInp = document.getElementById('frmKdvOrani');
            if (kdvInp) {
                var kdvOrani = (bm.kdvDahil === 'evet') ? (parseFloat(bm.kdvOrani) || 0) : 0;
                kdvInp.value = kdvOrani;
            }

            // Vade hesapla
            if (bm.vadeGun && bm.vadeGun > 0) {
                F.State.vadeGun = bm.vadeGun;
                F.Events.emit('siparis-tarihi:degisti');
            }

            // musteri:secildi emit — Doviz, Fiyat, Hesaplama modülleri dinliyor
            F.Events.emit('musteri:secildi', {
                id: bm.id,
                tip: 'bayi',
                adi: bm.adi,
                fiyatGrubuId: bm.fiyatGrubuId,
                paraBirimi: bm.paraBirimi,
                kdvDahil: bm.kdvDahil || 'hayir',
                kdvOrani: parseFloat(bm.kdvOrani) || 0,
                vade: bm.vadeGun
            });
        }

    };

    /**
     * İade Kategorisi init
     */
    F.Init.iadeKategoriInit = function() {
        var wrap = document.getElementById('frmIadeKategori');
        if (!wrap) return;

        var btns = wrap.querySelectorAll('.frm-iade-kat-btn');
        var banner = document.getElementById('frmIadeKatBanner');
        var bannerText = document.getElementById('frmIadeKatBannerText');
        var isDuzenle = (F.Config.mod === 'iade-duzenle');

        var bannerMetinleri = {
            normal: '\u00dcr\u00fcn iadesi \u2014 Varyant bilgileriyle girilir.',
            arizali: 'Ar\u0131zal\u0131 iade \u2014 Varyant se\u00e7imi gerekmez, ar\u0131za deposuna aktar\u0131l\u0131r.'
        };

        function guncelle(kat) {
            F.State.iadeKategorisi = kat;
            F.Config.iadeKategorisi = kat;
            btns.forEach(function(b) {
                b.classList.toggle('active', b.getAttribute('data-kat') === kat);
            });
            if (bannerText) bannerText.textContent = bannerMetinleri[kat] || '';
            if (banner) {
                banner.classList.toggle('arizali', kat === 'arizali');
            }
        }

        // Düzenleme modunda butonları kilitle
        if (isDuzenle) {
            btns.forEach(function(b) { b.classList.add('locked'); });
        } else {
            btns.forEach(function(b) {
                b.addEventListener('click', function() {
                    var yeniKat = this.getAttribute('data-kat');
                    if (yeniKat === F.State.iadeKategorisi) return;

                    // Tabloda ürün varsa uyar
                    if (F.State.satirlar.length > 0) {
                        Swal.fire({
                            title: '\u0130ade kategorisi de\u011fi\u015ftirilecek',
                            text: 'Kategorinin de\u011fi\u015ftirilmesi tablodaki \u00fcr\u00fcnleri temizleyecektir. Devam etmek istiyor musunuz?',
                            icon: 'warning',
                            showCancelButton: true,
                            confirmButtonText: 'Evet, de\u011fi\u015ftir',
                            cancelButtonText: '\u0130ptal',
                            confirmButtonColor: '#dc2626'
                        }).then(function(result) {
                            if (result.isConfirmed) {
                                // Tüm satırları temizle
                                F.State.satirlar = [];
                                F.State.satirSayaci = 0;
                                var tbody = document.getElementById('frmTbody');
                                if (tbody) tbody.innerHTML = '';
                                F.Tablo.bosKontrol();
                                F.Events.emit('hesaplama:guncelle');
                                guncelle(yeniKat);
                            }
                        });
                    } else {
                        guncelle(yeniKat);
                    }
                });
            });
        }

        // İlk değeri ata
        guncelle(F.State.iadeKategorisi);
    };

    /**
     * Tarih ve saat alanları init (tümü flatpickr)
     */
    F.Init.tarihInit = function() {
        if (typeof flatpickr === 'undefined') return;

        var now = new Date();

        // Sipariş modunda bayi sipariş tarihine/saatine müdahale edemez (kilit)
        var sipTarihKilit = !!(window.FormConfig && window.FormConfig.siparisTarihKilit);

        // Sipariş/İade Tarihi — sipariş modunda KİLİTLİ (takvim açılmaz), iadede düzenlenebilir
        flatpickr('#frmTarih', {
            locale: 'tr',
            dateFormat: 'd.m.Y',
            defaultDate: now,
            clickOpens: !sipTarihKilit,
            onChange: function() {
                // Sipariş tarihi değiştiğinde vadeyi yeniden hesapla
                if (F.State.vadeGun && F.State.vadeGun > 0) {
                    F.Events.emit('siparis-tarihi:degisti');
                }
            }
        });

        // Sipariş/İade Saati — sipariş modunda KİLİTLİ, iadede düzenlenebilir
        flatpickr('#frmSaat', {
            locale: 'tr',
            enableTime: true,
            noCalendar: true,
            dateFormat: 'H:i',
            time_24hr: true,
            defaultDate: now,
            clickOpens: !sipTarihKilit
        });

        // Sevk Tarihi — düzenlenebilir, bugün varsayılan
        flatpickr('#frmSevkTarih', {
            locale: 'tr',
            dateFormat: 'd.m.Y',
            defaultDate: now
        });

        // Vadesi — düzenlenebilir
        flatpickr('#frmVade', {
            locale: 'tr',
            dateFormat: 'd.m.Y'
        });
    };

    // DOM hazır olduğunda başlat
    $(document).ready(function() {
        F.Init.basla();
        F.Events.emit('form:hazir');
    });

})();
