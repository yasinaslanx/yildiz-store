(function() {
    'use strict';
    var F = window.Form;
    if (!F || !F.Pos) return;

    F.Pos.Grid = {};

    var _observer = null;
    var _aramaTimer = null;

    F.Pos.Grid.init = function() {
        var sentinel = document.getElementById('frmPosGridSentinel');
        if (sentinel && 'IntersectionObserver' in window) {
            _observer = new IntersectionObserver(function(entries) {
                if (entries[0].isIntersecting && !F.Pos.State.sonSayfa && !F.Pos.State.yukleniyor) {
                    F.Pos.Grid.yukle(F.Pos.State.sayfa + 1);
                }
            }, { rootMargin: '200px', root: document.getElementById('frmPosGridScroll') });
            _observer.observe(sentinel);
        }

        var aramaInput = document.getElementById('frmPosArama');
        if (aramaInput) {
            var _barkodBuffer = '';
            var _barkodSonKarakter = 0;
            var _barkodTimer = null;

            var _barkodSonTetik = 0;

            function _barkodTetikle(kod) {
                if (!kod || kod.length < 3) return;
                if (!F.Barkod || !F.Barkod.ara) return;
                var now = Date.now();
                if (now - _barkodSonTetik < 300) return;
                _barkodSonTetik = now;
                clearTimeout(_aramaTimer);
                F.Barkod.ara(kod);
                aramaInput.value = '';
                F.Pos.State.aramaQuery = '';
                F.Pos.State.sifirlaUrunler();
                F.Pos.Grid.temizle();
                F.Pos.Grid.yukle(1);
            }

            aramaInput.addEventListener('input', function() {
                var now = Date.now();
                var val = aramaInput.value;

                if (val.indexOf('\n') !== -1 || val.indexOf('\r') !== -1) {
                    var kod = val.replace(/[\r\n]/g, '').trim();
                    _barkodTetikle(kod);
                    _barkodBuffer = '';
                    return;
                }

                if (now - _barkodSonKarakter < 50) {
                    _barkodBuffer = val.trim();
                    clearTimeout(_barkodTimer);
                    _barkodTimer = setTimeout(function() {
                        if (_barkodBuffer.length >= 5) {
                            _barkodTetikle(_barkodBuffer);
                        }
                        _barkodBuffer = '';
                    }, 80);
                    _barkodSonKarakter = now;
                    clearTimeout(_aramaTimer);
                    return;
                }
                _barkodSonKarakter = now;
                _barkodBuffer = '';

                clearTimeout(_aramaTimer);
                var q = val.trim();
                _aramaTimer = setTimeout(function() {
                    F.Pos.State.aramaQuery = q;
                    F.Pos.State.sifirlaUrunler();
                    F.Pos.Grid.temizle();
                    F.Pos.Grid.yukle(1);
                }, F.Pos.Config.aramaDebounce);
            });

            aramaInput.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    aramaInput.value = '';
                    if (F.Pos.State.aramaQuery !== '') {
                        F.Pos.State.aramaQuery = '';
                        F.Pos.State.sifirlaUrunler();
                        F.Pos.Grid.temizle();
                        F.Pos.Grid.yukle(1);
                    }
                    e.stopPropagation();
                    return;
                }
                if (e.ctrlKey && (e.keyCode === 77 || e.keyCode === 74)) {
                    e.preventDefault();
                    e.stopPropagation();
                    var val = aramaInput.value.replace(/[\r\n]/g, '').trim();
                    _barkodTetikle(val);
                    return;
                }
                if (e.key === 'Enter' || e.keyCode === 13) {
                    e.preventDefault();
                    var val = aramaInput.value.replace(/[\r\n]/g, '').trim();
                    _barkodTetikle(val);
                }
            });

            aramaInput.addEventListener('keypress', function(e) {
                if (e.charCode === 10 || e.charCode === 13) {
                    e.preventDefault();
                    e.stopPropagation();
                    var val = aramaInput.value.replace(/[\r\n]/g, '').trim();
                    _barkodTetikle(val);
                }
            });
        }

        var siralamaBtn = document.getElementById('frmPosSiralamaBtn');
        var siralamaDropdown = document.getElementById('frmPosSiralamaDropdown');

        if (siralamaBtn && siralamaDropdown) {
            var saved = F.Pos.State.siralama;
            siralamaDropdown.querySelectorAll('.frm-pos-siralama-item').forEach(function(el) {
                el.classList.toggle('active', el.getAttribute('data-sort') === saved);
            });

            siralamaBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                var isOpen = siralamaDropdown.classList.contains('open');
                siralamaDropdown.classList.toggle('open', !isOpen);
                siralamaBtn.classList.toggle('active', !isOpen);
            });

            siralamaDropdown.addEventListener('click', function(e) {
                var item = e.target.closest('.frm-pos-siralama-item');
                if (!item) return;
                e.stopPropagation();

                var sort = item.getAttribute('data-sort');
                if (sort === F.Pos.State.siralama) {
                    siralamaDropdown.classList.remove('open');
                    siralamaBtn.classList.remove('active');
                    return;
                }

                siralamaDropdown.querySelectorAll('.frm-pos-siralama-item').forEach(function(el) {
                    el.classList.toggle('active', el.getAttribute('data-sort') === sort);
                });

                F.Pos.State.siralama = sort;
                localStorage.setItem('frm_pos_siralama', sort);
                siralamaDropdown.classList.remove('open');
                siralamaBtn.classList.remove('active');

                F.Pos.State.sifirlaUrunler();
                F.Pos.Grid.temizle();
                F.Pos.Grid.yukle(1);
            });

            document.addEventListener('click', function(e) {
                if (!e.target.closest('.frm-pos-siralama-wrap')) {
                    siralamaDropdown.classList.remove('open');
                    siralamaBtn.classList.remove('active');
                }
            });
        }
    };

    F.Pos.Grid.yukle = function(sayfa) {
        if (F.Pos.State.yukleniyor || F.Pos.State.sonSayfa) return;
        F.Pos.State.yukleniyor = true;

        var loadingEl = document.getElementById('frmPosYukleniyor');
        var bosEl = document.getElementById('frmPosBos');
        if (loadingEl) loadingEl.style.display = '';
        if (bosEl) bosEl.style.display = 'none';

        var aramaVar = F.Pos.State.aramaQuery && F.Pos.State.aramaQuery.length >= 2;

        F.Helpers.ajaxPost(F.Pos.Config.ajaxUrl, {
            aksiyon: 'urunler',
            kategori_id: aramaVar ? '' : (F.Pos.State.aktifKategoriId || ''),
            sayfa: sayfa,
            limit: F.Pos.Config.gridLimit,
            q: F.Pos.State.aramaQuery,
            siralama: F.Pos.State.siralama
        }, function(res) {
            F.Pos.State.yukleniyor = false;
            if (loadingEl) loadingEl.style.display = 'none';

            if (res.success) {
                F.Pos.State.sayfa = sayfa;
                F.Pos.State.sonSayfa = res.son_sayfa;
                F.Pos.State.urunler = F.Pos.State.urunler.concat(res.urunler);
                F.Pos.Grid.render(res.urunler, sayfa > 1);

                if (F.Pos.State.urunler.length === 0 && bosEl) {
                    bosEl.style.display = '';
                }
            }
        }, function() {
            F.Pos.State.yukleniyor = false;
            if (loadingEl) loadingEl.style.display = 'none';
        });
    };

    F.Pos.Grid.render = function(urunler, append) {
        var grid = document.getElementById('frmPosGrid');
        if (!grid) return;

        if (!append) grid.innerHTML = '';

        var html = '';
        for (var i = 0; i < urunler.length; i++) {
            var u = urunler[i];
            if (F.Config.stokMiktarGizle && (u.stok || 0) <= 0 && u.on_siparis_aktif !== 'evet') continue;
            html += _kartHtml(u);
        }

        if (append) {
            grid.insertAdjacentHTML('beforeend', html);
        } else {
            grid.innerHTML = html;
        }
    };

    F.Pos.Grid.temizle = function() {
        var grid = document.getElementById('frmPosGrid');
        if (grid) grid.innerHTML = '';
        var bosEl = document.getElementById('frmPosBos');
        if (bosEl) bosEl.style.display = 'none';
    };

    F.Pos.Grid.fiyatlariGuncelle = function() {
        if (!F.Pos.State.aktif) return;
        F.Pos.State.sifirlaUrunler();
        F.Pos.Grid.temizle();
        F.Pos.Grid.yukle(1);
    };

    var _aralikMap = [
        {e: 'Yok',     c: 'frm-pos-stok-yok', tip: 'Stok yok (0 adet)'},
        {e: 'Sınırlı', c: 'frm-pos-stok-az',  tip: 'Sınırlı stok (1–10 arası)'},
        {e: 'Var',     c: 'frm-pos-stok-ok',   tip: 'Stokta var (11–99 arası)'},
        {e: '100+',    c: 'frm-pos-stok-ok',   tip: '100–499 arası stok'},
        {e: '500+',    c: 'frm-pos-stok-ok',   tip: '500–999 arası stok'},
        {e: '1000+',   c: 'frm-pos-stok-ok',   tip: '1000 ve üzeri stok'}
    ];

    function _kartHtml(u) {
        var esc = F.Helpers.escHtml;
        var stok = u.stok || 0;
        var stokClass, stokLabel;

        var stokTip = '';
        if (F.Config.stokMiktarGizle) {
            var kod = stok > 5 ? 5 : stok;
            var a = _aralikMap[kod] || _aralikMap[0];
            stokClass = a.c;
            stokLabel = a.e;
            stokTip = a.tip;
        } else if (stok <= 0) {
            stokClass = 'frm-pos-stok-yok';
            stokLabel = 'Stok Yok';
        } else if (stok < F.Pos.Config.stokAzEsik) {
            stokClass = 'frm-pos-stok-az';
            stokLabel = 'Stok: ' + stok;
        } else {
            stokClass = 'frm-pos-stok-ok';
            stokLabel = 'Stok: ' + stok;
        }

        var kartClass = 'frm-pos-kart';
        var isOnTalep = stok <= 0 && u.on_siparis_aktif === 'evet';
        if (stok <= 0 && !isOnTalep) kartClass += ' frm-pos-stok-bitti';
        if (isOnTalep) { stokClass = 'frm-pos-stok-ontalep'; stokLabel = 'Ön Talep'; }

        var fiyat = u.satis_fiyati || 0;
        var sembol = (F.Config.paraSembolleri && F.Config.paraSembolleri[F.Config.paraBirimi]) || '$';
        var fiyatStr;
        if (isOnTalep) {
            fiyatStr = '';
        } else if (u.fiyat_min !== undefined && u.fiyat_max !== undefined) {
            var fMin = parseFloat(u.fiyat_min) || 0;
            var fMax = parseFloat(u.fiyat_max) || 0;
            if (Math.abs(fMin - fMax) > 0.001) {
                fiyatStr = sembol + F.Helpers.formatParaSayi(fMin) + ' - ' + F.Helpers.formatParaSayi(fMax);
            } else {
                fiyatStr = sembol + F.Helpers.formatParaSayi(fiyat);
            }
        } else {
            fiyatStr = sembol + F.Helpers.formatParaSayi(fiyat);
        }

        var imgSrc = u.resim_url || '';
        var imgHtml;
        if (imgSrc) {
            imgHtml = '<img src="' + esc(imgSrc) + '" alt="" loading="lazy">';
        } else {
            imgHtml = '<div class="frm-pos-kart-img-ph"><i class="icon-image"></i></div>';
        }

        // Koli / Paket bilgisi (göz iconunun solunda küçük koli iconu + hover tooltip)
        var kb = (F.Helpers && F.Helpers.koliBilgi) ? F.Helpers.koliBilgi(u) : null;
        var koliBtn = kb
            ? '<button type="button" class="frm-pos-kart-koli" data-koli-tip="' + esc(kb.tam) + '" aria-label="Koli bilgisi"><i class="icon-package"></i></button>'
            : '';

        return '<div class="' + kartClass + '" data-urun-id="' + u.id + '" data-varyant-tipi="' + esc(u.varyant_tipi || 'duz') + '" tabindex="0" role="button">' +
            '<div class="frm-pos-kart-img">' +
                imgHtml +
                '<span class="frm-pos-kart-stok ' + stokClass + '"' + (stokTip ? ' data-stok-tip="' + esc(stokTip) + '"' : '') + '>' + esc(stokLabel) + '</span>' +
                koliBtn +
                '<button type="button" class="frm-pos-kart-detay" title="Ürün Detayı"><i class="icon-eye"></i></button>' +
            '</div>' +
            '<div class="frm-pos-kart-info">' +
                '<div class="frm-pos-kart-ad">' + esc(u.urun_adi) + '</div>' +
                '<div class="frm-pos-kart-fiyat">' + fiyatStr + '</div>' +
            '</div>' +
            '<button type="button" class="frm-pos-kart-fab" title="Ekle"><i class="icon-plus"></i></button>' +
        '</div>';
    }

})();
