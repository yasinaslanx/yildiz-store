/* ========================================================================
   Bayi Portal v49 — Header davranışları
   - Saat: her 30sn günceller
   - Kullanıcı dropdown: tıklamada açılır, dış tıklamada kapanır
   - Arama kısayolu: "/" tuşu
   ======================================================================== */
(function () {
    'use strict';

    var TR_AYLAR = [
        'Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran',
        'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'
    ];

    function pad2(n) { return n < 10 ? '0' + n : '' + n; }

    function tickClock() {
        var clockEl = document.querySelector('.bp-hw-time-clock');
        var dateEl = document.querySelector('.bp-hw-time-date');
        if (!clockEl) return;
        var now = new Date();
        clockEl.textContent = pad2(now.getHours()) + ':' + pad2(now.getMinutes());
        if (dateEl) {
            dateEl.textContent = now.getDate() + ' ' + TR_AYLAR[now.getMonth()] + ' ' + now.getFullYear();
        }
    }

    function initUserDropdown() {
        var user = document.querySelector('.bp-hw-user');
        if (!user) return;
        var menu = user.querySelector('.bp-hw-user-menu');

        // User'a tıklama: sadece TRIGGER bölümünde (avatar/who/chevron) toggle yap.
        // Menü içindeki linklere tıklama bubble'la geldiğinde TOGGLE ETME — aksi
        // halde çıkış butonu vs. tıklanmadan menü kapanır.
        user.addEventListener('click', function (e) {
            if (menu && menu.contains(e.target)) {
                // Menü içi click — toggle yapma, linke doğal akışta gitsin
                return;
            }
            e.stopPropagation();
            user.classList.toggle('is-open');
        });

        // Dış tıklamada kapat
        document.addEventListener('click', function (e) {
            if (!user.contains(e.target)) {
                user.classList.remove('is-open');
            }
        });

        // ESC ile kapat
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                user.classList.remove('is-open');
            }
        });
    }

    function initSearchShortcut() {
        var input = document.querySelector('.bp-hw-search input');
        if (!input) return;
        document.addEventListener('keydown', function (e) {
            // "/" tuşu — input'a focus
            if (e.key === '/' && document.activeElement.tagName !== 'INPUT' &&
                document.activeElement.tagName !== 'TEXTAREA') {
                e.preventDefault();
                input.focus();
            }
        });
    }

    function init() {
        tickClock();
        setInterval(tickClock, 30000);
        initUserDropdown();
        initSearchShortcut();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
})();
