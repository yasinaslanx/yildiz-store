/**
 * Form - Detaylı/Özet Liste Toggle + Satır Genişletme
 */
(function() {
    'use strict';

    var F = window.Form;

    F.TabloToggle = {};

    F.TabloToggle.init = function() {
        var toggle = document.getElementById('frmVaryantToggle');
        var tbody = document.getElementById('frmTbody');
        if (!toggle || !tbody) return;

        // Görüntüleme modunda kapalı, diğer modlarda açık başla
        var goruntuleModu = (F.Config.mod === 'siparis-goruntule');
        tbody.classList.add('frm-no-transition');
        if (goruntuleModu) {
            tbody.classList.add('frm-hide-variants');
        } else {
            toggle.checked = true;
        }
        setTimeout(function() {
            tbody.classList.remove('frm-no-transition');
        }, 100);

        toggle.addEventListener('change', function() {
            if (this.checked) {
                // Detaylı liste - varyantları göster
                tbody.classList.remove('frm-hide-variants');
            } else {
                // Özet liste - varyantları gizle
                tbody.classList.add('frm-hide-variants');
                // Açık satırları kapat
                var expanded = tbody.querySelectorAll('.frm-row-expanded');
                for (var i = 0; i < expanded.length; i++) {
                    expanded[i].classList.remove('frm-row-expanded');
                    var btn = expanded[i].querySelector('.frm-row-exp');
                    if (btn) btn.classList.remove('frm-row-exp-open');
                }
                // FF expanded satırları da kapat
                var ffExp = tbody.querySelectorAll('.frm-ff-expanded');
                for (var j = 0; j < ffExp.length; j++) {
                    ffExp[j].classList.remove('frm-ff-expanded');
                }
            }
        });

        // Sipariş yüklendikten sonra toggle'ı kesinlikle aktif tut
        // (readonlyUygula tüm input'ları disable eder, toggle korunmalı)
        F.Events.on('siparis:yuklendi', function() {
            toggle.disabled = false;
        });

        // Satır genişletme butonu (özet moddayken tek satır aç/kapa)
        $(tbody).on('click', '.frm-row-exp', function(e) {
            e.stopPropagation();
            var tr = $(this).closest('tr');
            F.TabloToggle.satirToggle(tr[0]);
        });

        // Görüntüleme modunda: satıra tıklanınca detayları aç/kapa
        if (goruntuleModu) {
            $(tbody).on('click', 'tr[data-satir-id]:not(.frm-ff-satir)', function(e) {
                F.TabloToggle.satirToggle(this);
            });

            // FF satırına tıklanınca ana kalemi toggle et
            $(tbody).on('click', 'tr.frm-ff-satir[data-satir-id]', function(e) {
                var satirId = this.getAttribute('data-satir-id');
                var parentRow = tbody.querySelector('tr[data-satir-id="' + satirId + '"]:not(.frm-ff-satir)');
                if (parentRow) F.TabloToggle.satirToggle(parentRow);
            });
        }
    };

    /**
     * Satır detay aç/kapa (badge + FF satırları)
     */
    F.TabloToggle.satirToggle = function(trEl) {
        if (!trEl) return;

        // Detayı olmayan satırlarda toggle yapma (düz ürünler vb.)
        var hasExpBtn = trEl.querySelector('.frm-row-exp');
        if (!hasExpBtn) return;

        var isOpen = trEl.classList.contains('frm-row-expanded');
        var btn = trEl.querySelector('.frm-row-exp');

        // İlgili FF satırlarını bul
        var satirId = trEl.getAttribute('data-satir-id');
        var ffSatirlar = satirId ? trEl.closest('tbody').querySelectorAll('.frm-ff-satir[data-satir-id="' + satirId + '"]') : [];

        if (isOpen) {
            // Kapat
            trEl.classList.remove('frm-row-expanded');
            if (btn) btn.classList.remove('frm-row-exp-open');
            for (var i = 0; i < ffSatirlar.length; i++) {
                ffSatirlar[i].classList.remove('frm-ff-expanded');
            }
        } else {
            // Aç
            trEl.classList.add('frm-row-expanded');
            if (btn) btn.classList.add('frm-row-exp-open');
            for (var i = 0; i < ffSatirlar.length; i++) {
                ffSatirlar[i].classList.add('frm-ff-expanded');
            }
        }
    };

})();
