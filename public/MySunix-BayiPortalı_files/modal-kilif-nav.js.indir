/**
 * Form - Kılıf Klavye Nav, Highlight, Arama
 */
(function() {
    'use strict';

    var F = window.Form;

    F.ModalKilifNav = F.ModalKilifNav || {};

    /**
     * Klavye navigasyonu init
     */
    F.ModalKilifNav.init = function() {
        document.addEventListener('keydown', function(e) {
            var el = document.activeElement;
            if (!el || !el.classList.contains('frm-km-qi')) return;

            var tbl = document.getElementById('frmKmTbl');
            if (!tbl) return;

            var tr = el.closest('tr');
            var rows = Array.from(tbl.querySelectorAll('tbody tr:not(.frm-km-brand-row)'));
            var ri = rows.indexOf(tr);

            var ST = F.ModalKilif.ST;
            var N = ST.renkler.length;

            // Ayrı modda sadece yukarı/aşağı (toplam input)
            if (ST.mode === 'ayri') {
                var nr;
                if (e.key === 'ArrowUp') { e.preventDefault(); nr = ri - 1; }
                else if (e.key === 'ArrowDown' || e.key === 'Enter') { e.preventDefault(); nr = ri + 1; }
                else return;

                if (nr >= 0 && nr < rows.length) {
                    var t = rows[nr].querySelector('.frm-km-qg-t .frm-km-qi');
                    if (t) { t.focus(); t.select(); }
                }
                return;
            }

            // Karma modda: 2D grid navigasyonu (per-renk inputlar arası)
            var col = parseInt(el.getAttribute('data-c'));
            if (isNaN(col)) return;

            var newRow, newCol;
            switch (e.key) {
                case 'ArrowUp': e.preventDefault(); newRow = ri - 1; newCol = col; break;
                case 'ArrowDown':
                case 'Enter': e.preventDefault(); newRow = ri + 1; newCol = col; break;
                case 'ArrowLeft': e.preventDefault(); newRow = ri; newCol = col - 1; break;
                case 'ArrowRight': e.preventDefault(); newRow = ri; newCol = col + 1; break;
                default: return;
            }

            if (newRow >= 0 && newRow < rows.length && newCol >= 0 && newCol < N) {
                var target = rows[newRow].querySelector('[data-c="' + newCol + '"]');
                if (target) { target.focus(); target.select(); }
            }
        });
    };

    /**
     * Satır + Sütun + Thead highlight (crosshair)
     */
    F.ModalKilifNav.initHighlight = function() {
        var tbl = document.getElementById('frmKmTbl');
        if (!tbl) return;

        function clearHL() {
            tbl.querySelectorAll('.frm-km-col-hl').forEach(function(c) { c.classList.remove('frm-km-col-hl'); });
            tbl.querySelectorAll('.frm-km-row-hl').forEach(function(r) { r.classList.remove('frm-km-row-hl'); });
        }

        function applyHL(input) {
            clearHL();
            var td = input.closest('td');
            var tr = input.closest('tr');
            if (!td || !tr) return;

            var ci = Array.from(tr.children).indexOf(td);

            // Satır highlight
            tr.classList.add('frm-km-row-hl');

            // Sütun highlight: thead + tbody + tfoot
            var thArr = tbl.querySelectorAll('thead th');
            if (thArr[ci]) thArr[ci].classList.add('frm-km-col-hl');

            tbl.querySelectorAll('tbody tr:not(.frm-km-brand-row)').forEach(function(r) {
                var c = r.children[ci];
                if (c && !c.classList.contains('frm-km-td-m')) c.classList.add('frm-km-col-hl');
            });

            var tfArr = tbl.querySelectorAll('tfoot td');
            if (tfArr[ci]) tfArr[ci].classList.add('frm-km-col-hl');
        }

        tbl.addEventListener('focusin', function(e) {
            if (e.target.classList.contains('frm-km-qi')) applyHL(e.target);
        });

        tbl.addEventListener('focusout', function(e) {
            if (e.target.classList.contains('frm-km-qi')) {
                setTimeout(function() {
                    if (!tbl.querySelector('.frm-km-qi:focus')) clearHL();
                }, 10);
            }
        });
    };

    /**
     * Model arama / filtre
     */
    F.ModalKilifNav.filterRows = function(q) {
        q = (q || '').toLowerCase().trim();
        var tbl = document.getElementById('frmKmTbl');
        if (!tbl) return;

        var rows = tbl.querySelectorAll('tbody tr');
        var lastBrand = null;
        var brandHasVisible = false;

        rows.forEach(function(r) {
            if (r.classList.contains('frm-km-brand-row')) {
                if (lastBrand) lastBrand.style.display = brandHasVisible ? '' : 'none';
                lastBrand = r;
                brandHasVisible = false;
            } else {
                var name = r.querySelector('.frm-km-model-name');
                if (!name) return;
                var match = !q || name.textContent.toLowerCase().indexOf(q) !== -1;
                r.style.display = match ? '' : 'none';
                if (match) brandHasVisible = true;
            }
        });
        if (lastBrand) lastBrand.style.display = brandHasVisible ? '' : 'none';
    };

})();
