/* ========================================================================
   Bayi Portal v49 — Mobil drawer + hamburger toggle
   - Mobilde hamburger butonu sidebar'ı drawer olarak açar/kapatır
   - Overlay tıklamasında veya ESC ile kapanır
   - Sayfa değişiminde otomatik kapanır
   ======================================================================== */
(function () {
    'use strict';

    var sidebar, hamburger, overlay;

    function open() {
        if (!sidebar) return;
        sidebar.classList.add('is-open');
        if (overlay) overlay.classList.add('is-open');
        document.body.style.overflow = 'hidden';
    }

    function close() {
        if (!sidebar) return;
        sidebar.classList.remove('is-open');
        if (overlay) overlay.classList.remove('is-open');
        document.body.style.overflow = '';
    }

    function toggle() {
        if (!sidebar) return;
        if (sidebar.classList.contains('is-open')) {
            close();
        } else {
            open();
        }
    }

    function init() {
        sidebar = document.querySelector('.bp-sidebar');
        hamburger = document.querySelector('.bp-hamburger');

        if (!sidebar) return;

        // Overlay ekle (yoksa)
        overlay = document.querySelector('.bp-drawer-overlay');
        if (!overlay) {
            overlay = document.createElement('div');
            overlay.className = 'bp-drawer-overlay';
            document.body.appendChild(overlay);
        }

        if (hamburger) {
            hamburger.addEventListener('click', function () {
                // Sadece mobilde drawer toggle (desktop'ta collapse.js halleder)
                if (window.innerWidth <= 768) {
                    toggle();
                }
            });
        }

        overlay.addEventListener('click', close);

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && sidebar.classList.contains('is-open')) {
                close();
            }
        });

        // Sidebar içindeki linklere tıklandığında drawer'ı kapat (mobil)
        sidebar.addEventListener('click', function (e) {
            var link = e.target.closest('a[href]');
            if (link && window.innerWidth <= 768) {
                // Sayfa değişimi sırasında drawer kapanır
                close();
            }
        });

        // Resize: desktop'a geçilirse drawer kapansın
        window.addEventListener('resize', function () {
            if (window.innerWidth > 768) {
                close();
            }
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
})();
