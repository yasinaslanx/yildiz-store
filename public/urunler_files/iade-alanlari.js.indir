/**
 * Form - İade Ek Alanları (kategori, kargo, arıza deposu)
 * Sipariş modunda no-op.
 *
 * Arıza deposu seçimi: iade ürünleri seçilen arıza (servis) deposuna stok girişi olur.
 * Seçili depo F.State.seciliDepoId'ye yazılır → kaydet.js her satırın depo_id'sini buradan alır.
 */
(function() {
    'use strict';

    var F = window.Form;

    F.IadeAlanlari = {};

    F.IadeAlanlari.init = function() {
        if (!F.Config.isIade) return;

        var depoSel = document.getElementById('frmIadeDepo');
        if (depoSel) {
            // Başlangıç: seçili arıza deposunu merkezi state'e yaz
            var ilk = parseInt(depoSel.value, 10);
            if (ilk > 0) F.State.seciliDepoId = ilk;

            depoSel.addEventListener('change', function() {
                var v = parseInt(this.value, 10);
                if (v > 0) F.State.seciliDepoId = v;
            });
        }
    };

    // Düzenleme modunda yükleme sonrası orijinal depoyu seçili getir (cosmetic)
    F.IadeAlanlari.depoSec = function(depoId) {
        var depoSel = document.getElementById('frmIadeDepo');
        if (!depoSel || !depoId) return;
        var opt = depoSel.querySelector('option[value="' + depoId + '"]');
        if (opt) {
            depoSel.value = String(depoId);
            F.State.seciliDepoId = parseInt(depoId, 10);
        }
    };

})();
