/**
 * Form - Varyant Detay SweetAlert: Depo, Fiyat, Miktar (veya Çin siparişinde Not)
 * Referans: denemeler/varyant-secim-temasi-v3.php
 */
(function() {
    'use strict';

    var F = window.Form;
    F.ModalVaryant = F.ModalVaryant || {};

    var getTextColor = F.Helpers.getTextColor;

    /**
     * Varyant detay modalını aç (SweetAlert2)
     */
    F.ModalVaryant.detayAc = function(varyantId) {
        var data = F.ModalVaryant.ST.urunData;
        if (!data) return;

        var tip = varyantId.split('_')[0];
        var id = varyantId.split('_')[1];
        var vData = F.ModalVaryant.getVaryantData(tip, id, data);
        if (!vData) return;

        var isCin = !!F.Config.isCinSiparis;

        var orijinalFiyat = data.fiyat || 0;
        var varsayilanFiyat = (F.ModalVaryant.ST.varsayilanFiyatListesi !== null && !F.Config.indirimGizle)
            ? F.ModalVaryant.ST.varsayilanFiyatListesi
            : orijinalFiyat;
        var kural = F.ModalVaryant.ST.fiyatKurali;
        var birimFiyat;
        if (F.ModalVaryant.ST.p[varyantId] !== undefined) {
            birimFiyat = F.ModalVaryant.ST.p[varyantId];
        } else {
            var mf = F.ModalVaryant.modelFiyatBul(varyantId);
            if (mf !== null) {
                birimFiyat = (kural && !F.Config.indirimGizle) ? F.Helpers.fiyatKuraliUygula(mf, kural) : mf;
            } else {
                birimFiyat = varsayilanFiyat;
            }
        }
        var miktar = F.ModalVaryant.ST.q[varyantId] || 0;
        var esc = F.Helpers.escHtml;
        var fmt = F.Helpers.formatPara;

        // Çin modunda mevcut notlar
        var existingNot = (F.ModalVaryant.ST.n && F.ModalVaryant.ST.n[varyantId]) || { tr: '', en: '' };

        // Header rengi
        var headerBg = vData.renkKodu || vData.markaRenk || '#103595';
        var textColor = getTextColor(headerBg);

        // Başlık metni
        var titleText = vData.adi || '';
        if (vData.modelAdi && vData.tip !== 'model') {
            titleText = vData.modelAdi + ' — ' + titleText;
        } else if (vData.modelAdi) {
            titleText = vData.modelAdi;
        }

        // Varyant bazlı stok sorgusu için tip ve DB id belirleme
        var varyantTipMap = { r: 'renk', m: 'model', mr: 'model_renk' };
        var varyantTip = varyantTipMap[tip] || '';
        var dbId = parseInt(id) || 0;

        // HTML oluştur (referans yapı: .frm-vd-modal > header + body + footer)
        var html = '<div class="frm-vd-modal' + (isCin ? ' frm-vd-cin' : '') + '">';

        // Header
        html += '<div class="frm-vd-header" style="background:' + esc(headerBg) + ';color:' + textColor + '">';
        html += '<div class="frm-vd-name">' + esc(titleText) + '</div>';
        if (!isCin) {
            var convFn = (F.Doviz && F.Doviz.aktif) ? F.Doviz.conv : function(v) { return v; };
            html += '<div class="frm-vd-price-tag">' + F.Helpers.formatPara(convFn(birimFiyat)) + '</div>';
        }
        html += '</div>';

        // Body
        html += '<div class="frm-vd-body">';

        // Info row: Stok + Yoldaki (Çin modunda gizle)
        var yolda = data.yolda || {};
        var yoldaToplam = yolda.genel_toplam || 0;
        if (!isCin) {
            html += '<div class="frm-vd-info-row">';
            if (F.State.isIade) {
                html += '<div class="frm-vd-info-box"><div class="frm-vd-info-label">Mod</div><div class="frm-vd-info-value frm-vd-blue">İade</div></div>';
                html += '<div class="frm-vd-info-box"><div class="frm-vd-info-label">Yoldaki</div><div class="frm-vd-info-value">-</div></div>';
            } else {
                html += '<div class="frm-vd-info-box frm-stk-tt-wrap"><div class="frm-vd-info-label">Stok</div><div class="frm-vd-info-value frm-vd-blue" id="frmVdStokVal">...</div><div class="frm-stk-tt" id="frmVdStokTt" style="display:none"></div></div>';
                html += '<div class="frm-vd-info-box" style="background:#eff6ff"><div class="frm-vd-info-label" style="color:#3b82f6"><i class="icon-truck" style="margin-right:4px"></i>Yolda</div><div class="frm-vd-info-value frm-vd-yolda-val" data-stok-donusturuldu="1" style="color:#1d4ed8">' + F.Helpers.formatSayi(yoldaToplam) + '</div></div>';
            }
            html += '</div>';
        }

        // Miktar (her modda)
        html += '<div class="frm-vd-field">';
        html += '<label class="frm-vd-field-label">Miktar</label>';
        html += '<div class="frm-vd-qty-ctrl">';
        html += '<button class="frm-vd-qty-btn" id="frmVdMinus1"><i class="icon-minus"></i></button>';
        html += '<input type="text" inputmode="numeric" class="frm-vd-qty-input" autocomplete="off" id="frmVdQty" value="' + miktar + '">';
        html += '<button class="frm-vd-qty-btn" id="frmVdPlus1"><i class="icon-plus"></i></button>';
        html += '</div></div>';

        if (isCin) {
            // Çin modu: Not alanları (TR + EN) ve DeepL butonu
            html += '<div class="frm-vd-field">';
            html += '<label class="frm-vd-field-label">Açıklama (Türkçe)</label>';
            html += '<textarea class="frm-vd-note-area" id="frmVdNotTr" rows="3" placeholder="Örn. Renk tonu biraz daha koyu olsun">' + esc(existingNot.tr || '') + '</textarea>';
            html += '</div>';

            html += '<div class="frm-vd-note-translate-row">';
            html += '<button type="button" class="frm-vd-btn-translate" id="frmVdCevir"><i class="icon-globe"></i> Türkçe → İngilizce Çevir</button>';
            html += '</div>';

            html += '<div class="frm-vd-field">';
            html += '<label class="frm-vd-field-label">Description (English)</label>';
            html += '<textarea class="frm-vd-note-area" id="frmVdNotEn" rows="3" placeholder="e.g. Please keep the color tone a bit darker">' + esc(existingNot.en || '') + '</textarea>';
            html += '</div>';
        } else {
            // Depo
            html += '<div class="frm-vd-field">';
            html += '<label class="frm-vd-field-label">Depo</label>';
            if (F.State.isIade) {
                html += '<select class="frm-vd-select" id="frmVdDepo" disabled><option>İADE MODU</option></select></div>';
            } else {
                html += '<select class="frm-vd-select" id="frmVdDepo">';
                html += '<option value="">Yükleniyor...</option>';
                html += '</select></div>';
            }

            // Birim Fiyat
            html += '<div class="frm-vd-field">';
            html += '<label class="frm-vd-field-label">Birim Fiyat</label>';
            html += '<div class="frm-vd-price-input-wrap">';
            html += '<div class="frm-vd-price-symbol">' + F.Config.paraSembolu + '</div>';
            var vdDisplayFiyat = ((F.Doviz && F.Doviz.aktif) ? F.Doviz.conv : function(v) { return v; })(birimFiyat);
            // Manuel TL tespiti için otomatik TL fiyatı sakla
            var vdAutoTl = '';
            var vdExistingMtl = (F.ModalVaryant.ST.mtl && F.ModalVaryant.ST.mtl[varyantId] != null);
            if (F.Doviz && F.Doviz.aktif && !vdExistingMtl) {
                vdAutoTl = vdDisplayFiyat;
            }
            html += '<input type="text" class="frm-vd-price-input tutar-formatli" inputmode="decimal" autocomplete="off" id="frmVdPrice" data-auto-tl="' + vdAutoTl + '" value="' + (typeof formatTutar === 'function' ? formatTutar(vdDisplayFiyat) : vdDisplayFiyat.toFixed(2)) + '">';
            html += '</div></div>';
        }

        html += '</div>'; // body

        // Footer
        html += '<div class="frm-vd-footer">';
        html += '<button class="frm-vd-btn-ok" id="frmVdApply">Uygula</button>';
        html += '</div>';

        html += '</div>'; // modal

        Swal.fire({
            html: html,
            showCloseButton: true,
            showConfirmButton: false,
            padding: 0,
            width: isCin ? 440 : 360,
            customClass: {
                popup: 'frm-vd-popup'
            },
            didOpen: function() {
                // Miktar butonları
                document.getElementById('frmVdMinus1').addEventListener('click', function() { vdQtyDegistir(-1); });
                document.getElementById('frmVdPlus1').addEventListener('click', function() { vdQtyDegistir(1); });
                document.getElementById('frmVdQty').addEventListener('input', function() {
                    this.value = this.value.replace(/\D/g, '');
                });

                // Uygula butonu
                document.getElementById('frmVdApply').addEventListener('click', function() {
                    vdUygula(varyantId, isCin);
                });

                document.getElementById('frmVdQty').focus();
                document.getElementById('frmVdQty').select();

                if (isCin) {
                    // DeepL çeviri butonu
                    var cevirBtn = document.getElementById('frmVdCevir');
                    if (cevirBtn) {
                        cevirBtn.addEventListener('click', function() { vdCeviriYap(cevirBtn); });
                    }
                    return;
                }

                // Stok tooltip init
                F.Helpers.stokTooltipInit(document.querySelector('.frm-vd-popup'));

                // Varyant bazlı stok sorgula ve güncelle (iade modunda atla)
                if (!F.State.isIade && varyantTip && dbId) {
                    F.Helpers.ajaxGet('stok-sorgula.php', {
                        urun_id: data.id,
                        varyant_tip: varyantTip,
                        varyant_id: dbId
                    }, function(res) {
                        if (!res.success || !res.stoklar) return;
                        var depoStok = res.stoklar;
                        var toplamStok = 0;
                        for (var si = 0; si < depoStok.length; si++) {
                            toplamStok += parseInt(depoStok[si].miktar) || 0;
                        }
                        // Stok değerini güncelle
                        var stokEl = document.getElementById('frmVdStokVal');
                        if (stokEl) stokEl.textContent = toplamStok;
                        // Tooltip güncelle
                        var ttEl = document.getElementById('frmVdStokTt');
                        if (ttEl && depoStok.length > 0) {
                            var ttHtml = '';
                            for (var ti = 0; ti < depoStok.length; ti++) {
                                ttHtml += '<div class="frm-stk-tt-r"><span class="frm-stk-tt-l">' +
                                    esc(depoStok[ti].depo_adi) + '</span><span class="frm-stk-tt-v">' +
                                    (parseInt(depoStok[ti].miktar) || 0) + '</span></div>';
                            }
                            ttEl.innerHTML = ttHtml;
                            ttEl.style.display = '';
                        }
                        // Depo select'i güncelle
                        var depoSelect = document.getElementById('frmVdDepo');
                        if (depoSelect) {
                            depoSelect.innerHTML = '';
                            for (var di = 0; di < depoStok.length; di++) {
                                var dep = depoStok[di];
                                var stk = parseInt(dep.miktar) || 0;
                                var opt = document.createElement('option');
                                opt.value = dep.depo_id;
                                opt.textContent = esc(dep.depo_adi) + ' (' + stk + ')';
                                depoSelect.appendChild(opt);
                            }
                        }
                    });
                }
            }
        });
    };

    /**
     * DeepL çeviri (Çin modu, TR → EN)
     */
    function vdCeviriYap(btn) {
        var trArea = document.getElementById('frmVdNotTr');
        var enArea = document.getElementById('frmVdNotEn');
        if (!trArea || !enArea) return;

        var metin = (trArea.value || '').trim();
        if (!metin) {
            Swal.showValidationMessage('Önce Türkçe açıklama alanını doldurun.');
            setTimeout(function() { Swal.resetValidationMessage(); }, 2500);
            return;
        }

        // js/ceviri.js içindeki cevirMetin fonksiyonu varsa kullan
        if (typeof cevirMetin === 'function') {
            cevirMetin('frmVdNotTr', 'frmVdNotEn', btn);
            return;
        }

        // Fallback: doğrudan AJAX
        btn.classList.add('loading');
        btn.disabled = true;
        fetch('/ajax/ceviri-api.php', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ metin: metin, kaynak_dil: 'TR', hedef_dil: 'EN' })
        })
        .then(function(r) { return r.json(); })
        .then(function(resp) {
            if (resp.success && resp.ceviri) {
                enArea.value = resp.ceviri;
            } else {
                Swal.showValidationMessage(resp.message || 'Çeviri başarısız.');
            }
        })
        .catch(function() {
            Swal.showValidationMessage('Çeviri servisi yanıt vermedi.');
        })
        .finally(function() {
            btn.classList.remove('loading');
            btn.disabled = false;
        });
    }

    /**
     * Uygula: miktar kaydet, kartı güncelle, SweetAlert kapat
     */
    function vdUygula(varyantId, isCin) {
        var newQty = parseInt(document.getElementById('frmVdQty').value) || 0;
        F.ModalVaryant.ST.q[varyantId] = newQty;

        if (isCin) {
            // Notları kaydet
            var trEl = document.getElementById('frmVdNotTr');
            var enEl = document.getElementById('frmVdNotEn');
            var trNot = trEl ? (trEl.value || '').trim() : '';
            var enNot = enEl ? (enEl.value || '').trim() : '';
            F.ModalVaryant.ST.n = F.ModalVaryant.ST.n || {};
            F.ModalVaryant.ST.n[varyantId] = { tr: trNot, en: enNot };

            // Satır varyant nesnesine yansıt (tablo render'ı okusun)
            var satirId = F.ModalVaryant.ST.satirId;
            if (satirId && F.State.satirlar) {
                var satir = null;
                for (var si = 0; si < F.State.satirlar.length; si++) {
                    if (F.State.satirlar[si].id === satirId) { satir = F.State.satirlar[si]; break; }
                }
                if (satir && satir.varyantlar) {
                    for (var vi = 0; vi < satir.varyantlar.length; vi++) {
                        var vv = satir.varyantlar[vi];
                        if (vv.key === varyantId || vv.varyantId === varyantId) {
                            vv.not_tr = trNot;
                            vv.not_en = enNot;
                            vv.not = trNot || enNot;
                            break;
                        }
                    }
                }
            }

            // Kart input'u ve badge güncelle
            var inpC = document.querySelector('.frm-vm-vc-qty[data-id="' + varyantId + '"]');
            if (inpC) {
                inpC.value = newQty || '';
                var cardC = inpC.closest('.frm-vm-vc');
                if (cardC) {
                    cardC.classList.toggle('sel', newQty > 0);
                    // Not badge ekle/kaldır
                    var existingBadge = cardC.querySelector('.frm-vm-vc-note-badge');
                    if (existingBadge) existingBadge.remove();
                    if (trNot || enNot) {
                        var badge = document.createElement('span');
                        badge.className = 'frm-vm-vc-note-badge';
                        badge.title = (trNot || enNot).substring(0, 120);
                        badge.innerHTML = '<i class="icon-edit-3"></i>';
                        cardC.appendChild(badge);
                    }
                }
            }

            F.ModalVaryant.toplamGuncelle();
            if (satirId && F.Events) {
                F.Events.emit('satir:guncellendi', satirId);
            }
            Swal.close();
            return;
        }

        // Fiyat oku ve USD'ye çevir (referans: modal-duz.js uygula())
        var priceEl = document.getElementById('frmVdPrice');
        if (priceEl) {
            var rawFiyat = priceEl.value;
            var displayFiyat = (typeof unformatTutar === 'function') ? unformatTutar(rawFiyat) : (parseFloat(rawFiyat) || 0);

            // Manuel TL tespiti
            var manuelTlVd = null;
            var fiyat;
            if (F.Doviz && F.Doviz.aktif) {
                var autoTlVd = parseFloat(priceEl.getAttribute('data-auto-tl')) || 0;
                var existingMtlVd = (F.ModalVaryant.ST.mtl && F.ModalVaryant.ST.mtl[varyantId] != null);
                if (existingMtlVd) {
                    manuelTlVd = displayFiyat;
                    fiyat = F.Helpers.bankersRound(displayFiyat / F.Doviz.kur, 6);
                } else if (autoTlVd > 0 && Math.abs(displayFiyat - autoTlVd) > 0.004) {
                    manuelTlVd = displayFiyat;
                    fiyat = F.Helpers.bankersRound(displayFiyat / F.Doviz.kur, 6);
                } else {
                    fiyat = F.Doviz.toBase(displayFiyat);
                }
            } else {
                fiyat = displayFiyat;
            }

            F.ModalVaryant.ST.p[varyantId] = fiyat;
            if (manuelTlVd != null) {
                F.ModalVaryant.ST.mtl[varyantId] = manuelTlVd;
            } else {
                delete F.ModalVaryant.ST.mtl[varyantId];
            }
        }

        // Depo kaydet
        var depoEl = document.getElementById('frmVdDepo');
        if (depoEl && depoEl.value) {
            F.ModalVaryant.ST.d[varyantId] = parseInt(depoEl.value) || F.State.seciliDepoId;
        }

        // Kart input'unu güncelle
        var inp = document.querySelector('.frm-vm-vc-qty[data-id="' + varyantId + '"]');
        if (inp) {
            inp.value = newQty || '';
            var card = inp.closest('.frm-vm-vc');
            if (card) {
                card.classList.toggle('sel', newQty > 0);
                // Karttaki fiyat etiketini güncelle
                if (priceEl) {
                    var convFn = (F.Doviz && F.Doviz.aktif) ? F.Doviz.conv : function(v) { return v; };
                    var priceTag = card.querySelector('.frm-vm-vc-swatch-price');
                    if (priceTag) priceTag.textContent = F.Helpers.formatPara(convFn(F.ModalVaryant.ST.p[varyantId]));
                }
            }
        }
        F.ModalVaryant.toplamGuncelle();
        Swal.close();
    }

    /**
     * Miktar değiştir
     */
    function vdQtyDegistir(delta) {
        var inp = document.getElementById('frmVdQty');
        if (!inp) return;
        var val = Math.max(0, (parseInt(inp.value) || 0) + delta);
        inp.value = val;
    }

})();
