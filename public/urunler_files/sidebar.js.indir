/* ========================================================================
   Bayi Portal v49 — Sidebar tab switcher (Mağazam ⇄ Sunix Merkez)
   - Tab tıklamasında ilgili paneli aç/kapa
   - Cascade rise animasyonunu yeniden tetikle (reflow trick)
   - localStorage ile son seçilen tab'ı hatırla (sayfa kilitli değilse)
   ======================================================================== */
(function () {
    'use strict';

    var KEY = 'bp_sb_active_tab';

    function activateTab(tabKey) {
        var tabs = document.querySelectorAll('.bp-sb-tab');
        var panels = document.querySelectorAll('.bp-sb-panel');

        tabs.forEach(function (b) {
            b.classList.toggle('is-active', b.dataset.tab === tabKey);
        });

        panels.forEach(function (p) {
            // Reflow trick — animasyonu yeniden başlatır
            p.classList.remove('is-active');
            void p.offsetWidth;
            if (p.dataset.panel === tabKey) {
                p.classList.add('is-active');
            }
        });

        var wrap = document.querySelector('.bp-sb-tabs');
        if (wrap) wrap.dataset.active = tabKey;
    }

    function init() {
        var tabs = document.querySelectorAll('.bp-sb-tab');
        if (!tabs.length) return;

        var wrap = document.querySelector('.bp-sb-tabs');
        var locked = wrap && wrap.dataset.locked === '1';

        // Sayfa locked değilse localStorage'ten son tab'ı yükle
        if (!locked) {
            try {
                var saved = localStorage.getItem(KEY);
                if (saved && document.querySelector('.bp-sb-tab[data-tab="' + saved + '"]')) {
                    activateTab(saved);
                }
            } catch (e) {}
        }

        tabs.forEach(function (btn) {
            btn.addEventListener('click', function () {
                var t = btn.dataset.tab;
                activateTab(t);
                if (!locked) {
                    try { localStorage.setItem(KEY, t); } catch (e) {}
                }
            });
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
})();
