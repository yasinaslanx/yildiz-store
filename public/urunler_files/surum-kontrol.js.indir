/**
 * Bayi Portalı — Otomatik Sürüm Kontrolü ("Cache'e takılı kalma" garantisi — Sadece Bildirim)
 *
 * Sayfaya gömülü deploy damgası (window.SUNIX_SURUM) ile sunucudaki güncel damgayı
 * (ajax/surum.php, no-store) periyodik karşılaştırır. Yeni deploy algılanınca sağ-altta
 * küçük, kapatılabilir "Şimdi Yenile" bildirimi gösterilir — yenileme kararı HER ZAMAN
 * kullanıcıdadır, sayfa ASLA kendiliğinden reload edilmez (otomatik reload Haziran 2026'da
 * kaldırıldı: kullanıcılar çalışırken sayfanın aniden yenilenmesinden şikayet etti).
 *
 * Bildirim '×' ile kapatılınca o sürüm için sessionStorage'a yazılır → aynı oturumda
 * tekrar gösterilmez.
 *
 * mysunix.com → proxy → sunixhub.com/bayi/ olduğundan 'ajax/surum.php' relative çağrısı
 * bayi/ajax/surum.php'ye düşer.
 */
(function () {
    'use strict';

    var mevcut = (window.SUNIX_SURUM || '').toString();
    if (!mevcut) return; // damga gömülmemişse sessizce çık

    var ERTELE_KEY = 'mysunixSurumErtelendi';   // kullanıcının kapattığı sürüm

    var yeniSurum = null;       // sunucuda algılanan yeni damga (bir kez bulununca saklanır)
    var kontrolEdiliyor = false;
    var bildirimEl = null;      // ekrandaki köşe bildirimi (varsa)

    /* ====================================================================
       Kontrol döngüsü
       ==================================================================== */
    function kontrolEt() {
        // Her tetikte sunucuya gerçekten sorulur: kullanıcı bildirimi '×' ile kapatmış
        // olsa bile SONRAKİ deploy'lar yeni damgayla geldiğinde bildirim tekrar çıkabilir.
        if (kontrolEdiliyor) return;
        kontrolEdiliyor = true;
        // Benzersiz query → ara katman cache'leri kesin atlanır
        fetch('ajax/surum.php?_=' + Date.now(), { cache: 'no-store', credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (d) {
                kontrolEdiliyor = false;
                if (d && d.surum && d.surum.toString() !== mevcut) {
                    yeniSurum = d.surum.toString();
                    uygula();
                }
            })
            .catch(function () { kontrolEdiliyor = false; });
    }

    function uygula() {
        if (ertelendiMi()) return;  // kullanıcı bu sürüm bildirimini kapatmış → sus
        bildirimGoster();
    }

    function ertelendiMi() {
        try { return sessionStorage.getItem(ERTELE_KEY) === yeniSurum; } catch (e) { return false; }
    }
    function ertele() {
        try { sessionStorage.setItem(ERTELE_KEY, yeniSurum || ''); } catch (e) {}
    }

    /* ====================================================================
       Sağ-alt köşe bildirimi
       ==================================================================== */
    function bildirimGoster() {
        if (bildirimEl) return;
        stilEnjekteEt();

        var box = document.createElement('div');
        box.id = 'surumGuncellemeBildirim';
        box.setAttribute('role', 'status');
        box.style.cssText = [
            'position:fixed', 'right:20px', 'bottom:20px', 'z-index:2147483647',
            'width:330px', 'max-width:calc(100vw - 40px)',
            'background:#fff', 'border-radius:14px',
            'border:1px solid #e5e7eb', 'overflow:hidden',
            'box-shadow:0 12px 32px rgba(0,0,0,.14)',
            'font-family:inherit',
            'animation:sgbIn .42s cubic-bezier(.16,1,.3,1)'
        ].join(';');

        box.innerHTML =
            '<div style="display:flex;align-items:flex-start;gap:13px;padding:16px 16px 14px">' +
                '<div style="flex:none;width:40px;height:40px;border-radius:10px;background:#103595;display:flex;align-items:center;justify-content:center">' +
                    '<svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>' +
                '</div>' +
                '<div style="flex:1;min-width:0">' +
                    '<div style="font-weight:700;font-size:14px;color:#1f2937;line-height:1.3">Sistem Güncellemesi Var</div>' +
                    '<div style="color:#6b7280;font-size:12.5px;line-height:1.45;margin-top:3px">Yeni bir sürüm yayınlandı. Çalışmanız bittiğinde sayfayı yenileyin.</div>' +
                '</div>' +
                '<button type="button" class="sgb-close" aria-label="Kapat" style="flex:none;width:26px;height:26px;margin:-4px -4px 0 0;padding:0;display:flex;align-items:center;justify-content:center;background:transparent;color:#9ca3af;border:0;border-radius:7px;font-size:18px;line-height:1;cursor:pointer;transition:background .15s,color .15s">&times;</button>' +
            '</div>' +
            '<div style="display:flex;justify-content:flex-end;padding:0 16px 16px">' +
                '<button type="button" class="sgb-btn" style="background:#103595;color:#fff;border:0;border-radius:8px;padding:9px 18px;font-weight:600;font-size:12.5px;cursor:pointer;transition:background .15s">Şimdi Yenile</button>' +
            '</div>';

        box.querySelector('.sgb-btn').addEventListener('click', function () { location.reload(); });
        box.querySelector('.sgb-close').addEventListener('click', function () {
            ertele(); // o oturumda bu sürüm için tekrar gösterme
            if (box.parentNode) box.parentNode.removeChild(box);
            bildirimEl = null;
        });

        document.body.appendChild(box);
        bildirimEl = box;
    }

    // Animasyon + hover keyframe'lerini bir kez sayfaya enjekte et
    function stilEnjekteEt() {
        if (document.getElementById('surumBildirimStil')) return;
        var st = document.createElement('style');
        st.id = 'surumBildirimStil';
        st.textContent =
            '@keyframes sgbIn{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}' +
            '#surumGuncellemeBildirim .sgb-close:hover{background:#f3f4f6;color:#374151}' +
            '#surumGuncellemeBildirim .sgb-btn:hover{background:#0c2a78}';
        document.head.appendChild(st);
    }

    /* ====================================================================
       Tetikleyiciler: ilk yükleme (gecikmeli), sekmeye dönüş, 2 dakikada bir
       ==================================================================== */
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
        setTimeout(kontrolEt, 4000);
    } else {
        document.addEventListener('DOMContentLoaded', function () { setTimeout(kontrolEt, 4000); });
    }
    document.addEventListener('visibilitychange', function () { if (!document.hidden) kontrolEt(); });
    window.addEventListener('focus', kontrolEt);
    setInterval(kontrolEt, 120000);
})();
