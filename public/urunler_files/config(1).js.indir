/**
 * Form - Config & Sabitler
 * window.Form namespace oluşturma
 */
(function() {
    'use strict';

    window.Form = window.Form || {};

    // Config (PHP'den aktarılan)
    var cfg = window.FormConfig || {};

    Form.Config = {
        mod: cfg.mod || 'siparis-yeni',
        id: cfg.id || null,
        readonly: cfg.readonly || false,
        isIade: cfg.isIade || false,
        isOnSiparis: cfg.isOnSiparis || false,
        isSevkiyat: cfg.isSevkiyat || false,
        isCinSiparis: cfg.isCinSiparis || false,
        cinSiparisId: cfg.cinSiparisId || null,
        sevkiyatId: cfg.sevkiyatId || null,
        isBayi: cfg.isBayi || false,
        stokKontrolAtla: cfg.stokKontrolAtla || false,
        stokMiktarGizle: cfg.stokMiktarGizle || false,
        indirimGizle: cfg.indirimGizle || false,
        isKampanya: cfg.isKampanya || false,
        isKampanyaUrun: cfg.isKampanyaUrun || false,
        isKampanyaHediye: cfg.isKampanyaHediye || false,
        kampanyaId: cfg.kampanyaId || null,
        iadeKategorisi: cfg.iadeKategorisi || 'normal',
        paraBirimi: cfg.paraBirimi || 'USD',
        depolar: cfg.depolar || [],
        varsayilanDepoId: cfg.varsayilanDepoId || 3,
        kopyalaId: cfg.kopyalaId || null,
        isGenelYonetici: cfg.isGenelYonetici || false,
        autoMusteri: cfg.autoMusteri || null,

        // AJAX base URL (PHP'den override edilebilir, örn. bayi portalı için 'ajax/musteri-siparis/')
        ajaxBase: cfg.ajaxBase || 'ajax/form/',

        // KDV oranı (%)
        kdvOrani: 20,

        // Para birimi sembolleri
        paraSembolleri: { USD: '$', EUR: '€', TRY: '₺', GBP: '£' },

        // Arama debounce süresi (ms)
        aramaDebounce: 300,

        // Minimum arama karakter sayısı
        minAramaKarakter: 2
    };

    // Para birimi sembolü
    Form.Config.paraSembolu = Form.Config.paraSembolleri[Form.Config.paraBirimi] || '$';

    /**
     * Aktif KDV oranını döndür (DOM input'tan okunur)
     */
    Form.Config.aktifKdvOrani = function() {
        var inp = document.getElementById('frmKdvOrani');
        if (inp) return parseFloat(inp.value) || 0;
        return 0;
    };

})();
