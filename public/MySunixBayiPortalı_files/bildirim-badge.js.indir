(function() {
    var badge = document.getElementById('bpHwNotif');
    var sayiEl = document.getElementById('bpNotifCount');
    var menuBadge = document.getElementById('bpMenuNotifCount');
    if (!badge && !menuBadge) return;

    function kontrol() {
        fetch('ajax/on-talep-bildirimler/bildirim-sayisi.php', { credentials: 'same-origin' })
            .then(function(r) { return r.json(); })
            .then(function(d) {
                var sayi = (d.success && d.sayi > 0) ? d.sayi : 0;
                if (sayi > 0) {
                    if (sayiEl) sayiEl.textContent = sayi;
                    if (badge) badge.style.display = '';
                    if (menuBadge) { menuBadge.textContent = sayi; menuBadge.style.display = ''; }
                } else {
                    if (badge) badge.style.display = 'none';
                    if (menuBadge) menuBadge.style.display = 'none';
                }
            })
            .catch(function() {});
    }

    kontrol();
    setInterval(kontrol, 60000);
})();
