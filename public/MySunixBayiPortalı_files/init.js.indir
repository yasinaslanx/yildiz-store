window.BayiEgitim = window.BayiEgitim || {};

BayiEgitim.Init = (function () {
    $(document).ready(function () {
        if (typeof bayiEgitimConfig === 'undefined') return;
        if (window.innerWidth < BayiEgitim.Config.mobileBreakpoint) return;
        if (bayiEgitimConfig.isImpersonation) return;
        if (bayiEgitimConfig.egitimDurumu === 'tamamlandi') return;
        if (bayiEgitimConfig.sayfaAdi !== 'pano') return;

        setTimeout(function () {
            BayiEgitim.Engine.init(bayiEgitimConfig.egitimAdim);
        }, 800);
    });
})();
