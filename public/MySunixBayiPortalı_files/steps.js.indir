window.BayiEgitim = window.BayiEgitim || {};

BayiEgitim.Steps = (function () {
    var bot = BayiEgitim.BotSVG;
    var isKisitli = (typeof bayiEgitimConfig !== 'undefined') && bayiEgitimConfig.isKisitliYetki;

    var adimlar = [
        {
            id: 'pano-kpi',
            attachTo: { element: '.bp-kpi-row', on: 'bottom' },
            title: 'Performans Özeti',
            text: bot.tooltipHTML('Performans Özeti', 'Mağazanızın günlük satış, sipariş, müşteri ve ciro bilgilerini bu kartlardan anlık takip edebilirsiniz.')
        },
        {
            id: 'pano-siparisler',
            attachTo: { element: '.bp-pano-table-card', on: 'right' },
            title: 'Son Siparişler',
            text: bot.tooltipHTML('Son Siparişler', 'En son oluşturduğunuz siparişler burada listelenir. Durumlarını ve tutarlarını hızlıca görebilirsiniz.')
        },
        {
            id: 'pano-hizli-eylemler',
            attachTo: { element: '.bp-pano-actions-grid', on: 'left' },
            title: 'Hızlı Eylemler',
            text: bot.tooltipHTML('Hızlı Eylemler', 'Yeni satış oluşturma, müşteri ekleme, stok kontrol gibi sık kullanılan işlemlere tek tıkla erişin.')
        },
        {
            id: 'pano-kasalar-depolar',
            attachTo: { element: '.bp-pano-row--col2', on: 'top' },
            title: 'Kasalar & Depolar',
            text: bot.tooltipHTML('Kasalar & Depolar', 'Kasalarınızın bakiye durumu ve depolarınızdaki ürün çeşitleri burada özetlenir.')
        }
    ];

    if (!isKisitli) {
        adimlar.push({
            id: 'menu-magazam-tab',
            attachTo: { element: '.bp-sb-tab[data-tab="magazam"]', on: 'right' },
            title: 'Mağazam Sekmesi',
            text: bot.tooltipHTML('Mağazam', 'Bu sekme kendi mağazanızın ERP işlemlerini içerir: satış, stok, müşteri yönetimi ve daha fazlası.'),
            beforeShowPromise: function () {
                return BayiEgitim.Engine.ensureSidebarOpen().then(function () {
                    var tab = document.querySelector('.bp-sb-tab[data-tab="magazam"]');
                    if (tab && !tab.classList.contains('is-active')) tab.click();
                    return new Promise(function (r) { setTimeout(r, 300); });
                });
            }
        });
        adimlar.push({
            id: 'menu-magazam-panel',
            attachTo: { element: '.bp-sb-panel[data-panel="magazam"] .bp-sb-menu', on: 'right' },
            title: 'Mağazam Menüsü',
            text: bot.tooltipHTML('Mağazam Menüsü', '<b>Yeni Satış</b> ile sipariş oluşturun, <b>Ürünler</b> ile stoğunuzu yönetin, <b>Müşteriler</b> ile cari takibinizi yapın, <b>Kasalar</b> ile finansınızı kontrol edin.')
        });
    }

    adimlar.push({
        id: 'menu-sunix-tab',
        attachTo: { element: '.bp-sb-tab[data-tab="sunix-merkez"]', on: 'right' },
        title: 'Sunix Merkez Sekmesi',
        text: bot.tooltipHTML('Sunix Merkez', 'Bu sekme Sunix merkezimiz ile olan ilişkilerinizi yönettiğiniz bölümdür: bakiye, tedarik, iade ve destek.'),
        beforeShowPromise: function () {
            return BayiEgitim.Engine.ensureSidebarOpen().then(function () {
                var tab = document.querySelector('.bp-sb-tab[data-tab="sunix-merkez"]');
                if (tab && !tab.classList.contains('is-active')) tab.click();
                return new Promise(function (r) { setTimeout(r, 300); });
            });
        }
    });
    adimlar.push({
        id: 'menu-sunix-panel',
        attachTo: { element: '.bp-sb-panel[data-panel="sunix-merkez"] .bp-sb-menu', on: 'right' },
        title: 'Sunix Merkez Menüsü',
        text: bot.tooltipHTML('Sunix Merkez Menüsü', '<b>Bakiyem</b> ile hesap durumunuzu görün, <b>Tedarik Pano</b> ile ürün siparişi verin, <b>İade Pano</b> ile iade başlatın, <b>Destek</b> ile bize ulaşın.')
    });

    adimlar.push({
        id: 'header-baslik',
        attachTo: { element: '.bp-ph-page-meta', on: 'bottom' },
        title: 'Sayfa Başlığı',
        text: bot.tooltipHTML('Sayfa Başlığı', 'Hangi sayfada olduğunuzu buradan görebilirsiniz. Her sayfanın başlığı ve simgesi burada görünür.')
    });
    adimlar.push({
        id: 'header-arama',
        attachTo: { element: '.bp-hw-search', on: 'bottom' },
        title: 'Hızlı Arama',
        text: bot.tooltipHTML('Hızlı Arama', 'Ürün veya sayfa aramak için bu kutuyu kullanabilirsiniz. Klavyeden "/" tuşuna basarak da hızlıca erişebilirsiniz.')
    });
    adimlar.push({
        id: 'header-doviz',
        attachTo: { element: '.bp-hw-fx', on: 'bottom-start' },
        title: 'Döviz Kuru',
        text: bot.tooltipHTML('Döviz Kuru', 'Anlık USD/TL kuru burada güncellenir. Değişim oranını da yanında görebilirsiniz.')
    });
    adimlar.push({
        id: 'header-kullanici',
        attachTo: { element: '.bp-hw-user', on: 'bottom-end' },
        title: 'Hesap Menüsü',
        text: bot.tooltipHTML('Hesap Menüsü', 'Hesap bilgilerinizi düzenleyebilir, personel yönetimi yapabilir ve güvenli çıkış yapabilirsiniz.')
    });

    return adimlar;
})();
